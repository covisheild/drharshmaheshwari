  "banned": [
    {
      "pattern": "(?<![\\u0900-\\u097F])दान",
      "why": "means donation (दान as a word; योगदान, निदान and प्रदान are fine); the site says support (सहयोग) and contribution (योगदान)"
    },
    {
      "pattern": "चंदा",
      "why": "donation"
    },
    {
      "pattern": "धर्मार्थ|परोपकार",
      "why": "charity"
    },
    {
      "pattern": "[०-९]",
      "why": "Devanagari digits: numbers stay 0-9"
    }
  ],
