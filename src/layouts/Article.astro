---
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
import { SITE } from '../consts';
import { SECTION, fmtDate, type ArticleCollection } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<ArticleCollection>; collection: ArticleCollection; }
const { entry, collection } = Astro.props;
const d = entry.data;
const sec = SECTION[collection];
const url = new URL(`${sec.base}${entry.id}/`, SITE.url).href;
const reviewed = d.reviewed ?? d.published;

const jsonld: Record<string, unknown>[] = [
  {
    '@type': collection === 'blog' ? 'BlogPosting' : 'MedicalWebPage',
    '@id': `${url}#page`,
    url,
    headline: d.title,
    name: d.title,
    description: d.description,
    inLanguage: 'en-IN',
    datePublished: d.published.toISOString(),
    dateModified: reviewed.toISOString(),
    ...(collection !== 'blog' && { lastReviewed: reviewed.toISOString().slice(0, 10), audience: { '@type': 'MedicalAudience', audienceType: sec.audience } }),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    about: d.topic.map((t) => ({ '@type': 'Thing', name: t })),
    ...(d.keyPoints.length && { abstract: d.keyPoints.join(' ') }),
    citation: d.references.map((r) => r.text),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: sec.label, item: new URL(sec.base, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  jsonld.push({
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} type="article" jsonld={jsonld} noindex={d.draft} progress>
  <article>
    <header class="article-head prose-wrap">
      {d.draft && <p class="draft-banner"><b>Draft under review.</b> Visible only on the preview site; not public yet.</p>}
      <a class="eyebrow" href={sec.base} style="text-decoration:none">{sec.label}{d.topic[0] && ` · ${d.topic[0]}`}</a>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      <div class="meta">
        <span>By <a href="/about/">{SITE.name}</a></span>
        <span>Published <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time></span>
        {d.reviewed && <span>Last reviewed <time datetime={d.reviewed.toISOString()}>{fmtDate(d.reviewed)}</time></span>}
      </div>
    </header>
    <div class="prose-wrap">
      {d.keyPoints.length > 0 && (
        <aside class="keypoints" aria-label="Key points">
          <h2>Key points</h2>
          <ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul>
        </aside>
      )}
      <div class="prose"><slot /></div>

      {d.faq.length > 0 && (
        <section class="faq" style="padding-block:1rem 0" aria-labelledby="faq-h">
          <h2 id="faq-h">Common questions</h2>
          {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>
      )}

      {d.references.length > 0 && (
        <section class="refs" style="padding-block:1.5rem 0" aria-labelledby="refs-h">
          <h2 id="refs-h">References</h2>
          <ol>{d.references.map((r) => <li>{r.url ? <a href={r.url} rel="noopener">{r.text}</a> : r.text}</li>)}</ol>
        </section>
      )}

      <div class="author-box">
        <Avatar size={52} />
        <div>
          <b><a href="/about/">{SITE.name}</a></b>
          <div class="muted small">MBBS (KGMU, Lucknow) · MD Community Medicine resident, AIIMS Raipur. Works on obesity prevention and evidence synthesis.</div>
        </div>
      </div>
      <p class="disclaimer">This article is for general education and does not replace advice from a doctor who knows your history. See the <a href="/disclaimer/">medical disclaimer</a>.</p>
    </div>
  </article>
</Base>
