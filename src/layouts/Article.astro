---
import Sources from '../components/Sources.astro';
import Base from './Base.astro';
import Avatar from '../components/Avatar.astro';
import { SITE } from '../consts';
import { SECTION, modeHome, type ArticleCollection } from '../lib/content';
import { MODES } from '../lib/modes';
import type { CollectionEntry } from 'astro:content';
import TranslationNote from '../components/site/TranslationNote.astro';
import { LANG, inLang, langOf } from '../i18n/languages';
import { localHref } from '../i18n/routes';
import { fmtDateIn, useT } from '../i18n/t';

// tr: on a translated page, the translation (its words replace the English ones; dates, references and draft stay the English
// file's). stale: there is a translation but the English changed since, so the English is shown with a note.
interface Props { entry: CollectionEntry<ArticleCollection>; collection: ArticleCollection; tr?: CollectionEntry<'translations'>; stale?: boolean }
const { entry, collection, tr, stale = false } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = useT(Astro.url.pathname);
const local = !!tr && !stale;
const d = local ? { ...entry.data, ...tr!.data } : entry.data;
const sec = SECTION[collection];
const englishUrl = new URL(`${sec.base}${entry.id}/`, SITE.url).href;
const url = new URL(inLang(lang, `${sec.base}${entry.id}/`), SITE.url).href;
const reviewed = d.reviewed ?? d.published;
const fmtDate = (x: Date) => fmtDateIn(lang, x);

const jsonld: Record<string, unknown>[] = [
  {
    '@type': collection === 'blog' ? 'BlogPosting' : 'MedicalWebPage',
    '@id': `${url}#page`,
    url,
    headline: d.title,
    name: d.title,
    description: d.description,
    inLanguage: local ? LANG[lang].html : 'en-IN',
    ...(local && { translationOfWork: { '@id': `${englishUrl}#page` } }),
    datePublished: d.published.toISOString(),
    dateModified: reviewed.toISOString(),
    ...(collection !== 'blog' && { lastReviewed: reviewed.toISOString().slice(0, 10), audience: { '@type': 'MedicalAudience', audienceType: sec.audience } }),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    about: d.topic.map((t) => ({ '@type': 'Thing', name: t })),
    ...(d.keyPoints.length && { abstract: d.keyPoints.join(' ') }),
    citation: d.references.map((r) => r.text),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(MODES[sec.mode].label), item: new URL(localHref(lang, modeHome(sec.mode)), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: t(sec.label), item: new URL(localHref(lang, sec.base), SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  jsonld.push({
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} type="article" jsonld={jsonld} noindex={d.draft} progress translationNote={false}>
  <article lang={lang !== 'en' && !local ? 'en' : undefined}>
    <header class="article-head prose-wrap">
      {lang !== 'en' && <div lang={LANG[lang].html}><TranslationNote checkedBy={tr?.data.checkedBy} stale={stale} top /></div>}
      {d.draft && <p class="draft-banner" lang={LANG[lang].html}><b>{t('Draft under review.')}</b> {t('Visible only on the preview site; not public yet.')}</p>}
      <a class="eyebrow" href={localHref(lang, sec.base)} style="text-decoration:none">{t(sec.label)}{d.topic[0] && ` · ${local ? d.topic[0] : t(d.topic[0])}`}</a>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      <div class="meta" lang={LANG[lang].html}>
        <span>{t('By')} <a href={localHref(lang, '/about/')}>{t(SITE.name)}</a></span>
        <span>{t('Published')} <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time></span>
        {d.reviewed && <span>{t('Last reviewed')} <time datetime={d.reviewed.toISOString()}>{fmtDate(d.reviewed)}</time></span>}
      </div>
    </header>
    <div class="prose-wrap">
      {d.keyPoints.length > 0 && (
        <aside class="keypoints" aria-label={t('Key points')}>
          <h2>{t('Key points')}</h2>
          <ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul>
        </aside>
      )}
      <div class="prose"><slot /></div>

      {d.faq.length > 0 && (
        <section class="faq" style="padding-block:1rem 0" aria-labelledby="faq-h">
          <h2 id="faq-h">{t('Common questions')}</h2>
          {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>
      )}

      {d.references.length > 0 && (
        <Sources label={t('References')} id="references">
          <ol lang="en">{d.references.map((r) => <li>{r.url ? <a href={r.url} rel="noopener">{r.text}</a> : r.text}</li>)}</ol>
        </Sources>
      )}

      <div class="author-box">
        <Avatar size={52} />
        <div>
          <b><a href={localHref(lang, '/about/')}>{t(SITE.name)}</a></b>
          <div class="muted small">{t('MBBS (KGMU, Lucknow) · MD Community Medicine resident, AIIMS Raipur. Works on obesity prevention and evidence synthesis.')}</div>
        </div>
      </div>
      <p class="disclaimer"><a href={localHref(lang, '/disclaimer/')}>{t('Disclaimer')}</a></p>
    </div>
  </article>
</Base>
