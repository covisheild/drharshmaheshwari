---
import '../styles/tokens.css';
import '../styles/global.css';
import { SITE, PERSON_JSONLD } from '../consts';
import { modeOf, type Mode } from '../lib/modes';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  progress?: boolean;
  /** Defaults to the mode implied by the URL; pages never need to set it. */
  mode?: Mode;
  /** 'site': header, navigation and footer. 'app': the page brings its own chrome (trainer apps). */
  chrome?: 'site' | 'app';
}
const { title, description = SITE.description, type = 'website', jsonld = [], noindex = false, progress = false, chrome = 'site' } = Astro.props;
const mode = Astro.props.mode ?? modeOf(Astro.url.pathname);
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name, description: SITE.description, inLanguage: 'en-IN', publisher: { '@id': `${SITE.url}/#person` } },
    PERSON_JSONLD,
    ...jsonld,
  ],
};
---
<!doctype html>
<html lang="en-IN" class="no-js" data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content={mode === 'doctors' ? '#0f2342' : '#0f6e64'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — new articles`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM-readable site guide" href="/llms.txt" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..700&family=Inter:wght@400..700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      // Runs before first paint: stored choice, else the system setting. Prevents a flash of the wrong theme.
      (function () {
        var r = document.documentElement, t = null;
        r.classList.replace('no-js', 'js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        r.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {progress && <div class="progress" aria-hidden="true"></div>}
    {chrome === 'site' && <SiteHeader mode={mode} path={path} />}

    <main id="main"><slot /></main>

    {chrome === 'site' && <SiteFooter mode={mode} />}

    <script>
      const header = document.querySelector('.site-header');
      const btn = document.querySelector('.menu-btn');
      btn?.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        btn!.setAttribute('aria-expanded', String(open));
      });
      const bar = document.querySelector<HTMLElement>('.progress');
      const onScroll = () => {
        header?.classList.toggle('scrolled', scrollY > 8);
        if (bar) {
          const h = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
