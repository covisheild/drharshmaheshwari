---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { articles } from '../../lib/content';
import CardList from '../../components/lists/CardList.astro';
import { TOOLS } from '../../data/tools';

// Link to a guide only once it is published (drafts are not built on production, so a link would 404).
const live = new Set((await articles('learn')).map((e) => e.id));

const more = TOOLS.filter((t) => t.mode === 'everyone' && t.href !== '/tools/bmi-calculator/');
const url = `${SITE.url}/tools/bmi-calculator/`;
const faq = [
  { q: 'What BMI is overweight for Indians?', a: 'For Indian adults, a BMI of 23 to 24.9 kg/m² is overweight and 25 or more is obesity, following the Asia-Pacific and Indian consensus cut-offs.' },
  { q: 'What waist size is too high for Indians?', a: 'Indian guidelines flag abdominal obesity at a waist of 90 cm or more in men and 80 cm or more in women.' },
  { q: 'What is a healthy waist-to-height ratio?', a: 'Below 0.5 — keep your waist to less than half your height. 0.5 to 0.59 means increased risk and 0.6 or more high risk.' },
  { q: 'What weight should I aim for?', a: 'For Indian adults this calculator suggests the weight at which BMI is 21 to 22, the middle of the healthy range (18.5 to 22.9), together with a waist below the Indian cut-off (90 cm men, 80 cm women) and below half your height.' },
  { q: 'How is BMI judged in children?', a: 'Children are still growing, so their BMI is compared with children of the same age and sex on the WHO growth charts (BMI-for-age). From 5 to 19 years, above +1 SD is overweight and above +2 SD obesity; under 5 years, above +2 SD is overweight and above +3 SD obesity.' },
];
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: 'BMI & waist calculator with Indian cut-offs',
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: 'Calculates BMI, a target weight range (BMI 21–22), the largest healthy waist, waist-to-height ratio and abdominal obesity using Asian/Indian cut-offs for adults, and WHO BMI-for-age for children aged 2 to 17. Nothing you type leaves your device.',
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="BMI & waist calculator (Indian cut-offs)" description="Free BMI, target weight, waist and waist-to-height ratio calculator using Indian cut-offs for adults and WHO charts for children. Runs in your browser; nothing is stored." jsonld={jsonld}>
  <header class="page-head wrap">
    <span class="eyebrow">Tools</span>
    <h1>BMI & waist calculator</h1>
    <p>Uses the cut-offs for <b>Indian adults</b>, not the global ones, and the <b>WHO growth charts</b> for children. Everything is calculated on your device; nothing you type is sent or stored.</p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="calc" novalidate>
      <fieldset>
        <legend>Who is this for?</legend>
        <div class="seg">
          <label><input type="radio" name="who" value="adult" checked /> <span>Adult (18+)</span></label>
          <label><input type="radio" name="who" value="child" /> <span>Child (2–17)</span></label>
        </div>
      </fieldset>

      <fieldset id="age-set" hidden>
        <legend>Age</legend>
        <div class="row">
          <label class="field"><input type="number" inputmode="numeric" id="ay" min="2" max="17" placeholder="8" /><span>years</span></label>
          <label class="field"><input type="number" inputmode="numeric" id="am" min="0" max="11" placeholder="0" /><span>months</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Sex</legend>
        <div class="seg">
          <label><input type="radio" name="sex" value="m" checked /> <span data-adult="Man" data-child="Boy">Man</span></label>
          <label><input type="radio" name="sex" value="f" /> <span data-adult="Woman" data-child="Girl">Woman</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Height</legend>
        <div class="seg small-seg">
          <label><input type="radio" name="hu" value="cm" checked /> <span>cm</span></label>
          <label><input type="radio" name="hu" value="ft" /> <span>ft + in</span></label>
        </div>
        <div class="row" id="h-cm"><label class="field"><input type="number" inputmode="decimal" id="hcm" min="70" max="230" placeholder="165" /><span>cm</span></label></div>
        <div class="row" id="h-ft" hidden>
          <label class="field"><input type="number" inputmode="numeric" id="hft" min="3" max="7" placeholder="5" /><span>ft</span></label>
          <label class="field"><input type="number" inputmode="decimal" id="hin" min="0" max="11.9" placeholder="5" /><span>in</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Weight</legend>
        <div class="row"><label class="field"><input type="number" inputmode="decimal" id="wkg" min="7" max="300" placeholder="66" /><span>kg</span></label></div>
      </fieldset>

      <fieldset>
        <legend>Waist <span class="muted small">(optional, but recommended)</span></legend>
        <div class="row"><label class="field"><input type="number" inputmode="decimal" id="waist" min="30" max="200" placeholder="85" /><span>cm</span></label></div>
        <p class="small muted" style="margin:.5rem 0 0">Midway between lowest rib and top of hip bone, after breathing out.{live.has('waist-to-height-ratio') && <> <a href="/learn/waist-to-height-ratio/">How to measure</a></>}</p>
      </fieldset>
      <p class="small muted" style="margin:0" id="calc-note">For adults 18 and over. Not valid in pregnancy.</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result" id="r-bmi">
        <span class="eyebrow">Body mass index</span>
        <div class="big"><b id="bmi-val">—</b><span>kg/m²</span></div>
        <div class="scale" aria-hidden="true">
          <div class="band u"></div><div class="band n"></div><div class="band o"></div><div class="band ob"></div>
          <div class="marker" id="bmi-marker"></div>
        </div>
        <div class="scale-labels" aria-hidden="true"><span id="sl1">18.5</span><span id="sl2">23</span><span id="sl3">25</span></div>
        <p class="verdict" id="bmi-verdict">Enter height and weight.</p>
        <p class="small muted" id="bmi-global"></p>
      </div>
      <div class="card result" id="r-target">
        <span class="eyebrow" id="target-eyebrow">Your targets</span>
        <dl class="targets">
          <div><dt id="tw-label">Target weight</dt><dd><b id="tw-val">—</b><span id="tw-unit"></span></dd><p class="small muted" id="tw-note">Enter height and weight.</p></div>
          <div><dt>Largest healthy waist</dt><dd><b id="mw-val">—</b><span id="mw-unit"></span></dd><p class="small muted" id="mw-note">Enter height.</p></div>
        </dl>
      </div>
      <div class="card result" id="r-waist">
        <span class="eyebrow">Waist</span>
        <div class="big"><b id="whtr-val">—</b><span>waist ÷ height</span></div>
        <p class="verdict" id="whtr-verdict">Add your waist to see abdominal fat risk.</p>
        <p class="small muted" id="waist-verdict"></p>
      </div>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>How to read your result</h2>
    <table>
      <thead><tr><th>Measure</th><th>Healthy</th><th>Increased risk</th><th>High risk</th></tr></thead>
      <tbody>
        <tr><td>BMI, Indian adults</td><td>18.5 – 22.9</td><td>23 – 24.9 (overweight)</td><td>25 or more (obesity)</td></tr>
        <tr><td>Waist-to-height ratio</td><td>below 0.5</td><td>0.5 – 0.59</td><td>0.6 or more</td></tr>
        <tr><td>Waist, men</td><td>below 90 cm</td><td colspan="2">90 cm or more</td></tr>
        <tr><td>Waist, women</td><td>below 80 cm</td><td colspan="2">80 cm or more</td></tr>
      </tbody>
    </table>
    <p><b>Target weight</b> for adults is the weight at which BMI would be 21 to 22, the middle of the healthy range for Indian adults. <b>Largest healthy waist</b> is the lower of the Indian waist cut-off and half your height.</p>
    <h3>Children (2 to 17 years): WHO BMI-for-age</h3>
    <p>A child's BMI changes with age, so it is compared with children of the same age and sex on the WHO charts and given as a z-score (SD) and percentile.</p>
    <table>
      <thead><tr><th>Age</th><th>Thinness</th><th>Healthy</th><th>Overweight</th><th>Obesity</th></tr></thead>
      <tbody>
        <tr><td>5 to 17 years</td><td>below −2 SD</td><td>−2 to +1 SD</td><td>above +1 SD</td><td>above +2 SD</td></tr>
        <tr><td>2 to 4 years</td><td>below −2 SD (wasted)</td><td>−2 to +1 SD</td><td>above +2 SD (+1 to +2: possible risk)</td><td>above +3 SD</td></tr>
      </tbody>
    </table>
    <p>Growing children usually do not need to lose weight: keeping weight steady while they grow taller brings BMI down. Talk to a paediatrician before changing a child's diet. The Indian Academy of Pediatrics (2015) charts for Indian children aged 5 to 18 use slightly lower cut-offs; this calculator follows WHO.</p>
    {live.has('bmi-cut-offs-for-indians') && <p>Why lower numbers for Indians? Read <a href="/learn/bmi-cut-offs-for-indians/">Is BMI accurate for Indians?</a></p>}
    <div class="faq">
      <h2>Common questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
    <div class="refs" style="margin-top:2rem">
      <h2>Sources</h2>
      <ol>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/14726171/">WHO Expert Consultation. Appropriate body-mass index for Asian populations. Lancet 2004;363:157-63.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/19582986/">Misra A, et al. Consensus statement for diagnosis of obesity, abdominal obesity and the metabolic syndrome for Asian Indians. J Assoc Physicians India 2009;57:163-70.</a></li>
        <li><a href="https://www.nice.org.uk/guidance/cg189">NICE CG189, waist-to-height ratio recommendations (2022 update).</a></li>
        <li><a href="https://www.who.int/tools/child-growth-standards">WHO Child Growth Standards (2006): BMI-for-age, birth to 5 years.</a></li>
        <li><a href="https://www.who.int/tools/growth-reference-data-for-5to19-years">WHO Growth Reference Data for 5–19 years (2007): BMI-for-age.</a> de Onis M, et al. Bull World Health Organ 2007;85:660-7.</li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/26519848/">Indian Academy of Pediatrics Growth Charts Committee. Revised IAP growth charts for height, weight and body mass index for 5- to 18-year-old Indian children. Indian Pediatr 2015;52:47-55.</a></li>
      </ol>
    </div>
    <p class="disclaimer"><a href="/disclaimer/">Disclaimer</a></p>
  </section>

  <section class="wrap more-tools">
    <h2>More calculators</h2>
    <CardList items={more} />
    <p class="muted" style="margin-top:1.5rem">All tools are listed on <a href="/tools/">Tools</a>. Clinical scores for health professionals are in <a href="/doctors/tools/">For Doctors · Tools</a>.</p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc { gap: 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .seg { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: .5rem 1.1rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .seg input:focus-visible + span { outline: 3px solid var(--accent); }
  .small-seg { margin-bottom: .6rem; } .small-seg span { padding: .3rem .8rem; font-size: .9rem; }
  .row { display: flex; gap: .6rem; }
  .row[hidden] { display: none; }
  .field { flex: 1; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding-right: .9rem; transition: border-color .2s; }
  .field:focus-within { border-color: var(--brand); }
  .field input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 600 1.25rem var(--font-body); padding: .75rem .9rem; outline: none; }
  .field span { color: var(--ink-3); }
  .results { display: grid; gap: 1.25rem; position: sticky; top: 84px; }
  @media (max-width: 820px) { .results { position: static; } }
  .big { display: flex; align-items: baseline; gap: .5rem; }
  .big b { font: 600 3.2rem/1 var(--font-display); color: var(--ink); transition: color .3s; }
  .big span { color: var(--ink-3); }
  .scale { position: relative; display: grid; height: 12px; border-radius: 999px; overflow: visible; margin-top: 1rem; }
  .band.u { background: #9ab7d3; border-radius: 999px 0 0 999px; } .band.n { background: var(--ok); } .band.o { background: var(--warn); } .band.ob { background: var(--risk); border-radius: 0 999px 999px 0; }
  .scale { grid-template-columns: var(--cols, 3.5fr 4.5fr 2fr 10fr); } /* adult: visible range 15–35; child: set by the script */
  .marker { position: absolute; top: -6px; width: 4px; height: 24px; background: var(--ink); border-radius: 2px; left: 0; opacity: 0; transition: left .6s cubic-bezier(.2,.8,.2,1), opacity .3s; }
  .scale-labels { position: relative; height: 1.2rem; font-size: .75rem; color: var(--ink-3); }
  .scale-labels span { position: absolute; transform: translateX(-50%); }
  .scale-labels span:nth-child(1) { left: var(--l1, 17.5%); } .scale-labels span:nth-child(2) { left: var(--l2, 40%); } .scale-labels span:nth-child(3) { left: var(--l3, 50%); }
  .targets { display: grid; gap: 1rem; margin: .75rem 0 0; }
  .targets dt { font-weight: 650; }
  .targets dd { margin: .2rem 0 0; display: flex; align-items: baseline; gap: .4rem; }
  .targets dd b { font: 600 2rem/1.1 var(--font-display); color: var(--ink); }
  .targets dd span { color: var(--ink-3); }
  .targets p { margin: .25rem 0 0; }
  .more-tools { padding-top: 2.5rem; padding-bottom: 4rem; }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); } .verdict.risk { background: var(--risk-soft); color: var(--risk); }
</style>

<script>
  import { adultCategory, bmiOf, childCategory, childHealthyBmi, CHILD_MONTHS, kgAt, maxWaist, percentile, targetWeight, TARGET_BMI, WAIST_CUT, zScore, type Sex } from '../../lib/bmi';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const num = (id: string) => { const v = parseFloat($<HTMLInputElement>(id).value); return Number.isFinite(v) ? v : NaN; };
  const form = $<HTMLFormElement>('calc');
  const picked = (name: string) => (form.querySelector(`input[name=${name}]:checked`) as HTMLInputElement).value;
  const setVerdict = (el: HTMLElement, text: string, cls = '') => { el.textContent = text; el.className = `verdict ${cls}`; };
  const kg = (v: number) => v.toFixed(0);
  const ordinal = (n: number) => { const r = Math.round(n), t = r % 100; return r + (t >= 11 && t <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][r % 10] ?? 'th'); };

  function heightCm(): number {
    if (picked('hu') === 'cm') return num('hcm');
    const ft = num('hft'), inch = num('hin');
    if (!Number.isFinite(ft)) return NaN;
    return (ft * 12 + (Number.isFinite(inch) ? inch : 0)) * 2.54;
  }

  /** Child's age in months, or NaN when outside 2 years 0 months to 17 years 11 months. */
  function ageMonths(): number {
    const y = num('ay'), m = Number.isFinite(num('am')) ? num('am') : 0;
    if (!Number.isFinite(y) || m < 0 || m >= 12) return NaN;
    const total = y * 12 + m;
    return total >= CHILD_MONTHS[0] && total <= CHILD_MONTHS[1] + 0.99 ? total : NaN;
  }

  // The bar under the BMI: adults on the BMI scale 15–35; children on the z-score scale −4 to +4 SD.
  const scale = $('r-bmi');
  function setScale(child: boolean, under5: boolean) {
    const s = scale.style;
    if (!child) { ['--cols', '--l1', '--l2', '--l3'].forEach((k) => s.removeProperty(k)); $('sl1').textContent = '18.5'; $('sl2').textContent = '23'; $('sl3').textContent = '25'; return; }
    const hi = under5 ? 3 : 2; // obesity line
    s.setProperty('--cols', `2fr 3fr ${hi - 1}fr ${4 - hi}fr`);
    s.setProperty('--l1', '25%'); s.setProperty('--l2', '62.5%'); s.setProperty('--l3', `${((hi + 4) / 8) * 100}%`);
    $('sl1').textContent = '−2 SD'; $('sl2').textContent = '+1 SD'; $('sl3').textContent = `+${hi} SD`;
  }

  function update() {
    const child = picked('who') === 'child';
    $('h-cm').hidden = picked('hu') !== 'cm';
    $('h-ft').hidden = picked('hu') === 'cm';
    $('age-set').hidden = !child;
    form.querySelectorAll<HTMLElement>('[data-adult]').forEach((el) => { el.textContent = (child ? el.dataset.child : el.dataset.adult) ?? ''; });
    $('calc-note').textContent = child
      ? 'For children aged 2 to 17 years, using the WHO growth charts. Measure height standing, without shoes.'
      : 'For adults 18 and over. Not valid in pregnancy.';

    const sex = picked('sex') as Sex;
    const h = heightCm(), w = num('wkg'), waist = num('waist'), months = child ? ageMonths() : NaN;
    const validH = h >= (child ? 70 : 100) && h <= 230, validW = w >= (child ? 7 : 25) && w <= 300;
    const under5 = child && months < 60;
    setScale(child, under5);

    const bmiEl = $('bmi-val'), marker = $('bmi-marker'), bv = $('bmi-verdict'), bg = $('bmi-global');
    const tw = $('tw-val'), twu = $('tw-unit'), twn = $('tw-note');
    $('target-eyebrow').textContent = child ? 'Healthy range' : 'Your targets';
    $('tw-label').textContent = child ? 'Healthy weight for this height now' : `Target weight (BMI ${TARGET_BMI[0]}–${TARGET_BMI[1]})`;
    const ready = validH && validW && (!child || Number.isFinite(months));

    if (ready) {
      const bmi = bmiOf(w, h);
      bmiEl.textContent = bmi.toFixed(1);
      if (!child) {
        const pos = Math.min(Math.max((bmi - 15) / 20, 0), 1) * 100;
        marker.style.left = `calc(${pos}% - 2px)`; marker.style.opacity = '1';
        const c = adultCategory(bmi); setVerdict(bv, c.label, c.tone);
        const global = bmi < 18.5 ? 'underweight' : bmi < 25 ? 'normal' : bmi < 30 ? 'overweight' : 'obesity';
        bg.textContent = `On the global WHO chart this would be "${global}". Healthy weight range for your height (Indian cut-offs): ${kg(kgAt(18.5, h))}–${kg(kgAt(22.9, h))} kg.`;
        const [lo, hi] = targetWeight(h);
        tw.textContent = `${kg(lo)}–${kg(hi)}`; twu.textContent = 'kg';
        const gap = w > hi ? `${(w - hi).toFixed(1)} kg above the top of this range` : w < lo ? `${(lo - w).toFixed(1)} kg below this range` : 'You are within this range';
        twn.textContent = `${gap}. BMI ${TARGET_BMI[0]}–${TARGET_BMI[1]} is the middle of the healthy range for Indian adults (18.5–22.9).` + (w > hi ? ' Losing even 5–10% of your weight brings real health gains.' : '');
      } else {
        const z = zScore(bmi, months, sex);
        const pos = Math.min(Math.max((z + 4) / 8, 0), 1) * 100;
        marker.style.left = `calc(${pos}% - 2px)`; marker.style.opacity = '1';
        const c = childCategory(z, months); setVerdict(bv, c.label, c.tone);
        const pct = percentile(z);
        const pctText = pct < 1 ? 'below the 1st' : pct > 99 ? 'above the 99th' : `the ${ordinal(pct)}`;
        bg.textContent = `BMI-for-age z-score ${z >= 0 ? '+' : '−'}${Math.abs(z).toFixed(2)} SD: ${pctText} percentile for ${sex === 'm' ? 'boys' : 'girls'} of this age (WHO ${under5 ? 'Child Growth Standards' : 'Growth Reference 5–19 years'}).`;
        const [blo, bhi] = childHealthyBmi(months, sex);
        tw.textContent = `${kg(kgAt(blo, h))}–${kg(kgAt(bhi, h))}`; twu.textContent = 'kg';
        twn.textContent = `Healthy BMI at this age: ${blo.toFixed(1)}–${bhi.toFixed(1)} (−2 to +1 SD). Children usually should not diet to lose weight: holding weight steady while they grow taller brings BMI down. Ask a paediatrician.`;
      }
    } else {
      bmiEl.textContent = '—'; marker.style.opacity = '0';
      setVerdict(bv, child && validH && validW ? 'Enter an age from 2 to 17 years.' : child ? 'Enter age, height and weight.' : 'Enter height and weight.');
      bg.textContent = ''; tw.textContent = '—'; twu.textContent = ''; twn.textContent = child ? 'Enter age, height and weight.' : 'Enter height and weight.';
    }

    // Largest healthy waist: adults, the lower of the Indian cut-off and half the height; children from 5 years, half the height.
    const mw = $('mw-val'), mwu = $('mw-unit'), mwn = $('mw-note');
    if (validH && child && !(months >= 60)) {
      mw.textContent = '—'; mwu.textContent = ''; mwn.textContent = Number.isFinite(months) ? 'Waist is not used to judge children under 5.' : 'Enter age and height.';
    } else if (validH) {
      const m = child ? { cm: h / 2, by: 'half height' as const } : maxWaist(h, sex);
      const v = Math.round(m.cm * 10) / 10;
      mw.textContent = `under ${Number.isInteger(v) ? v : v.toFixed(1)}`; mwu.textContent = 'cm';
      mwn.textContent = child
        ? 'Half the height (waist-to-height ratio below 0.5), the usual sign of healthy waist size in children from 5 years.'
        : m.by === 'half height'
          ? `Half your height, which for you is lower than the Indian cut-off for ${sex === 'm' ? 'men' : 'women'} (${WAIST_CUT[sex]} cm).`
          : `The Indian cut-off for ${sex === 'm' ? 'men' : 'women'} (${WAIST_CUT[sex]} cm), which for you is lower than half your height (${(h / 2).toFixed(0)} cm).`;
    } else {
      mw.textContent = '—'; mwu.textContent = ''; mwn.textContent = 'Enter height.';
    }

    const wv = $('whtr-val'), whv = $('whtr-verdict'), wav = $('waist-verdict');
    if (child && !(months >= 60)) {
      wv.textContent = '—'; setVerdict(whv, Number.isFinite(months) ? 'Waist is not used to judge children under 5.' : 'Add age and waist to see abdominal fat.'); wav.textContent = '';
    } else if (validH && waist >= (child ? 30 : 40) && waist <= 200) {
      const r = waist / h;
      wv.textContent = r.toFixed(2);
      if (r < 0.5) setVerdict(whv, 'Below 0.5: no increased risk', 'ok');
      else if (r < 0.6) setVerdict(whv, '0.5–0.59: increased risk', 'warn');
      else setVerdict(whv, '0.6 or more: high risk', 'risk');
      const cut = WAIST_CUT[sex];
      wav.textContent = child
        ? `Keep the waist under ${(h / 2).toFixed(0)} cm (half the height).`
        : `Keep your waist under ${(h / 2).toFixed(0)} cm (half your height). Indian waist cut-off for ${sex === 'm' ? 'men' : 'women'}: ${cut} cm — yours is ${waist >= cut ? 'at or above' : 'below'} it.`;
    } else {
      wv.textContent = '—'; setVerdict(whv, 'Add your waist to see abdominal fat risk.'); wav.textContent = '';
    }
  }
  form.addEventListener('input', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();

  // A link such as /tools/bmi-calculator/#weight opens the calculator with that box selected and ready to type in
  // (the home page's calculator picture links its Height, Weight, Waist and Sex fields this way).
  const READY: Record<string, string> = { height: 'hcm', weight: 'wkg', waist: 'waist' };
  function readyFromHash() {
    const key = location.hash.slice(1);
    const box = key === 'sex' ? form.querySelector<HTMLInputElement>('input[name=sex]:checked') : READY[key] ? $<HTMLInputElement>(READY[key]) : null;
    if (!box) return;
    box.scrollIntoView({ block: 'center' });
    box.focus({ preventScroll: true });
    if (box.type === 'number') box.select();
  }
  readyFromHash();
  addEventListener('hashchange', readyFromHash);
</script>
