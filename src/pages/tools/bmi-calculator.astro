---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { articles } from '../../lib/content';
import CardList from '../../components/lists/CardList.astro';
import UnitField from '../../components/UnitField.astro';
import { TOOLS } from '../../data/tools';
import T from '../../components/T.astro';
import ClientWords from '../../components/ClientWords.astro';
import { inLang, langOf } from '../../i18n/languages';
import { localHref } from '../../i18n/routes';
import { useT } from '../../i18n/t';

// Also /<lang>/tools/bmi-calculator/: the page through the dictionary (t, <T>), the results through w() (src/i18n/client.ts).
const lang = langOf(Astro.url.pathname);
const t = useT(Astro.url.pathname);
const L = (href: string) => localHref(lang, href);

// Link to a guide only once it is published (drafts are not built on production, so a link would 404).
const live = new Set((await articles('learn')).map((e) => e.id));

const more = TOOLS.filter((t) => t.mode === 'everyone' && t.href !== '/tools/bmi-calculator/');
const url = `${SITE.url}${inLang(lang, '/tools/bmi-calculator/')}`;
const faq = [
  { q: 'What BMI is overweight for Indians?', a: 'For Indian adults, a BMI of 23 to 24.9 kg/m² is overweight and 25 or more is obesity, following the Asia-Pacific and Indian consensus cut-offs.' },
  { q: 'What waist size is too high for Indians?', a: 'Indian guidelines flag abdominal obesity at a waist of 90 cm or more in men and 80 cm or more in women.' },
  { q: 'What is a healthy waist-to-height ratio?', a: 'Below 0.5 — keep your waist to less than half your height. 0.5 to 0.59 means increased risk and 0.6 or more high risk.' },
  { q: 'What weight should I aim for?', a: 'For Indian adults this calculator suggests the weight at which BMI is 21 to 22, the middle of the healthy range (18.5 to 22.9), together with a waist below the Indian cut-off (90 cm men, 80 cm women) and below half your height.' },
  { q: 'How is BMI judged in Indian children?', a: 'Children are still growing, so their BMI is compared with children of the same age and sex. From 5 to 18 years the Indian Academy of Pediatrics (IAP 2015) charts are used: overweight from the line that corresponds to an adult BMI of 23, obesity from the line for 27, and thinness below the 3rd percentile. Under 5 years, IAP recommends the WHO standards: above +2 SD is overweight and above +3 SD obesity.' },
].map((f) => ({ q: t(f.q), a: t(f.a) }));
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: t('BMI & waist calculator with Indian cut-offs'),
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: t('Calculates BMI, a target weight range (BMI 21–22), the largest healthy waist, waist-to-height ratio and abdominal obesity using Asian/Indian cut-offs for adults, and the IAP 2015 charts for Indian children (WHO standards under 5). Nothing you type leaves your device.'),
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={t('BMI & waist calculator (Indian cut-offs)')} description={t('Free BMI, target weight, waist and waist-to-height ratio calculator using Indian cut-offs for adults and IAP charts for children. Runs in your browser; nothing is stored.')} jsonld={jsonld}>
  <ClientWords sources={['/src/pages/tools/bmi-calculator.astro', '/src/lib/bmi.ts']} />
  <header class="page-head wrap">
    <span class="eyebrow">{t('Tools')}</span>
    <h1>{t('BMI & waist calculator')}</h1>
    <p><T>Uses the cut-offs for <b>Indian adults</b>, not the global ones, and the <b>IAP 2015 charts for Indian children</b> (WHO under 5). Everything is calculated on your device; nothing you type is sent or stored.</T></p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="calc" novalidate>
      <fieldset>
        <legend>{t('Who is this for?')}</legend>
        <div class="seg">
          <label><input type="radio" name="who" value="adult" checked /> <span>{t('Adult (18+)')}</span></label>
          <label><input type="radio" name="who" value="child" /> <span>{t('Child (2–17)')}</span></label>
        </div>
      </fieldset>

      <fieldset id="age-set" hidden>
        <legend>{t('Age')}</legend>
        <div class="row">
          <label class="field"><input type="number" data-unitless inputmode="numeric" id="ay" min="2" max="17" placeholder="8" /><span>{t('years')}</span></label>
          <label class="field"><input type="number" data-unitless inputmode="numeric" id="am" min="0" max="11" placeholder="0" /><span>{t('months')}</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t('Sex')}</legend>
        <div class="seg">
          <label><input type="radio" name="sex" value="m" checked /> <span data-adult={t('Man')} data-child={t('Boy')}>{t('Man')}</span></label>
          <label><input type="radio" name="sex" value="f" /> <span data-adult={t('Woman')} data-child={t('Girl')}>{t('Woman')}</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t('Height')}</legend>
        <div class="row"><UnitField id="hcm" kind="height" label={t('Height')} placeholder={165} /></div>
      </fieldset>

      <fieldset>
        <legend>{t('Weight')}</legend>
        <div class="row"><UnitField id="wkg" kind="weight" label={t('Weight')} placeholder={66} /></div>
      </fieldset>

      <fieldset>
        <legend>{t('Waist')} <span class="muted small">{t('(optional, but recommended)')}</span></legend>
        <div class="row"><UnitField id="waist" kind="length" label={t('Waist')} placeholder={85} /></div>
        <p class="small muted" style="margin:.5rem 0 0">{t('Midway between lowest rib and top of hip bone, after breathing out.')}{live.has('waist-to-height-ratio') && <> <a href={L('/learn/waist-to-height-ratio/')}>{t('How to measure')}</a></>}</p>
      </fieldset>
      <p class="small muted" style="margin:0" id="calc-note">{t('For adults 18 and over. Not valid in pregnancy.')}</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result" id="r-bmi">
        <span class="eyebrow">{t('Body mass index')}</span>
        <div class="big"><b id="bmi-val">—</b><span>kg/m²</span></div>
        <div class="scale" aria-hidden="true">
          <div class="band u"></div><div class="band n"></div><div class="band o"></div><div class="band ob"></div>
          <div class="marker" id="bmi-marker"></div>
        </div>
        <div class="scale-labels" aria-hidden="true"><span id="sl1">18.5</span><span id="sl2">23</span><span id="sl3">25</span></div>
        <p class="verdict" id="bmi-verdict">{t('Enter height and weight.')}</p>
        <p class="small muted" id="bmi-global"></p>
      </div>
      <div class="card result" id="r-target">
        <span class="eyebrow" id="target-eyebrow">{t('Your targets')}</span>
        <dl class="targets">
          <div><dt id="tw-label">{t('Target weight')}</dt><dd><b id="tw-val">—</b><span id="tw-unit"></span></dd><p class="small muted" id="tw-note">{t('Enter height and weight.')}</p></div>
          <div><dt>{t('Largest healthy waist')}</dt><dd><b id="mw-val">—</b><span id="mw-unit"></span></dd><p class="small muted" id="mw-note">{t('Enter height.')}</p></div>
        </dl>
      </div>
      <div class="card result" id="r-waist">
        <span class="eyebrow">{t('Waist')}</span>
        <div class="big"><b id="whtr-val">—</b><span id="whtr-unit">{t('waist ÷ height')}</span></div>
        <p class="verdict" id="whtr-verdict">{t('Add your waist to see abdominal fat risk.')}</p>
        <p class="small muted" id="waist-verdict"></p>
      </div>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>{t('How to read your result')}</h2>
    <table>
      <thead><tr><th>{t('Measure')}</th><th>{t('Healthy')}</th><th>{t('Increased risk')}</th><th>{t('High risk')}</th></tr></thead>
      <tbody>
        <tr><td>{t('BMI, Indian adults')}</td><td>18.5 – 22.9</td><td>{t('23 – 24.9 (overweight)')}</td><td>{t('25 or more (obesity)')}</td></tr>
        <tr><td>{t('Waist-to-height ratio')}</td><td>{t('below 0.5')}</td><td>0.5 – 0.59</td><td>{t('0.6 or more')}</td></tr>
        <tr><td>{t('Waist, men')}</td><td>{t('below 90 cm')}</td><td colspan="2">{t('90 cm or more')}</td></tr>
        <tr><td>{t('Waist, women')}</td><td>{t('below 80 cm')}</td><td colspan="2">{t('80 cm or more')}</td></tr>
      </tbody>
    </table>
    <p><T><b>Target weight</b> for adults is the weight at which BMI would be 21 to 22, the middle of the healthy range for Indian adults. <b>Largest healthy waist</b> is the lower of the Indian waist cut-off and half your height.</T></p>
    <h3>{t('Children (2 to 17 years)')}</h3>
    <p><T>A child's BMI changes with age, so it is compared with children of the same age and sex. From 5 years the calculator uses the <b>IAP 2015 charts for Indian children</b>; under 5, IAP recommends the WHO standards.</T></p>
    <table>
      <thead><tr><th>{t('Age')}</th><th>{t('Thinness')}</th><th>{t('Healthy')}</th><th>{t('Overweight')}</th><th>{t('Obesity')}</th></tr></thead>
      <tbody>
        <tr><td>{t('5 to 17 years (IAP 2015)')}</td><td>{t('below the 3rd percentile')}</td><td>{t('3rd percentile to the 23 line')}</td><td>{t('adult-equivalent 23 line or above')}</td><td>{t('adult-equivalent 27 line or above')}</td></tr>
        <tr><td>{t('2 to 4 years (WHO 2006)')}</td><td>{t('below −2 SD (wasted)')}</td><td>{t('−2 to +1 SD')}</td><td>{t('above +2 SD (+1 to +2: possible risk)')}</td><td>{t('above +3 SD')}</td></tr>
      </tbody>
    </table>
    <p><T><b>Waist in children</b> (2 to 17 years) is compared with Indian children of the same age and sex (Khadilkar 2014). At or above the <b>70th percentile</b>, risk factors for metabolic syndrome become common; that is the "largest healthy waist" shown.</T></p>
    <p><T>The adult-equivalent lines are the BMI at each age that tracks to a BMI of 23 or 27 at 18 years, the Indian adult cut-offs for overweight and obesity. Growing children usually do not need to lose weight: keeping weight steady while they grow taller brings BMI down. Talk to a paediatrician before changing a child's diet.</T></p>
    {live.has('bmi-cut-offs-for-indians') && <p>{t('Why lower numbers for Indians? Read')} <a href={L('/learn/bmi-cut-offs-for-indians/')}>{t('Is BMI accurate for Indians?')}</a></p>}
    <div class="faq">
      <h2>{t('Common questions')}</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
    <div class="refs" style="margin-top:2rem">
      <h2>{t('Sources')}</h2>
      <ol lang="en">
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/14726171/">WHO Expert Consultation. Appropriate body-mass index for Asian populations. Lancet 2004;363:157-63.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/19582986/">Misra A, et al. Consensus statement for diagnosis of obesity, abdominal obesity and the metabolic syndrome for Asian Indians. J Assoc Physicians India 2009;57:163-70.</a></li>
        <li><a href="https://www.nice.org.uk/guidance/cg189">NICE CG189, waist-to-height ratio recommendations (2022 update).</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/25638185/">Indian Academy of Pediatrics Growth Charts Committee. Revised IAP growth charts for height, weight and body mass index for 5- to 18-year-old Indian children. Indian Pediatr 2015;52:47-55.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/24655536/">Khadilkar A, et al. Waist circumference percentiles in 2-18 year old Indian children. J Pediatr 2014;164:1358-62.</a></li>
        <li><a href="https://www.who.int/tools/child-growth-standards">WHO Child Growth Standards (2006): BMI-for-age, birth to 5 years.</a></li>
      </ol>
    </div>
    <p class="disclaimer"><a href={L('/disclaimer/')}>{t('Disclaimer')}</a></p>
  </section>

  <section class="wrap more-tools">
    <h2>{t('More calculators')}</h2>
    <CardList items={more} />
    <p class="muted" style="margin-top:1.5rem"><T>All tools are listed on <a href="/tools/">Tools</a>. Clinical scores for health professionals are in <a href="/doctors/tools/">For Doctors · Tools</a>.</T></p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc { gap: 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .seg { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: .5rem 1.1rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .seg input:focus-visible + span { outline: 3px solid var(--accent); }
  .small-seg { margin-bottom: .6rem; } .small-seg span { padding: .3rem .8rem; font-size: .9rem; }
  .row { display: flex; gap: .6rem; }
  .row[hidden] { display: none; }
  .field { flex: 1; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding-right: .9rem; transition: border-color .2s; }
  .field:focus-within { border-color: var(--brand); }
  .field input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 600 1.25rem var(--font-body); padding: .75rem .9rem; outline: none; }
  .field span { color: var(--ink-3); }
  .results { display: grid; gap: 1.25rem; position: sticky; top: 84px; }
  @media (max-width: 820px) { .results { position: static; } }
  .big { display: flex; align-items: baseline; gap: .5rem; }
  .big b { font: 600 3.2rem/1 var(--font-display); color: var(--ink); transition: color .3s; }
  .big span { color: var(--ink-3); }
  .scale { position: relative; display: grid; height: 12px; border-radius: 999px; overflow: visible; margin-top: 1rem; }
  .band.u { background: #9ab7d3; border-radius: 999px 0 0 999px; } .band.n { background: var(--ok); } .band.o { background: var(--warn); } .band.ob { background: var(--risk); border-radius: 0 999px 999px 0; }
  .scale { grid-template-columns: var(--cols, 3.5fr 4.5fr 2fr 10fr); } /* adult: visible range 15–35; child: set by the script */
  .marker { position: absolute; top: -6px; width: 4px; height: 24px; background: var(--ink); border-radius: 2px; left: 0; opacity: 0; transition: left .6s cubic-bezier(.2,.8,.2,1), opacity .3s; }
  .scale-labels { position: relative; height: 1.2rem; font-size: .75rem; color: var(--ink-3); }
  .scale-labels span { position: absolute; transform: translateX(-50%); }
  .scale-labels span:nth-child(1) { left: var(--l1, 17.5%); } .scale-labels span:nth-child(2) { left: var(--l2, 40%); } .scale-labels span:nth-child(3) { left: var(--l3, 50%); }
  .targets { display: grid; gap: 1rem; margin: .75rem 0 0; }
  .targets dt { font-weight: 650; }
  .targets dd { margin: .2rem 0 0; display: flex; align-items: baseline; gap: .4rem; }
  .targets dd b { font: 600 2rem/1.1 var(--font-display); color: var(--ink); }
  .targets dd span { color: var(--ink-3); }
  .targets p { margin: .25rem 0 0; }
  .more-tools { padding-top: 2.5rem; padding-bottom: 4rem; }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); } .verdict.risk { background: var(--risk-soft); color: var(--risk); }
</style>

<script>
  import { unitValue } from '../../scripts/unit-fields';
  import { w } from '../../i18n/client';
  import { adultCategory, bmiOf, childHealthyBmi, childWaistCategory, childWaistLines, CHILD_MONTHS, IAP_FROM, iapBand, iapCategory, iapLines, kgAt, maxWaist, percentile, targetWeight, TARGET_BMI, WAIST_CUT, whoUnder5Category, zScore, type Sex } from '../../lib/bmi';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const num = (id: string) => { const v = parseFloat($<HTMLInputElement>(id).value); return Number.isFinite(v) ? v : NaN; };
  const form = $<HTMLFormElement>('calc');
  const picked = (name: string) => (form.querySelector(`input[name=${name}]:checked`) as HTMLInputElement).value;
  // Verdict labels come English from src/lib/bmi.ts; w() translates them (ClientWords sends every `label: '...'` there).
  const setVerdict = (el: HTMLElement, text: string, cls = '') => { el.textContent = w(text); el.className = `verdict ${cls}`; };
  const kg = (v: number) => v.toFixed(0);
  const suffix = (r: number) => { const t = r % 100; return t >= 11 && t <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][r % 10] ?? 'th'; };
  // "3rd", "71st": w('{n}st') w('{n}nd') w('{n}rd') w('{n}th')
  const ordinal = (n: number | string) => { const r = Math.round(Number(n)); return w(`{n}${suffix(r)}`, { n: r }); };
  // src/lib/bmi.ts iapBand() describes where a BMI sits among the IAP lines in English; this says the same in the page's language.
  const lineText = (s: string) => {
    let m = s.match(/^(\d+)(?:st|nd|rd|th) percentile$/);
    if (m) return w('the {ordinal} percentile', { ordinal: ordinal(m[1]) });
    m = s.match(/^(overweight|obesity) line \(about the (\d+)(?:st|nd|rd|th) percentile\)$/);
    if (m) return m[1] === 'overweight' ? w('the overweight line (about the {ordinal} percentile)', { ordinal: ordinal(m[2]) }) : w('the obesity line (about the {ordinal} percentile)', { ordinal: ordinal(m[2]) });
    return s;
  };
  const iapBandText = (s: string) => {
    if (s === 'below the 3rd percentile') return w('below the 3rd percentile');
    let m = s.match(/^at or above the (.+)$/);
    if (m) return w('at or above {line}', { line: lineText(m[1]) });
    m = s.match(/^between the (.+) and the (.+)$/);
    if (m) return w('between {a} and {b}', { a: lineText(m[1]), b: lineText(m[2]) });
    return s;
  };


  /** Child's age in months, or NaN when outside 2 years 0 months to 17 years 11 months. */
  function ageMonths(): number {
    const y = num('ay'), m = Number.isFinite(num('am')) ? num('am') : 0;
    if (!Number.isFinite(y) || m < 0 || m >= 12) return NaN;
    const total = y * 12 + m;
    return total >= CHILD_MONTHS[0] && total <= CHILD_MONTHS[1] + 0.99 ? total : NaN;
  }

  // The bar under the BMI: four bands (thin, healthy, overweight, obesity) between lo and hi, split at a, b and c.
  // Adults: BMI 15–35 split at 18.5/23/25. Children 5–17: BMI around the IAP lines. Children 2–4: WHO z-score −4 to +4.
  const scale = $('r-bmi');
  function drawScale([lo, a, b, c, hi]: number[], labels: string[], value: number) {
    const span = hi - lo, s = scale.style, pct = (v: number) => `${((v - lo) / span) * 100}%`;
    s.setProperty('--cols', `${a - lo}fr ${b - a}fr ${c - b}fr ${hi - c}fr`);
    s.setProperty('--l1', pct(a)); s.setProperty('--l2', pct(b)); s.setProperty('--l3', pct(c));
    ['sl1', 'sl2', 'sl3'].forEach((id, i) => { $(id).textContent = labels[i]; });
    const marker = $('bmi-marker');
    if (Number.isFinite(value)) { marker.style.left = `calc(${Math.min(Math.max((value - lo) / span, 0), 1) * 100}% - 2px)`; marker.style.opacity = '1'; }
    else marker.style.opacity = '0';
  }
  function scaleFor(months: number, sex: Sex): [number[], string[]] {
    if (!Number.isFinite(months)) return [[15, 18.5, 23, 25, 35], ['18.5', '23', '25']];
    if (months < IAP_FROM) return [[-4, -2, 1, 3, 4], ['−2 SD', '+1 SD', '+3 SD']];
    const l = iapLines(months, sex);
    return [[l.p3 - 3, l.p3, l.ow, l.ob, l.ob + 7], [w('3rd'), w('23 AE'), w('27 AE')]];
  }

  function update() {
    const child = picked('who') === 'child';
    $('age-set').hidden = !child;
    form.querySelectorAll<HTMLElement>('[data-adult]').forEach((el) => { el.textContent = (child ? el.dataset.child : el.dataset.adult) ?? ''; });
    $('calc-note').textContent = child
      ? w('For children aged 2 to 17 years: IAP 2015 charts for Indian children from 5 years, WHO standards under 5. Measure height standing, without shoes.')
      : w('For adults 18 and over. Not valid in pregnancy.');

    const sex = picked('sex') as Sex;
    const h = unitValue('hcm'), wt = unitValue('wkg'), waist = unitValue('waist'), months = child ? ageMonths() : NaN;
    const validH = h >= (child ? 70 : 100) && h <= 230, validW = wt >= (child ? 7 : 25) && wt <= 300;
    const under5 = child && months < IAP_FROM;
    const [pts, labels] = scaleFor(months, sex); // adult scale when months is NaN

    const bmiEl = $('bmi-val'), bv = $('bmi-verdict'), bg = $('bmi-global');
    const tw = $('tw-val'), twu = $('tw-unit'), twn = $('tw-note');
    $('target-eyebrow').textContent = child ? w('Healthy range') : w('Your targets');
    $('tw-label').textContent = child ? w('Healthy weight for this height now') : w('Target weight (BMI {lo}–{hi})', { lo: TARGET_BMI[0], hi: TARGET_BMI[1] });
    const ready = validH && validW && (!child || Number.isFinite(months));

    if (ready) {
      const bmi = bmiOf(wt, h);
      bmiEl.textContent = bmi.toFixed(1);
      if (!child) {
        drawScale(pts, labels, bmi);
        const c = adultCategory(bmi); setVerdict(bv, c.label, c.tone);
        const global = bmi < 18.5 ? w('underweight') : bmi < 25 ? w('normal') : bmi < 30 ? w('overweight') : w('obesity');
        bg.textContent = w('On the global WHO chart this would be "{global}". Healthy weight range for your height (Indian cut-offs): {lo}–{hi} kg.', { global, lo: kg(kgAt(18.5, h)), hi: kg(kgAt(22.9, h)) });
        const [lo, hi] = targetWeight(h);
        tw.textContent = `${kg(lo)}–${kg(hi)}`; twu.textContent = 'kg';
        const gap = wt > hi ? w('{kg} kg above the top of this range', { kg: (wt - hi).toFixed(1) }) : wt < lo ? w('{kg} kg below this range', { kg: (lo - wt).toFixed(1) }) : w('You are within this range');
        twn.textContent = w('{gap}. BMI {lo}–{hi} is the middle of the healthy range for Indian adults (18.5–22.9).', { gap, lo: TARGET_BMI[0], hi: TARGET_BMI[1] }) + (wt > hi ? ' ' + w('Losing even 5–10% of your weight brings real health gains.') : '');
      } else {
        const kids = sex === 'm' ? w('boys') : w('girls');
        if (!under5) {
          const l = iapLines(months, sex);
          drawScale(pts, labels, bmi);
          const c = iapCategory(bmi, l); setVerdict(bv, c.label, c.tone);
          bg.textContent = w('On the IAP 2015 chart for Indian {kids}, this BMI is {band}. At this age: thinness below {p3}, overweight from {ow}, obesity from {ob}.', { kids, band: iapBandText(iapBand(bmi, l, sex)), p3: l.p3.toFixed(1), ow: l.ow.toFixed(1), ob: l.ob.toFixed(1) });
        } else {
          const z = zScore(bmi, months, sex);
          drawScale(pts, labels, z);
          const c = whoUnder5Category(z); setVerdict(bv, c.label, c.tone);
          const pct = percentile(z);
          const pctText = pct < 1 ? w('below the 1st percentile') : pct > 99 ? w('above the 99th percentile') : w('the {ordinal} percentile', { ordinal: ordinal(pct) });
          bg.textContent = w('BMI-for-age z-score {z} SD: {pct} for {kids} of this age (WHO Child Growth Standards, which IAP recommends under 5).', { z: `${z >= 0 ? '+' : '−'}${Math.abs(z).toFixed(2)}`, pct: pctText, kids });
        }
        const [blo, bhi] = childHealthyBmi(months, sex);
        tw.textContent = `${kg(kgAt(blo, h))}–${kg(kgAt(bhi, h))}`; twu.textContent = 'kg';
        twn.textContent = w('Healthy BMI at this age: {lo} to under {hi} ({basis}). Children usually should not diet to lose weight: holding weight steady while they grow taller brings BMI down. Ask a paediatrician.', { lo: blo.toFixed(1), hi: bhi.toFixed(1), basis: under5 ? w('WHO −2 to +1 SD') : w('IAP 3rd percentile to the adult-equivalent 23 line') });
      }
    } else {
      bmiEl.textContent = '—';
      drawScale(pts, labels, NaN);
      setVerdict(bv, child && validH && validW ? w('Enter an age from 2 to 17 years.') : child ? w('Enter age, height and weight.') : w('Enter height and weight.'));
      bg.textContent = ''; tw.textContent = '—'; twu.textContent = ''; twn.textContent = child ? w('Enter age, height and weight.') : w('Enter height and weight.');
    }

    // Largest healthy waist: adults, the lower of the Indian cut-off and half the height; children, the Indian 70th percentile for age.
    const mw = $('mw-val'), mwu = $('mw-unit'), mwn = $('mw-note');
    const kidsWord = sex === 'm' ? w('boys') : w('girls');
    if (child && Number.isFinite(months)) {
      const l = childWaistLines(months, sex);
      mw.textContent = w('under {cm}', { cm: l.p70.toFixed(1) }); mwu.textContent = 'cm';
      mwn.textContent = w('The 70th percentile of waist for Indian {kids} aged {age}, the cut-off above which risk factors for metabolic syndrome become common.', { kids: kidsWord, age: Math.floor(months / 12) });
    } else if (child) {
      mw.textContent = '—'; mwu.textContent = ''; mwn.textContent = w('Enter age.');
    } else if (validH) {
      const m = maxWaist(h, sex);
      const v = Math.round(m.cm * 10) / 10;
      mw.textContent = w('under {cm}', { cm: Number.isInteger(v) ? v : v.toFixed(1) }); mwu.textContent = 'cm';
      const people = sex === 'm' ? w('men') : w('women');
      mwn.textContent = m.by === 'half height'
        ? w('Half your height, which for you is lower than the Indian cut-off for {people} ({cut} cm).', { people, cut: WAIST_CUT[sex] })
        : w('The Indian cut-off for {people} ({cut} cm), which for you is lower than half your height ({half} cm).', { people, cut: WAIST_CUT[sex], half: (h / 2).toFixed(0) });
    } else {
      mw.textContent = '—'; mwu.textContent = ''; mwn.textContent = w('Enter height.');
    }

    // Waist card: adults, waist-to-height ratio and the Indian cut-off; children, the waist against Indian percentiles for age.
    const wv = $('whtr-val'), whv = $('whtr-verdict'), wav = $('waist-verdict');
    $('whtr-unit').textContent = child ? 'cm' : w('waist ÷ height');
    if (child) {
      if (Number.isFinite(months) && waist >= 30 && waist <= 200) {
        const l = childWaistLines(months, sex), c = childWaistCategory(waist, months, sex);
        wv.textContent = waist.toFixed(0); setVerdict(whv, c.label, c.tone);
        wav.textContent = w('For Indian {kids} aged {age}: 50th percentile {p50} cm, 70th {p70} cm (cut-off), 90th {p90} cm.', { kids: kidsWord, age: Math.floor(months / 12), p50: l.p50.toFixed(1), p70: l.p70.toFixed(1), p90: l.p90.toFixed(1) });
      } else {
        wv.textContent = '—'; setVerdict(whv, Number.isFinite(months) ? w('Add the waist to see abdominal fat risk.') : w('Add age and waist to see abdominal fat risk.')); wav.textContent = '';
      }
    } else if (validH && waist >= 40 && waist <= 200) {
      const r = waist / h;
      wv.textContent = r.toFixed(2);
      if (r < 0.5) setVerdict(whv, w('Below 0.5: no increased risk'), 'ok');
      else if (r < 0.6) setVerdict(whv, w('0.5–0.59: increased risk'), 'warn');
      else setVerdict(whv, w('0.6 or more: high risk'), 'risk');
      const cut = WAIST_CUT[sex], half = (h / 2).toFixed(0), people = sex === 'm' ? w('men') : w('women');
      wav.textContent = waist >= cut
        ? w('Keep your waist under {half} cm (half your height). Indian waist cut-off for {people}: {cut} cm — yours is at or above it.', { half, people, cut })
        : w('Keep your waist under {half} cm (half your height). Indian waist cut-off for {people}: {cut} cm — yours is below it.', { half, people, cut });
    } else {
      wv.textContent = '—'; setVerdict(whv, w('Add your waist to see abdominal fat risk.')); wav.textContent = '';
    }
  }
  form.addEventListener('input', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();

  // A link such as /tools/bmi-calculator/#weight opens the calculator with that box selected and ready to type in
  // (the home page's calculator picture links its Height, Weight, Waist and Sex fields this way).
  const READY: Record<string, string> = { height: 'hcm', weight: 'wkg', waist: 'waist' };
  function readyFromHash() {
    const key = location.hash.slice(1);
    const box = key === 'sex' ? form.querySelector<HTMLInputElement>('input[name=sex]:checked') : READY[key] ? $<HTMLInputElement>(READY[key]) : null;
    if (!box) return;
    box.scrollIntoView({ block: 'center' });
    box.focus({ preventScroll: true });
    if (box.type === 'number') box.select();
  }
  readyFromHash();
  addEventListener('hashchange', readyFromHash);
</script>
