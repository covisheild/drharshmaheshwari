---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { AGE_GROUPS } from '../../lib/activity';
import UnitField from '../../components/UnitField.astro';
import T from '../../components/T.astro';
import ClientWords from '../../components/ClientWords.astro';
import { inLang, langOf } from '../../i18n/languages';
import { localHref } from '../../i18n/routes';
import { useT } from '../../i18n/t';

// One page for every age: the age chips choose which questions show and which targets apply (India first:
// ICMR-NIN 2024 from 5 years; WHO where ICMR-NIN gives no numbers, under 5 and in pregnancy).
// From 15 years the same answers are also scored as the IPAQ short form. Plan: docs/activity-check-plan.md.
// Also /<lang>/tools/activity-check/: the page through the dictionary (t, <T>), the results through w() (src/i18n/client.ts).
const lang = langOf(Astro.url.pathname);
const t = useT(Astro.url.pathname);
const L = (href: string) => localHref(lang, href);
const url = `${SITE.url}${inLang(lang, '/tools/activity-check/')}`;
const ALL = 'teen adult older';

// The IPAQ short form's three kinds of activity (wording adapted; it asks about all the time on a day, see the FAQ).
const IPAQ = [
  { id: 'vig', title: 'Vigorous activity', time: 'Vigorous activity: time a day', text: 'Hard effort that makes it hard to talk: running, jogging, jumping rope, aerobics, competitive sport, fast cycling, heavy lifting or digging.' },
  { id: 'mod', title: 'Moderate activity', time: 'Moderate activity: time a day', text: 'Some effort: you breathe deeper and faster but can still talk. Yogasanas and pranayama, gardening, gentle swimming, cycling at a regular pace, badminton, table tennis, carrying light loads. Do not count walking here.' },
  { id: 'walk', title: 'Walking', time: 'Walking: time a day', text: 'All walking: at work, at home, to get from place to place, and for exercise or leisure. Brisk walking (3–6 km an hour) is moderate activity.' },
].map((q) => ({ ...q, title: t(q.title), time: t(q.time), text: t(q.text) }));
const DAYS = [0, 1, 2, 3, 4, 5, 6, 7];

const faq = [
  { q: 'How much physical activity is recommended for Indian adults?', a: 'The ICMR-NIN Dietary Guidelines for Indians (2024) recommend 30 to 60 minutes of moderate-intensity activity, such as brisk walking, on at least 5 days a week, or 15 minutes of vigorous activity on at least 5 days, or a mix, plus muscle-strengthening exercise for all muscle groups on at least 2 days. Over 60, add strength and balance activities on 3 or more days. This is close to WHO (150 to 300 minutes a week), with the extra point of spreading it over 5 days.' },
  { q: 'How much activity do children need?', a: 'ICMR-NIN (2024): from 5 to 19 years, at least 60 minutes of moderate-to-vigorous activity a day, with vigorous activity and strength training on at least 3 days a week. ICMR-NIN gives no numbers under 5, so this check uses WHO (2019): children aged 1 to 4 need at least 180 minutes a day of activity of any intensity (from 3 years, at least 60 of them energetic), and babies need floor play and, before they move about, at least 30 minutes of tummy time a day.' },
  { q: 'Why does this check use WHO for babies, young children and pregnancy?', a: 'India first: the targets come from the ICMR-NIN Dietary Guidelines for Indians (2024) wherever they give numbers, which is from 5 years. For children under 5 and in pregnancy ICMR-NIN gives no minutes or days (in pregnancy it advises enough exercise with 2 to 3 hours of rest in the day), so this check uses WHO.' },
  { q: 'Does walking count?', a: 'Yes. ICMR-NIN counts brisk walking at 3 to 6 km an hour as moderate activity, and household, work and travel activity count, not only exercise. Walking slower than 3 km an hour is light activity, so if most of your walking is slow, read your minutes as generous.' },
  { q: 'What is the IPAQ and what is a MET-minute?', a: 'The International Physical Activity Questionnaire (short form) is a 7-question survey of the last 7 days, used in studies worldwide from 15 to 69 years. A MET is a multiple of resting energy use: IPAQ counts walking as 3.3, moderate activity as 4 and vigorous activity as 8. MET-minutes are METs multiplied by minutes. 600 MET-minutes a week is roughly 150 minutes of moderate activity.' },
  { q: 'Why can the IPAQ level and the target check disagree?', a: 'They answer different questions. IPAQ sorts people into Low, Moderate or High by a mix of days and MET-minutes, and drops any day with less than 10 minutes. The target check counts every minute and also asks about muscle strengthening, which IPAQ does not.' },
].map((f) => ({ q: t(f.q), a: t(f.a) }));
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: t('Activity check: Indian (ICMR-NIN) physical activity targets by age, with the IPAQ short form'),
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: t('Checks a week of physical activity against the ICMR-NIN 2024 targets for each age from 5 years (WHO for under-5s and pregnancy) and scores the IPAQ short form from 15 years. Nothing you type leaves your device.'),
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={t('Activity check (Indian targets and IPAQ)')} description={t('Check a week of physical activity against the Indian (ICMR-NIN 2024) targets for your age, with WHO for babies, young children and pregnancy, and the IPAQ short form score from 15 years. Runs in your browser; nothing is stored.')} jsonld={jsonld}>
  <ClientWords sources={['/src/pages/tools/activity-check.astro', '/src/lib/activity.ts']} />
  <header class="page-head wrap">
    <span class="eyebrow">{t('Tools')}</span>
    <h1>{t('Activity check')}</h1>
    <p><T>Does your week reach the <b>physical activity targets for your age</b>? Indian targets (ICMR-NIN 2024) from 5 years; WHO's for babies, young children and pregnancy, where ICMR-NIN gives no numbers. From 15 years it also gives your <b>IPAQ</b> score. Everything is calculated on your device; nothing you type is sent or stored.</T></p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="act" novalidate>
      <fieldset>
        <legend>{t('Age')}</legend>
        <div class="chips" role="radiogroup">
          {AGE_GROUPS.map((g) => <label><input type="radio" name="age" value={g.id} checked={g.id === 'adult'} /> <span>{t(g.label)}</span></label>)}
        </div>
        <label class="tick" data-show="adult"><input type="checkbox" id="preg" /> <span>{t('Pregnant, or had a baby in the last year')}</span></label>
        <div class="seg small-seg" data-show="infant">
          <label><input type="radio" name="inf" value="0" checked /> <span>{t('0–3 months')}</span></label>
          <label><input type="radio" name="inf" value="1" /> <span>{t('4–11 months')}</span></label>
        </div>
        <div class="seg small-seg" data-show="toddler">
          <label><input type="radio" name="tod" value="0" checked /> <span>{t('1 year')}</span></label>
          <label><input type="radio" name="tod" value="1" /> <span>{t('2 years')}</span></label>
        </div>
      </fieldset>

      <p class="intro small muted" data-show={ALL}><T>Think about the <b>last 7 days</b>. Count all of it, short spells included: at work, at home, travelling and in your free time.</T></p>
      <p class="intro small muted" data-show="child"><T>Think about the <b>last 7 days</b>. A parent can answer with the child.</T></p>
      <p class="intro small muted" data-show="infant toddler preschool"><T>For a parent: think about a <b>typical day</b> (24 hours).</T></p>

      {IPAQ.map((q) => (
        <fieldset class="q" data-show={ALL}>
          <legend>{q.title}</legend>
          <p class="small muted hint">{q.text}</p>
          <p class="ask">{t('On how many days?')}</p>
          <div class="days">{DAYS.map((d) => <label><input type="radio" name={`${q.id}-d`} value={d} /> <span>{d}</span></label>)}</div>
          <div class="row mins" id={`${q.id}-m-row`} hidden>
            <span class="ask">{t('On those days, in total')}</span>
            <UnitField id={`${q.id}-m`} kind="minutes" per="/day" label={q.time} placeholder={30} />
          </div>
        </fieldset>
      ))}

      <fieldset class="q" data-show="child teen">
        <legend>{t('60 minutes of energetic activity')}</legend>
        <p class="small muted hint">{t('Anything that makes you breathe harder and your heart beat faster: running games, sports, cycling, skipping, dancing, brisk walking, PE. Add up all the time in a day.')}</p>
        <p class="ask">{t('On how many of the last 7 days did it add up to 60 minutes or more?')}</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="d60" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>
      <fieldset class="q" data-show="child">
        <legend>{t('Hard (vigorous) activity')}</legend>
        <p class="small muted hint">{t('So hard you cannot talk freely: running, football, kabaddi, jumping rope, swimming laps, fast cycling.')}</p>
        <p class="ask">{t('On how many days?')}</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="cv-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show="child teen adult older">
        <legend>{t('Muscle strengthening')}</legend>
        <p class="small muted hint" data-show="child teen">{t('Activities that make muscles and bones work hard: climbing, jumping, skipping rope, gymnastics, push-ups, tug of war.')}</p>
        <p class="small muted hint" data-show="adult older">{t('Working all the major muscle groups (legs, hips, back, abdomen, chest, shoulders, arms): weights, resistance bands, push-ups, squats, heavy gardening.')}</p>
        <p class="ask">{t('On how many days?')}</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="str-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show="older">
        <legend>{t('Strength and balance')}</legend>
        <p class="small muted hint">{t('Activities that build strength and steadiness: lunges, walking backwards, dancing, standing on one leg, step-ups, getting up from a chair without using your hands, yogasanas that train balance.')}</p>
        <p class="ask">{t('On how many days?')}</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="bal-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show={ALL}>
        <legend>{t('Sitting')} <span class="muted small">{t('(optional)')}</span></legend>
        <p class="small muted hint">{t('On a weekday: at a desk, at meals, travelling seated, reading or watching TV.')}</p>
        <div class="row"><UnitField id="sit" kind="hours" per="/day" label={t('Sitting: time a day')} placeholder={7} /></div>
      </fieldset>
      <fieldset class="q" data-show="child">
        <legend>{t('Screen time for fun')} <span class="muted small">{t('(optional)')}</span></legend>
        <p class="small muted hint">{t('TV, phone, tablet and games, not schoolwork.')}</p>
        <div class="row"><UnitField id="cscreen" kind="hours" per="/day" label={t('Screen time for fun: time a day')} placeholder={2} /></div>
      </fieldset>

      <fieldset class="q" data-show="infant">
        <legend>{t('Is your baby moving about yet?')}</legend>
        <p class="small muted hint">{t('Rolling, crawling or shuffling from place to place.')}</p>
        <div class="seg"><label><input type="radio" name="mobile" value="0" /> <span>{t('Not yet')}</span></label><label><input type="radio" name="mobile" value="1" /> <span>{t('Yes')}</span></label></div>
      </fieldset>
      <fieldset class="q" id="tummy-q" data-show="infant" hidden>
        <legend>{t('Tummy time')}</legend>
        <p class="small muted hint">{t('Awake, lying on the tummy, all the short spells of the day added up.')}</p>
        <div class="row"><UnitField id="tummy" kind="minutes" per="/day" label={t('Tummy time: time a day')} placeholder={30} /></div>
      </fieldset>
      <fieldset class="q" id="play-q" data-show="infant" hidden>
        <legend>{t('Active several times a day?')}</legend>
        <p class="small muted hint">{t('Floor play: reaching, rolling, crawling, pulling up, with you joining in.')}</p>
        <div class="seg"><label><input type="radio" name="play" value="1" /> <span>{t('Yes')}</span></label><label><input type="radio" name="play" value="0" /> <span>{t('Not really')}</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="toddler preschool">
        <legend>{t('Active play, any intensity')}</legend>
        <p class="small muted hint">{t('Moving about, standing, walking, climbing, running, dancing: all of it in the day, added up.')}</p>
        <div class="row"><UnitField id="active" kind="minutes" per="/day" label={t('Active play: time a day')} placeholder={180} /></div>
      </fieldset>
      <fieldset class="q" data-show="preschool">
        <legend>{t('Of that, energetic play')}</legend>
        <p class="small muted hint">{t('Running, jumping, chasing games, riding a tricycle fast: breathing harder.')}</p>
        <div class="row"><UnitField id="mvpa" kind="minutes" per="/day" label={t('Energetic play: time a day')} placeholder={60} /></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>{t('Strapped in for more than 1 hour at a stretch?')}</legend>
        <p class="small muted hint">{t('In a pram, stroller, high chair, car seat, or carried strapped to someone.')}</p>
        <div class="seg"><label><input type="radio" name="restr" value="0" /> <span>{t('No')}</span></label><label><input type="radio" name="restr" value="1" /> <span>{t('Yes, sometimes')}</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>{t('Screen time')}</legend>
        <p class="small muted hint">{t('Sitting watching TV, videos or a phone, or playing games on a screen.')}</p>
        <div class="row"><UnitField id="u5screen" kind="minutes" per="/day" label={t('Screen time: time a day')} placeholder={0} /></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>{t('Sleep in 24 hours')}</legend>
        <p class="small muted hint">{t('Night sleep and naps together.')}</p>
        <div class="row"><UnitField id="sleep" kind="hours" label={t('Sleep in 24 hours')} placeholder={12} /></div>
      </fieldset>

      <p class="small muted" style="margin:0">{t('ICMR-NIN advises seeing a doctor before starting an exercise programme if you have heart disease, high blood pressure, diabetes, asthma, osteoporosis or obesity, if you have been inactive, or if you are over 40 and plan vigorous exercise. Start low and build up gradually; stop and rest if you feel breathless, pain, nausea or a headache.')}</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result">
        <span class="eyebrow" id="who-title">{t('Targets')}</span>
        <div class="big" id="who-big"><b id="who-min">—</b><span id="who-unit"></span></div>
        <div class="bar" id="who-bar" hidden aria-hidden="true"><div class="fill" id="who-fill"></div><i id="who-t1"></i><i id="who-t2"></i></div>
        <p class="verdict" id="who-verdict">{t('Answer the questions to see your result.')}</p>
        <p class="small muted" id="who-gap"></p>
        <ul class="checks" id="who-checks"></ul>
        <p class="small muted" id="who-notes"></p>
      </div>

      <div class="card result" id="ipaq-card">
        <span class="eyebrow">{t('IPAQ short form')}</span>
        <div class="big"><b id="ipaq-level">—</b><span id="ipaq-met"></span></div>
        <p class="verdict" id="ipaq-verdict">{t('Answer the three activity questions.')}</p>
        <details id="ipaq-details">
          <summary>{t('IPAQ details')}</summary>
          <table class="ipaq-table">
            <thead><tr><th></th><th>{t('Days')}</th><th>{t('Min/day')}</th><th>{t('MET')}</th><th>{t('MET-min/week')}</th></tr></thead>
            <tbody id="ipaq-rows"></tbody>
          </table>
          <ul class="small muted" id="ipaq-notes"></ul>
        </details>
        <p class="small muted" id="ipaq-valid"></p>
      </div>

      <p class="small muted" id="sedentary"></p>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>{t('The targets by age')}</h2>
    <table>
      <thead><tr><th>{t('Age')}</th><th>{t('Activity')}</th><th>{t('Also')}</th><th>{t('Source')}</th></tr></thead>
      <tbody>
        <tr><td>{t('Under 1')}</td><td>{t('Active several times a day, especially floor play; before moving about, at least 30 min tummy time')}</td><td>{t('No screens; not strapped in for more than 1 h at a time; sleep 14–17 h (0–3 months), 12–16 h (4–11 months)')}</td><td>{t('WHO 2019')}</td></tr>
        <tr><td>{t('1–2 years')}</td><td>{t('At least 180 min a day, any intensity')}</td><td>{t('No screens at 1, at most 1 h at 2; sleep 11–14 h')}</td><td>{t('WHO 2019')}</td></tr>
        <tr><td>{t('3–4 years')}</td><td>{t('At least 180 min a day, of which at least 60 min energetic')}</td><td>{t('Screens at most 1 h; sleep 10–13 h')}</td><td>{t('WHO 2019')}</td></tr>
        <tr><td>{t('5–19 years')}</td><td>{t('At least 60 min a day of moderate-to-vigorous activity')}</td><td>{t('Vigorous activity and strength training on 3 or more days')}</td><td>{t('ICMR-NIN 2024')}</td></tr>
        <tr><td>{t('20–60 years')}</td><td>{t('30–60 min moderate on at least 5 days, or 15 min vigorous on at least 5 days, or a mix')}</td><td>{t('Muscle strengthening, all muscle groups, on 2 or more days')}</td><td>{t('ICMR-NIN 2024')}</td></tr>
        <tr><td>{t('Over 60')}</td><td>{t('As for 20–60')}</td><td>{t('Also strength and balance activities on 3 or more days')}</td><td>{t('ICMR-NIN 2024')}</td></tr>
        <tr><td>{t('Pregnancy and after birth')}</td><td>{t('At least 150 min moderate a week')}</td><td>{t('Include muscle strengthening; vigorous activity if you did it before pregnancy')}</td><td>{t('WHO 2020')}</td></tr>
      </tbody>
    </table>
    <p>{t('Some activity is better than none, and every minute counts. Self-reported activity tends to run high: in validation studies the IPAQ short form overestimated activity measured by devices.')}</p>
    <div class="faq">
      <h2>{t('Common questions')}</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <details><summary>{t('How is this check different from the original IPAQ?')}</summary><p>{t('The original IPAQ asks only about activity done for at least 10 minutes at a time. This page asks about all of it, because short spells count too (WHO has counted every minute since 2020, and ICMR-NIN suggests walking 5 to 10 minutes every few hours). The IPAQ score here then follows the IPAQ scoring protocol: a day with under 10 minutes counts as zero, more than 180 minutes a day counts as 180, and answers adding up to more than 16 hours a day are not scored. Walking counts towards the target minutes, as brisk walking is moderate-intensity activity.')}</p></details>
    </div>
    <div class="refs" style="margin-top:2rem">
      <h2>{t('Sources')}</h2>
      <ol lang="en">
        <li><a href="https://www.nin.res.in/dietaryguidelines/pdfjs/locale/DGI_2024.pdf">ICMR-National Institute of Nutrition. Dietary Guidelines for Indians. Hyderabad: ICMR-NIN; 2024. Guideline 10, pp. 69-72.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/33239350/">Bull FC, et al. World Health Organization 2020 guidelines on physical activity and sedentary behaviour. Br J Sports Med 2020;54:1451-62.</a></li>
        <li><a href="https://www.ncbi.nlm.nih.gov/books/NBK541170/">WHO. Guidelines on physical activity, sedentary behaviour and sleep for children under 5 years of age. Geneva: WHO; 2019.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/12900694/">Craig CL, et al. International Physical Activity Questionnaire: 12-country reliability and validity. Med Sci Sports Exerc 2003;35:1381-95.</a></li>
        <li><a href="https://sites.google.com/view/ipaq/score">IPAQ Research Committee. Guidelines for data processing and analysis of the IPAQ, short and long forms. November 2005.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/22018588/">Lee PH, et al. Validity of the International Physical Activity Questionnaire Short Form (IPAQ-SF): a systematic review. Int J Behav Nutr Phys Act 2011;8:115.</a></li>
      </ol>
    </div>
    <p class="disclaimer"><a href={L('/disclaimer/')}>{t('Disclaimer')}</a></p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc { gap: 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  fieldset.q { border-top: 1px solid var(--line); padding-top: 1rem; }
  legend { font-weight: 650; margin-bottom: .35rem; padding: 0; }
  [hidden] { display: none !important; }
  .hint { margin: 0 0 .6rem; }
  .ask { margin: 0 0 .4rem; font-size: .92rem; font-weight: 550; color: var(--ink-2); }
  .intro { margin: 0; }
  .chips, .days { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chips label, .days label, .seg label, .tick { cursor: pointer; }
  .chips input, .days input, .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .chips span, .days span { display: block; padding: .45rem .85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font-weight: 550; transition: background .2s, color .2s, border-color .2s; }
  .days span { min-width: 2.6rem; text-align: center; padding-inline: .5rem; }
  .chips input:checked + span, .days input:checked + span { background: var(--brand-fill); border-color: var(--brand-fill); color: var(--brand-ink); }
  .chips input:focus-visible + span, .days input:focus-visible + span, .seg input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .seg { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg span { display: block; padding: .5rem 1.1rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .small-seg { margin-top: .7rem; } .small-seg span { padding: .3rem .8rem; font-size: .9rem; }
  .tick { display: flex; gap: .5rem; align-items: center; margin-top: .8rem; color: var(--ink-2); }
  .tick input { width: 1.1rem; height: 1.1rem; accent-color: var(--brand); }
  .row { display: flex; gap: .6rem; align-items: center; }
  .mins { margin-top: .7rem; flex-wrap: wrap; }
  .mins .ask { margin: 0; }
  .results { display: grid; gap: 1.25rem; position: sticky; top: 84px; }
  @media (max-width: 820px) { .results { position: static; } }
  .big { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .big b { font: 600 3rem/1 var(--font-display); color: var(--ink); }
  .big span { color: var(--ink-3); font-size: .95rem; }
  .bar { position: relative; height: 12px; border-radius: 999px; background: var(--surface-2); margin-top: 1rem; }
  .fill { height: 100%; border-radius: 999px; background: var(--brand-fill); width: 0; transition: width .6s cubic-bezier(.2,.8,.2,1); }
  .bar i { position: absolute; top: -5px; width: 3px; height: 22px; border-radius: 2px; background: var(--ink); }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); }
  .checks { list-style: none; padding: 0; margin: .9rem 0 0; display: grid; gap: .6rem; }
  /* The checklist rows and IPAQ table rows are built by the script, so their styles must be global (scoped CSS never reaches them). */
  .checks :global(li) { display: grid; grid-template-columns: 1.6rem 1fr; gap: .15rem .5rem; align-items: start; }
  .checks :global(.mark) { grid-row: span 2; width: 1.4rem; height: 1.4rem; border-radius: 50%; display: grid; place-items: center; font-size: .8rem; font-weight: 700; border: 2px solid var(--line); color: var(--ink-3); }
  .checks :global(.met .mark) { background: var(--ok); border-color: var(--ok); color: var(--surface); }
  .checks :global(.not .mark) { border-color: var(--warn); color: var(--warn); }
  .checks :global(b) { font-weight: 600; }
  .checks :global(.met .st) { color: var(--ok); } .checks :global(.not .st) { color: var(--warn); }
  .checks :global(small) { color: var(--ink-2); font-size: .88rem; }
  details summary { cursor: pointer; font-weight: 600; margin-top: .6rem; color: var(--brand); }
  .ipaq-table { width: 100%; border-collapse: collapse; margin: .75rem 0; font-size: .9rem; }
  .ipaq-table th, .ipaq-table :global(td) { text-align: right; padding: .4rem .35rem; border-bottom: 1px solid var(--line); }
  .ipaq-table th:first-child, .ipaq-table :global(td:first-child) { text-align: left; }
  .ipaq-table :global(tr:last-child td) { font-weight: 650; border-bottom: 0; }
  #ipaq-notes { padding-left: 1.1rem; margin: .3rem 0 0; }
</style>

<script>
  import { unitValue as uv } from '../../scripts/unit-fields';
  import { w } from '../../i18n/client';
  import { usesIpaq, ipaqScore, checkAdult, checkTeen, checkYouth, checkUnder5, MET, type AgeGroup, type Bout, type TargetResult, type Check } from '../../lib/activity';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('act');
  const picked = (name: string) => (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value ?? null;
  const pickedNum = (name: string) => { const v = picked(name); return v == null ? null : Number(v); };
  const yes = (name: string) => { const v = picked(name); return v == null ? null : v === '1'; };
  // Unit boxes give minutes (or hours) whichever unit the person typed in; shown rounded to whole minutes / tenths of an hour.
  const read = (id: string, places: number) => { const v = uv(id); return Number.isFinite(v) && v >= 0 ? Number(v.toFixed(places)) : null; };
  const mins = (id: string) => read(id, 0), hrs = (id: string) => read(id, 1);
  const fmt = (n: number) => Math.round(n).toLocaleString('en-IN');
  const LABEL: Record<AgeGroup, string> = { infant: w('under 1'), toddler: w('1–2 years'), preschool: w('3–4 years'), child: w('5–14 years'), teen: w('15–19 years'), adult: w('20–60 years'), older: w('over 60') };

  // ---------- Words from src/lib/activity.ts ----------
  // The lib writes its labels, details, gaps and notes in English. Fixed ones are translated whole with w(); ones with
  // numbers in them are parsed here and rebuilt from whole-sentence keys (the lib stays as it is, tests/activity.test.mjs).
  // ClientWords sends every `label: '...'` in the lib; these fixed texts are set there in other ways, so they are listed here:
  // w('Aerobic activity, 150 minutes a week') w('Aerobic activity, 30 minutes on 5 or more days')
  // w('Muscle strengthening, all major muscle groups') w('Strength and balance activities')
  // w('Energetic activity, 60 minutes every day') w('Vigorous activity') w('Strength training (muscles and bones)')
  // w('Active several times a day (floor play)') w('Physical activity, any intensity') w('Not strapped in for more than 1 hour at a time')
  // w('moderate-intensity minutes a week (vigorous minutes count double)') w('of 7 days with 60 minutes or more of energetic activity')
  // w('WHO: at least 150 minutes a week of moderate activity.') w('ICMR-NIN: 30-60 minutes of moderate activity, or 15 of vigorous, on at least 5 days a week.')
  // w('WHO: include some (no set number of days).')
  // w('ICMR-NIN gives no number for pregnancy (it advises enough exercise with 2-3 hours of rest in the day), so this uses WHO: at least 150 minutes of moderate activity a week, if you have no medical reason to avoid it. Vigorous activity is fine if you did it regularly before pregnancy.')
  // w('ICMR-NIN: a minimum of 60 minutes of moderate-to-vigorous activity a day.')
  // w('WHO: at least 30 minutes a day, spread through the day while awake.')
  // w('WHO: active several times a day in a variety of ways, especially interactive floor play.')
  // w('WHO: at least 180 minutes a day, spread through the day.') w('WHO: at least 60 of the 180 minutes.')
  // w('Pram, stroller, high chair, car seat or carrier. WHO: no more than 1 hour at a stretch.')
  // w('WHO: no screen time at this age.') w('WHO: no more than 1 hour a day; less is better.')
  // w('ICMR-NIN gives no activity numbers for children under 5, so this uses the WHO 2019 guideline.')
  // IPAQ reasons: w('Does not meet the criteria for Moderate or High.')
  // w('Vigorous activity on 3 or more days and at least 1500 MET-minutes a week.') w('7 or more days of activity and at least 3000 MET-minutes a week.')
  // w('Vigorous activity on 3 or more days, at least 20 minutes a day.') w('Moderate activity or walking, at least 30 minutes a day, on 5 or more days.')
  // w('5 or more days of activity and at least 600 MET-minutes a week.')
  // A pattern for one of the lib's sentences: # is a number, {name} any text.
  const re = (s: string) => new RegExp('^' + s.replace(/[.*+?^$()|[\]\\]/g, '\\$&').replace(/#/g, '(\\d+(?:\\.\\d+)?)').replace(/\{\w+\}/g, '(.+?)') + '$');
  // "3 days" / "1 day" (the lib's days()), as a phrase that goes into a sentence.
  const daysText = (n: string) => (n === '1' ? w('{n} day', { n }) : w('{n} days', { n }));
  const kindName = (k: string) => (k === 'Vigorous' ? w('Vigorous') : k === 'Moderate' ? w('Moderate') : k === 'Walking' ? w('Walking') : k);
  const RULES: [RegExp, (m: string[]) => string][] = [
    // checkAdult
    [re('# more minutes a week of brisk walking or other moderate activity (about # a day), or about # minutes of vigorous activity.'),
      (m) => w('{need} more minutes a week of brisk walking or other moderate activity (about {day} a day), or about {vig} minutes of vigorous activity.', { need: m[1], day: m[2], vig: m[3] })],
    [re('Spread the same activity over 5 or more days (now {days}): 30 minutes a day, or 15 of vigorous activity.'),
      (m) => w('Spread the same activity over 5 or more days (now {days}): 30 minutes a day, or 15 of vigorous activity.', { days: daysOf(m[1]) })],
    [re('# of # minutes a week, on {days}. ICMR-NIN: 30-60 minutes of moderate activity (or 15 of vigorous) on at least 5 days.'),
      (m) => w('{min} of {target} minutes a week, on {days}. ICMR-NIN: 30-60 minutes of moderate activity (or 15 of vigorous) on at least 5 days.', { min: m[1], target: m[2], days: daysOf(m[3]) })],
    [re('# of # minutes a week.'), (m) => w('{min} of {target} minutes a week.', { min: m[1], target: m[2] })],
    [re('{days} a week. WHO: include some (no set number of days); gentle stretching may help too.'),
      (m) => w('{days} a week. WHO: include some (no set number of days); gentle stretching may help too.', { days: daysOf(m[1]) })],
    // daysCheck (src is ICMR-NIN or WHO, a name)
    [re('{src}: # or more days a week.'), (m) => w('{src}: {need} or more days a week.', { src: m[1], need: m[2] })],
    [re('{days} a week; {src}: # or more.'), (m) => w('{days} a week; {src}: {need} or more.', { days: daysOf(m[1]), src: m[2], need: m[3] })],
    // checkYouth
    [re('# more day a week with 60 minutes of energetic activity.'), (m) => w('{n} more day a week with 60 minutes of energetic activity.', { n: m[1] })],
    [re('# more days a week with 60 minutes of energetic activity.'), (m) => w('{n} more days a week with 60 minutes of energetic activity.', { n: m[1] })],
    [re('{days} of 7. ICMR-NIN: a minimum of 60 minutes a day.'), (m) => w('{days} of 7. ICMR-NIN: a minimum of 60 minutes a day.', { days: daysOf(m[1]) })],
    // checkUnder5
    [re('# minutes a day; WHO: at least 30, spread through the day while awake.'), (m) => w('{n} minutes a day; WHO: at least 30, spread through the day while awake.', { n: m[1] })],
    [re('# of 180 minutes a day, spread through the day.'), (m) => w('{n} of 180 minutes a day, spread through the day.', { n: m[1] })],
    [re('# of 60 minutes a day.'), (m) => w('{n} of 60 minutes a day.', { n: m[1] })],
    [re('# minutes a day. WHO: no screen time at this age.'), (m) => w('{n} minutes a day. WHO: no screen time at this age.', { n: m[1] })],
    [re('# minutes a day. WHO: no more than 1 hour a day; less is better.'), (m) => w('{n} minutes a day. WHO: no more than 1 hour a day; less is better.', { n: m[1] })],
    [re('# hours in 24; WHO: #–# hours (above the range).'), (m) => w('{h} hours in 24; WHO: {lo}–{hi} hours (above the range).', { h: m[1], lo: m[2], hi: m[3] })],
    [re('# hours in 24; WHO: #–# hours.'), (m) => w('{h} hours in 24; WHO: {lo}–{hi} hours.', { h: m[1], lo: m[2], hi: m[3] })],
    [re('WHO: #–# hours in 24, with regular sleep and wake-up times.'), (m) => w('WHO: {lo}–{hi} hours in 24, with regular sleep and wake-up times.', { lo: m[1], hi: m[2] })],
    // ipaqScore notes
    [re('{kind}: under 10 minutes a day, so not counted in the IPAQ score.'), (m) => w('{kind}: under 10 minutes a day, so not counted in the IPAQ score.', { kind: kindName(m[1]) })],
    [re('{kind}: counted as 180 minutes a day (the IPAQ maximum).'), (m) => w('{kind}: counted as 180 minutes a day (the IPAQ maximum).', { kind: kindName(m[1]) })],
  ];
  function daysOf(s: string) { const m = s.match(/^(\d+) days?$/); return m ? daysText(m[1]) : s; }
  /** A text from src/lib/activity.ts in the page's language. */
  function lib(s: string) {
    for (const [r, f] of RULES) { const m = s.match(r); if (m) return f(m); }
    return w(s);
  }

  /** Days chosen, and minutes once days are more than 0 (the minutes box shows only then). */
  function bout(id: string): Bout {
    const days = pickedNum(`${id}-d`);
    $(`${id}-m-row`).hidden = !days;
    return { days, minutes: days ? mins(`${id}-m`) : null };
  }

  function setVerdict(el: HTMLElement, text: string, cls = '') { el.textContent = text; el.className = `verdict ${cls}`; }

  function renderWho(group: AgeGroup, r: TargetResult, pregnant: boolean) {
    $('who-title').textContent = w('{source} targets, {who}', { source: r.source === 'WHO' ? 'WHO' : 'ICMR-NIN', who: pregnant ? w('pregnancy and after birth') : LABEL[group] });
    const a = r.aerobic;
    $('who-big').hidden = group === 'infant' || group === 'toddler' || group === 'preschool';
    $('who-min').textContent = a ? fmt(a.value) : '—';
    $('who-unit').textContent = a ? lib(a.unit) : '';
    const bar = $('who-bar');
    bar.hidden = !a;
    if (a) {
      const top = Math.max(a.max, a.value);
      $('who-fill').style.width = `${Math.min(a.value / top, 1) * 100}%`;
      $('who-t1').style.left = `calc(${(a.target / top) * 100}% - 1px)`;
      const t2 = $('who-t2');
      t2.hidden = !a.upper;
      if (a.upper) t2.style.left = `calc(${(a.upper / top) * 100}% - 1px)`;
    }
    const known = r.checks.filter((c) => c.status !== 'unknown');
    // The upper aerobic target is extra benefit, not a minimum: it is listed but not counted in the headline.
    const core = r.checks.filter((c) => c.id !== 'upper');
    const coreMet = core.filter((c) => c.status === 'met').length;
    const v = $('who-verdict');
    if (!known.length) setVerdict(v, w('Answer the questions to see your result.'));
    else if (core.every((c) => c.status === 'met')) setVerdict(v, core.length === 1 ? w('Reached the target') : w('Reached all {n} targets', { n: core.length }), 'ok');
    else if (core.some((c) => c.status === 'unknown')) setVerdict(v, w('{met} of {n} targets reached so far; answer the rest', { met: coreMet, n: core.length }));
    else setVerdict(v, w('Reached {met} of {n} targets: not yet all', { met: coreMet, n: core.length }), 'warn');
    $('who-gap').textContent = a?.gap ? w('To reach the minimum: {gap}', { gap: lib(a.gap) }) : '';
    $('who-checks').replaceChildren(...r.checks.map(checkItem));
    $('who-notes').textContent = r.notes.map(lib).join(' ');
  }

  function checkItem(c: Check) {
    const li = document.createElement('li');
    li.className = c.status;
    const mark = document.createElement('span');
    mark.className = 'mark'; mark.setAttribute('aria-hidden', 'true');
    mark.textContent = c.status === 'met' ? '✓' : c.status === 'not' ? '•' : '';
    const head = document.createElement('span');
    const b = document.createElement('b'); b.textContent = lib(c.label);
    const st = document.createElement('span'); st.className = 'st';
    st.textContent = c.status === 'met' ? ' · ' + w('Reached') : c.status === 'not' ? ' · ' + w('Not yet') : '';
    head.append(b, st);
    const small = document.createElement('small'); small.textContent = lib(c.detail);
    li.append(mark, head, small);
    return li;
  }

  function renderIpaq(group: AgeGroup, a: { vigorous: Bout; moderate: Bout; walking: Bout }, pregnant: boolean) {
    const r = ipaqScore(a);
    const v = $('ipaq-verdict');
    const rows = $('ipaq-rows');
    $('ipaq-details').hidden = !r.ok;
    if (!r.ok) {
      $('ipaq-level').textContent = '—'; $('ipaq-met').textContent = '';
      setVerdict(v, r.reason === 'over16h' ? w('Your answers add up to more than 16 hours a day. Please check them.') : w('Answer the three activity questions.'), r.reason === 'over16h' ? 'warn' : '');
      rows.replaceChildren(); $('ipaq-notes').replaceChildren();
    } else {
      $('ipaq-level').textContent = r.level === 'high' ? w('High') : r.level === 'moderate' ? w('Moderate') : w('Low');
      $('ipaq-met').textContent = w('{met} MET-min/week', { met: fmt(r.total) });
      setVerdict(v, w('IPAQ level: {reason}', { reason: lib(r.reason) }));
      const line = (name: string, p: { days: number; minutes: number; met: number }, m: number) => {
        const tr = document.createElement('tr');
        for (const t of [name, String(p.days), String(p.minutes), String(m), fmt(p.met)]) { const td = document.createElement('td'); td.textContent = t; tr.append(td); }
        return tr;
      };
      const total = document.createElement('tr');
      for (const t of [w('Total'), '', '', '', fmt(r.total)]) { const td = document.createElement('td'); td.textContent = t; total.append(td); }
      rows.replaceChildren(line(w('Vigorous'), r.vigorous, MET.vigorous), line(w('Moderate'), r.moderate, MET.moderate), line(w('Walking'), r.walking, MET.walking), total);
      const notes = [...r.notes.map(lib), w('Low, Moderate and High are the IPAQ categories; they are not the same as the targets above.')];
      $('ipaq-notes').replaceChildren(...notes.map((n) => { const li = document.createElement('li'); li.textContent = n; return li; }));
    }
    const valid: string[] = [];
    if (group === 'older') valid.push(w('IPAQ was tested in people aged 15 to 69; from 70 years read the IPAQ level with caution.'));
    if (pregnant) valid.push(w('IPAQ has not been tested in pregnancy; read the IPAQ level with caution.'));
    $('ipaq-valid').textContent = valid.join(' ');
  }

  function update() {
    const group = picked('age') as AgeGroup;
    for (const el of form.querySelectorAll<HTMLElement>('[data-show]')) el.hidden = !el.dataset.show!.split(' ').includes(group);
    const pregnant = group === 'adult' && $<HTMLInputElement>('preg').checked;
    $('ipaq-card').hidden = !usesIpaq(group);
    const sed = $('sedentary');
    sed.textContent = '';

    if (usesIpaq(group)) {
      const a = { vigorous: bout('vig'), moderate: bout('mod'), walking: bout('walk') };
      const strengthDays = pickedNum('str-d');
      const r = group === 'teen' ? checkTeen({ ...a, days60: pickedNum('d60'), strengthDays })
        : checkAdult(group as 'adult' | 'older', { ...a, strengthDays, balanceDays: pickedNum('bal-d'), pregnant });
      renderWho(group, r, pregnant);
      renderIpaq(group, a, pregnant);
      const sit = hrs('sit');
      if (sit != null) sed.textContent = w('Sitting: about {h} hours on a weekday (not part of either score). ICMR-NIN and WHO set no number of hours, but ask everyone to sit less and replace some sitting with activity of any intensity.', { h: sit });
    } else if (group === 'child') {
      renderWho(group, checkYouth({ days60: pickedNum('d60'), vigorousDays: pickedNum('cv-d'), strengthDays: pickedNum('str-d') }), false);
      const scr = hrs('cscreen');
      if (scr != null) sed.textContent = w('Screen time for fun: about {h} hours a day. ICMR-NIN sets no number for this age, but advises cutting non-essential screen time.', { h: scr });
    } else {
      const mobile = yes('mobile');
      $('tummy-q').hidden = group !== 'infant' || mobile !== false;
      $('play-q').hidden = group !== 'infant' || mobile !== true;
      const older = group === 'infant' ? picked('inf') === '1' : picked('tod') === '1';
      renderWho(group, checkUnder5(group as 'infant' | 'toddler' | 'preschool', {
        older, mobile, tummyMin: mins('tummy'), floorPlay: yes('play'), activeMin: mins('active'), mvpaMin: mins('mvpa'),
        restrained: yes('restr'), screenMin: mins('u5screen'), sleepH: hrs('sleep'),
      }), false);
    }
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
