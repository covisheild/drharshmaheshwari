---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { AGE_GROUPS } from '../../lib/activity';

// One page for every age: the age chips choose which questions show and which WHO targets apply.
// From 15 years the same answers are also scored as the IPAQ short form. Plan: docs/activity-check-plan.md.
const url = `${SITE.url}/tools/activity-check/`;
const ALL = 'teen adult older';

// The IPAQ short form's three kinds of activity (wording adapted; it asks about all the time on a day, see the FAQ).
const IPAQ = [
  { id: 'vig', title: 'Vigorous activity', text: 'Hard effort that makes you breathe much harder than normal: running, fast cycling, football, aerobics, heavy lifting, digging.' },
  { id: 'mod', title: 'Moderate activity', text: 'Effort that makes you breathe somewhat harder than normal: cycling at a regular pace, carrying light loads, badminton doubles, scrubbing floors. Do not count walking here.' },
  { id: 'walk', title: 'Walking', text: 'All walking: at work, at home, to get from place to place, and for exercise or leisure.' },
];
const DAYS = [0, 1, 2, 3, 4, 5, 6, 7];

const faq = [
  { q: 'How much physical activity does WHO recommend for adults?', a: 'WHO (2020) recommends 150 to 300 minutes a week of moderate-intensity activity, or 75 to 150 minutes of vigorous activity, or a mix, plus muscle-strengthening activity on 2 or more days a week. Adults of 65 and over should also do balance and strength activity on 3 or more days a week.' },
  { q: 'How much activity do children need?', a: 'From 5 to 17 years, an average of 60 minutes a day of moderate-to-vigorous activity across the week, with vigorous activity and muscle- and bone-strengthening activity on at least 3 days. Children aged 1 to 4 need at least 180 minutes a day of activity of any intensity (from 3 years, at least 60 of them energetic), and babies need floor play and, before they move about, at least 30 minutes of tummy time a day.' },
  { q: 'Does walking count?', a: 'Yes. Brisk walking is moderate-intensity activity, and WHO counts activity at work, at home and on the way to places, not only exercise. Slow strolling counts for less, so if most of your walking is slow, read your WHO minutes as generous.' },
  { q: 'What is the IPAQ and what is a MET-minute?', a: 'The International Physical Activity Questionnaire (short form) is a 7-question survey of the last 7 days, used in studies worldwide from 15 to 69 years. A MET is a multiple of resting energy use: IPAQ counts walking as 3.3, moderate activity as 4 and vigorous activity as 8. MET-minutes are METs multiplied by minutes. 600 MET-minutes a week is roughly 150 minutes of moderate activity.' },
  { q: 'Why can the IPAQ level and the WHO result disagree?', a: 'They answer different questions. IPAQ sorts people into Low, Moderate or High by a mix of days and MET-minutes, and drops any day with less than 10 minutes. WHO counts every minute since 2020 and also asks about muscle strengthening, which IPAQ does not.' },
];
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: 'Activity check: WHO physical activity targets by age, with the IPAQ short form',
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: 'Checks a week of physical activity against the WHO 2020 targets for each age (WHO 2019 for under-5s) and scores the IPAQ short form from 15 years. Nothing you type leaves your device.',
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Activity check (WHO targets and IPAQ)" description="Check a week of physical activity against the WHO targets for your age, from babies to 65+, with the IPAQ short form score from 15 years. Runs in your browser; nothing is stored." jsonld={jsonld}>
  <header class="page-head wrap">
    <span class="eyebrow">Tools</span>
    <h1>Activity check</h1>
    <p>Does your week reach the <b>WHO targets for your age</b>? From 15 years it also gives your <b>IPAQ</b> score. Everything is calculated on your device; nothing you type is sent or stored.</p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="act" novalidate>
      <fieldset>
        <legend>Age</legend>
        <div class="chips" role="radiogroup">
          {AGE_GROUPS.map((g) => <label><input type="radio" name="age" value={g.id} checked={g.id === 'adult'} /> <span>{g.label}</span></label>)}
        </div>
        <label class="tick" data-show="adult"><input type="checkbox" id="preg" /> <span>Pregnant, or had a baby in the last year</span></label>
        <div class="seg small-seg" data-show="infant">
          <label><input type="radio" name="inf" value="0" checked /> <span>0–3 months</span></label>
          <label><input type="radio" name="inf" value="1" /> <span>4–11 months</span></label>
        </div>
        <div class="seg small-seg" data-show="toddler">
          <label><input type="radio" name="tod" value="0" checked /> <span>1 year</span></label>
          <label><input type="radio" name="tod" value="1" /> <span>2 years</span></label>
        </div>
      </fieldset>

      <p class="intro small muted" data-show={ALL}>Think about the <b>last 7 days</b>. Count all of it, short spells included: at work, at home, travelling and in your free time.</p>
      <p class="intro small muted" data-show="child">Think about the <b>last 7 days</b>. A parent can answer with the child.</p>
      <p class="intro small muted" data-show="infant toddler preschool">For a parent: think about a <b>typical day</b> (24 hours).</p>

      {IPAQ.map((q) => (
        <fieldset class="q" data-show={ALL}>
          <legend>{q.title}</legend>
          <p class="small muted hint">{q.text}</p>
          <p class="ask">On how many days?</p>
          <div class="days">{DAYS.map((d) => <label><input type="radio" name={`${q.id}-d`} value={d} /> <span>{d}</span></label>)}</div>
          <div class="row mins" id={`${q.id}-m-row`} hidden>
            <span class="ask">On those days, in total</span>
            <label class="field"><input type="number" inputmode="numeric" id={`${q.id}-m`} min="0" max="960" placeholder="30" aria-label={`${q.title}: minutes a day`} /><span>min/day</span></label>
          </div>
        </fieldset>
      ))}

      <fieldset class="q" data-show="child">
        <legend>Energetic activity</legend>
        <p class="small muted hint">Anything that makes you breathe harder and your heart beat faster: running games, sports, cycling, skipping, dancing, brisk walking to school, PE.</p>
        <p class="ask">On how many days?</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="cm-d" value={d} /> <span>{d}</span></label>)}</div>
        <div class="row mins" id="cm-m-row" hidden>
          <span class="ask">On those days, in total</span>
          <label class="field"><input type="number" inputmode="numeric" id="cm-m" min="0" max="960" placeholder="60" aria-label="Energetic activity: minutes a day" /><span>min/day</span></label>
        </div>
      </fieldset>
      <fieldset class="q" data-show="child">
        <legend>Hard (vigorous) activity</legend>
        <p class="small muted hint">So hard you are out of breath: running, football, kabaddi, swimming laps, fast cycling.</p>
        <p class="ask">On how many days?</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="cv-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show="child teen adult older">
        <legend>Muscle strengthening</legend>
        <p class="small muted hint" data-show="child teen">Activities that make muscles and bones work hard: climbing, jumping, skipping rope, gymnastics, push-ups, tug of war.</p>
        <p class="small muted hint" data-show="adult older">Working all the major muscle groups (legs, hips, back, abdomen, chest, shoulders, arms): weights, resistance bands, push-ups, squats, heavy gardening.</p>
        <p class="ask">On how many days?</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="str-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show="older">
        <legend>Balance and strength together</legend>
        <p class="small muted hint">Varied activity that trains balance, strength and walking: tai chi, dancing, standing on one leg, step-ups, getting up from a chair without using your hands, balance-focused yoga.</p>
        <p class="ask">On how many days?</p>
        <div class="days">{DAYS.map((d) => <label><input type="radio" name="bal-d" value={d} /> <span>{d}</span></label>)}</div>
      </fieldset>

      <fieldset class="q" data-show={ALL}>
        <legend>Sitting <span class="muted small">(optional)</span></legend>
        <p class="small muted hint">On a weekday: at a desk, at meals, travelling seated, reading or watching TV.</p>
        <div class="row"><label class="field"><input type="number" inputmode="decimal" id="sit" min="0" max="20" step="0.5" placeholder="7" aria-label="Sitting: hours a day" /><span>hours/day</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="child">
        <legend>Screen time for fun <span class="muted small">(optional)</span></legend>
        <p class="small muted hint">TV, phone, tablet and games, not schoolwork.</p>
        <div class="row"><label class="field"><input type="number" inputmode="decimal" id="cscreen" min="0" max="20" step="0.5" placeholder="2" aria-label="Screen time for fun: hours a day" /><span>hours/day</span></label></div>
      </fieldset>

      <fieldset class="q" data-show="infant">
        <legend>Is your baby moving about yet?</legend>
        <p class="small muted hint">Rolling, crawling or shuffling from place to place.</p>
        <div class="seg"><label><input type="radio" name="mobile" value="0" /> <span>Not yet</span></label><label><input type="radio" name="mobile" value="1" /> <span>Yes</span></label></div>
      </fieldset>
      <fieldset class="q" id="tummy-q" data-show="infant" hidden>
        <legend>Tummy time</legend>
        <p class="small muted hint">Awake, lying on the tummy, all the short spells of the day added up.</p>
        <div class="row"><label class="field"><input type="number" inputmode="numeric" id="tummy" min="0" max="600" placeholder="30" aria-label="Tummy time: minutes a day" /><span>min/day</span></label></div>
      </fieldset>
      <fieldset class="q" id="play-q" data-show="infant" hidden>
        <legend>Active several times a day?</legend>
        <p class="small muted hint">Floor play: reaching, rolling, crawling, pulling up, with you joining in.</p>
        <div class="seg"><label><input type="radio" name="play" value="1" /> <span>Yes</span></label><label><input type="radio" name="play" value="0" /> <span>Not really</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="toddler preschool">
        <legend>Active play, any intensity</legend>
        <p class="small muted hint">Moving about, standing, walking, climbing, running, dancing: all of it in the day, added up.</p>
        <div class="row"><label class="field"><input type="number" inputmode="numeric" id="active" min="0" max="900" placeholder="180" aria-label="Active play: minutes a day" /><span>min/day</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="preschool">
        <legend>Of that, energetic play</legend>
        <p class="small muted hint">Running, jumping, chasing games, riding a tricycle fast: breathing harder.</p>
        <div class="row"><label class="field"><input type="number" inputmode="numeric" id="mvpa" min="0" max="900" placeholder="60" aria-label="Energetic play: minutes a day" /><span>min/day</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>Strapped in for more than 1 hour at a stretch?</legend>
        <p class="small muted hint">In a pram, stroller, high chair, car seat, or carried strapped to someone.</p>
        <div class="seg"><label><input type="radio" name="restr" value="0" /> <span>No</span></label><label><input type="radio" name="restr" value="1" /> <span>Yes, sometimes</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>Screen time</legend>
        <p class="small muted hint">Sitting watching TV, videos or a phone, or playing games on a screen.</p>
        <div class="row"><label class="field"><input type="number" inputmode="numeric" id="u5screen" min="0" max="900" placeholder="0" aria-label="Screen time: minutes a day" /><span>min/day</span></label></div>
      </fieldset>
      <fieldset class="q" data-show="infant toddler preschool">
        <legend>Sleep in 24 hours</legend>
        <p class="small muted hint">Night sleep and naps together.</p>
        <div class="row"><label class="field"><input type="number" inputmode="decimal" id="sleep" min="4" max="22" step="0.5" placeholder="12" aria-label="Sleep: hours in 24" /><span>hours</span></label></div>
      </fieldset>

      <p class="small muted" style="margin:0">Long-term conditions or a disability: WHO's targets are the same, adapted to what you can do. Start low, build up, and check with your doctor if you have heart disease, chest pain or a recent illness.</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result">
        <span class="eyebrow" id="who-title">WHO targets</span>
        <div class="big" id="who-big"><b id="who-min">—</b><span id="who-unit"></span></div>
        <div class="bar" id="who-bar" hidden aria-hidden="true"><div class="fill" id="who-fill"></div><i id="who-t1"></i><i id="who-t2"></i></div>
        <p class="verdict" id="who-verdict">Answer the questions to see your result.</p>
        <p class="small muted" id="who-gap"></p>
        <ul class="checks" id="who-checks"></ul>
        <p class="small muted" id="who-notes"></p>
      </div>

      <div class="card result" id="ipaq-card">
        <span class="eyebrow">IPAQ short form</span>
        <div class="big"><b id="ipaq-level">—</b><span id="ipaq-met"></span></div>
        <p class="verdict" id="ipaq-verdict">Answer the three activity questions.</p>
        <details id="ipaq-details">
          <summary>IPAQ details</summary>
          <table class="ipaq-table">
            <thead><tr><th></th><th>Days</th><th>Min/day</th><th>MET</th><th>MET-min/week</th></tr></thead>
            <tbody id="ipaq-rows"></tbody>
          </table>
          <ul class="small muted" id="ipaq-notes"></ul>
        </details>
        <p class="small muted" id="ipaq-valid"></p>
      </div>

      <p class="small muted" id="sedentary"></p>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>The WHO targets by age</h2>
    <table>
      <thead><tr><th>Age</th><th>Activity</th><th>Also</th></tr></thead>
      <tbody>
        <tr><td>Under 1</td><td>Active several times a day, especially floor play; before moving about, at least 30 min tummy time</td><td>No screens; not strapped in for more than 1 h at a time; sleep 14–17 h (0–3 months), 12–16 h (4–11 months)</td></tr>
        <tr><td>1–2 years</td><td>At least 180 min a day, any intensity</td><td>No screens at 1, at most 1 h at 2; sleep 11–14 h</td></tr>
        <tr><td>3–4 years</td><td>At least 180 min a day, of which at least 60 min energetic</td><td>Screens at most 1 h; sleep 10–13 h</td></tr>
        <tr><td>5–17 years</td><td>An average of 60 min a day of moderate-to-vigorous activity across the week</td><td>Vigorous activity and muscle- and bone-strengthening on 3 or more days; limit screen time for fun</td></tr>
        <tr><td>18–64 years</td><td>150–300 min moderate, or 75–150 min vigorous, a week (or a mix)</td><td>Muscle strengthening on 2 or more days; sit less</td></tr>
        <tr><td>65+ years</td><td>As for 18–64</td><td>Also balance and strength activity on 3 or more days</td></tr>
        <tr><td>Pregnancy and after birth</td><td>At least 150 min moderate a week</td><td>Include muscle strengthening; vigorous activity if you did it before pregnancy</td></tr>
      </tbody>
    </table>
    <p>Some activity is better than none, and every minute counts. Self-reported activity tends to run high: in validation studies the IPAQ short form overestimated activity measured by devices.</p>
    <div class="faq">
      <h2>Common questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <details><summary>How is this check different from the original IPAQ?</summary><p>The original IPAQ asks only about activity done for at least 10 minutes at a time. This page asks about all of it, because WHO counts every minute since 2020. The IPAQ score here then follows the IPAQ scoring protocol: a day with under 10 minutes counts as zero, more than 180 minutes a day counts as 180, and answers adding up to more than 16 hours a day are not scored. Walking counts towards the WHO minutes, as brisk walking is moderate-intensity activity.</p></details>
    </div>
    <div class="refs" style="margin-top:2rem">
      <h2>Sources</h2>
      <ol>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/33239350/">Bull FC, et al. World Health Organization 2020 guidelines on physical activity and sedentary behaviour. Br J Sports Med 2020;54:1451-62.</a></li>
        <li><a href="https://www.ncbi.nlm.nih.gov/books/NBK541170/">WHO. Guidelines on physical activity, sedentary behaviour and sleep for children under 5 years of age. Geneva: WHO; 2019.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/12900694/">Craig CL, et al. International Physical Activity Questionnaire: 12-country reliability and validity. Med Sci Sports Exerc 2003;35:1381-95.</a></li>
        <li><a href="https://sites.google.com/view/ipaq/score">IPAQ Research Committee. Guidelines for data processing and analysis of the IPAQ, short and long forms. November 2005.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/22018588/">Lee PH, et al. Validity of the International Physical Activity Questionnaire Short Form (IPAQ-SF): a systematic review. Int J Behav Nutr Phys Act 2011;8:115.</a></li>
      </ol>
    </div>
    <p class="disclaimer"><a href="/disclaimer/">Disclaimer</a></p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc { gap: 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  fieldset.q { border-top: 1px solid var(--line); padding-top: 1rem; }
  legend { font-weight: 650; margin-bottom: .35rem; padding: 0; }
  [hidden] { display: none !important; }
  .hint { margin: 0 0 .6rem; }
  .ask { margin: 0 0 .4rem; font-size: .92rem; font-weight: 550; color: var(--ink-2); }
  .intro { margin: 0; }
  .chips, .days { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chips label, .days label, .seg label, .tick { cursor: pointer; }
  .chips input, .days input, .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .chips span, .days span { display: block; padding: .45rem .85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font-weight: 550; transition: background .2s, color .2s, border-color .2s; }
  .days span { min-width: 2.6rem; text-align: center; padding-inline: .5rem; }
  .chips input:checked + span, .days input:checked + span { background: var(--brand-fill); border-color: var(--brand-fill); color: var(--brand-ink); }
  .chips input:focus-visible + span, .days input:focus-visible + span, .seg input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .seg { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg span { display: block; padding: .5rem 1.1rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .small-seg { margin-top: .7rem; } .small-seg span { padding: .3rem .8rem; font-size: .9rem; }
  .tick { display: flex; gap: .5rem; align-items: center; margin-top: .8rem; color: var(--ink-2); }
  .tick input { width: 1.1rem; height: 1.1rem; accent-color: var(--brand); }
  .row { display: flex; gap: .6rem; align-items: center; }
  .mins { margin-top: .7rem; flex-wrap: wrap; }
  .mins .ask { margin: 0; }
  .field { flex: 1; min-width: 9rem; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding-right: .9rem; transition: border-color .2s; }
  .field:focus-within { border-color: var(--brand); }
  .field input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 600 1.2rem var(--font-body); padding: .65rem .9rem; outline: none; }
  .field span { color: var(--ink-3); white-space: nowrap; }
  .results { display: grid; gap: 1.25rem; position: sticky; top: 84px; }
  @media (max-width: 820px) { .results { position: static; } }
  .big { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .big b { font: 600 3rem/1 var(--font-display); color: var(--ink); }
  .big span { color: var(--ink-3); font-size: .95rem; }
  .bar { position: relative; height: 12px; border-radius: 999px; background: var(--surface-2); margin-top: 1rem; }
  .fill { height: 100%; border-radius: 999px; background: var(--brand-fill); width: 0; transition: width .6s cubic-bezier(.2,.8,.2,1); }
  .bar i { position: absolute; top: -5px; width: 3px; height: 22px; border-radius: 2px; background: var(--ink); }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); }
  .checks { list-style: none; padding: 0; margin: .9rem 0 0; display: grid; gap: .6rem; }
  /* The checklist rows and IPAQ table rows are built by the script, so their styles must be global (scoped CSS never reaches them). */
  .checks :global(li) { display: grid; grid-template-columns: 1.6rem 1fr; gap: .15rem .5rem; align-items: start; }
  .checks :global(.mark) { grid-row: span 2; width: 1.4rem; height: 1.4rem; border-radius: 50%; display: grid; place-items: center; font-size: .8rem; font-weight: 700; border: 2px solid var(--line); color: var(--ink-3); }
  .checks :global(.met .mark) { background: var(--ok); border-color: var(--ok); color: var(--surface); }
  .checks :global(.not .mark) { border-color: var(--warn); color: var(--warn); }
  .checks :global(b) { font-weight: 600; }
  .checks :global(.met .st) { color: var(--ok); } .checks :global(.not .st) { color: var(--warn); }
  .checks :global(small) { color: var(--ink-2); font-size: .88rem; }
  details summary { cursor: pointer; font-weight: 600; margin-top: .6rem; color: var(--brand); }
  .ipaq-table { width: 100%; border-collapse: collapse; margin: .75rem 0; font-size: .9rem; }
  .ipaq-table th, .ipaq-table :global(td) { text-align: right; padding: .4rem .35rem; border-bottom: 1px solid var(--line); }
  .ipaq-table th:first-child, .ipaq-table :global(td:first-child) { text-align: left; }
  .ipaq-table :global(tr:last-child td) { font-weight: 650; border-bottom: 0; }
  #ipaq-notes { padding-left: 1.1rem; margin: .3rem 0 0; }
</style>

<script>
  import { usesIpaq, ipaqScore, whoAdult, whoTeen, whoYouth, whoUnder5, MET, type AgeGroup, type Bout, type WhoResult, type Check } from '../../lib/activity';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('act');
  const picked = (name: string) => (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value ?? null;
  const pickedNum = (name: string) => { const v = picked(name); return v == null ? null : Number(v); };
  const yes = (name: string) => { const v = picked(name); return v == null ? null : v === '1'; };
  const num = (id: string) => { const v = parseFloat($<HTMLInputElement>(id).value); return Number.isFinite(v) && v >= 0 ? v : null; };
  const fmt = (n: number) => Math.round(n).toLocaleString('en-IN');
  const LABEL: Record<AgeGroup, string> = { infant: 'under 1', toddler: '1–2 years', preschool: '3–4 years', child: '5–14 years', teen: '15–17 years', adult: '18–64 years', older: '65+ years' };

  /** Days chosen, and minutes once days are more than 0 (the minutes box shows only then). */
  function bout(id: string): Bout {
    const days = pickedNum(`${id}-d`);
    $(`${id}-m-row`).hidden = !days;
    return { days, minutes: days ? num(`${id}-m`) : null };
  }

  function setVerdict(el: HTMLElement, text: string, cls = '') { el.textContent = text; el.className = `verdict ${cls}`; }

  function renderWho(group: AgeGroup, r: WhoResult, pregnant: boolean) {
    $('who-title').textContent = `WHO targets, ${pregnant ? 'pregnancy and after birth' : LABEL[group]}`;
    const a = r.aerobic;
    $('who-big').hidden = group === 'infant' || group === 'toddler' || group === 'preschool';
    $('who-min').textContent = a ? fmt(a.minutes) : '—';
    $('who-unit').textContent = a ? a.unit : '';
    const bar = $('who-bar');
    bar.hidden = !a;
    if (a) {
      const top = Math.max((a.upper ?? a.target) * 1.5, a.minutes);
      $('who-fill').style.width = `${Math.min(a.minutes / top, 1) * 100}%`;
      $('who-t1').style.left = `calc(${(a.target / top) * 100}% - 1px)`;
      const t2 = $('who-t2');
      t2.hidden = !a.upper;
      if (a.upper) t2.style.left = `calc(${(a.upper / top) * 100}% - 1px)`;
    }
    const known = r.checks.filter((c) => c.status !== 'unknown');
    // The upper aerobic target is extra benefit, not a minimum: it is listed but not counted in the headline.
    const core = r.checks.filter((c) => c.id !== 'upper');
    const coreMet = core.filter((c) => c.status === 'met').length;
    const v = $('who-verdict');
    if (!known.length) setVerdict(v, 'Answer the questions to see your result.');
    else if (core.every((c) => c.status === 'met')) setVerdict(v, core.length === 1 ? 'Reached the WHO target' : `Reached all ${core.length} WHO targets`, 'ok');
    else if (core.some((c) => c.status === 'unknown')) setVerdict(v, `${coreMet} of ${core.length} WHO targets reached so far; answer the rest`);
    else setVerdict(v, `Reached ${coreMet} of ${core.length} WHO targets: not yet all`, 'warn');
    $('who-gap').textContent = a?.gap ? `To reach the minimum: ${a.gap}` : '';
    $('who-checks').replaceChildren(...r.checks.map(checkItem));
    $('who-notes').textContent = r.notes.join(' ');
  }

  function checkItem(c: Check) {
    const li = document.createElement('li');
    li.className = c.status;
    const mark = document.createElement('span');
    mark.className = 'mark'; mark.setAttribute('aria-hidden', 'true');
    mark.textContent = c.status === 'met' ? '✓' : c.status === 'not' ? '•' : '';
    const head = document.createElement('span');
    const b = document.createElement('b'); b.textContent = c.label;
    const st = document.createElement('span'); st.className = 'st';
    st.textContent = c.status === 'met' ? ' · Reached' : c.status === 'not' ? ' · Not yet' : '';
    head.append(b, st);
    const small = document.createElement('small'); small.textContent = c.detail;
    li.append(mark, head, small);
    return li;
  }

  function renderIpaq(group: AgeGroup, a: { vigorous: Bout; moderate: Bout; walking: Bout }, pregnant: boolean) {
    const r = ipaqScore(a);
    const v = $('ipaq-verdict');
    const rows = $('ipaq-rows');
    $('ipaq-details').hidden = !r.ok;
    if (!r.ok) {
      $('ipaq-level').textContent = '—'; $('ipaq-met').textContent = '';
      setVerdict(v, r.reason === 'over16h' ? 'Your answers add up to more than 16 hours a day. Please check them.' : 'Answer the three activity questions.', r.reason === 'over16h' ? 'warn' : '');
      rows.replaceChildren(); $('ipaq-notes').replaceChildren();
    } else {
      $('ipaq-level').textContent = r.level[0].toUpperCase() + r.level.slice(1);
      $('ipaq-met').textContent = `${fmt(r.total)} MET-min/week`;
      setVerdict(v, `IPAQ level: ${r.reason}`);
      const line = (name: string, p: { days: number; minutes: number; met: number }, m: number) => {
        const tr = document.createElement('tr');
        for (const t of [name, String(p.days), String(p.minutes), String(m), fmt(p.met)]) { const td = document.createElement('td'); td.textContent = t; tr.append(td); }
        return tr;
      };
      const total = document.createElement('tr');
      for (const t of ['Total', '', '', '', fmt(r.total)]) { const td = document.createElement('td'); td.textContent = t; total.append(td); }
      rows.replaceChildren(line('Vigorous', r.vigorous, MET.vigorous), line('Moderate', r.moderate, MET.moderate), line('Walking', r.walking, MET.walking), total);
      const notes = [...r.notes, 'Low, Moderate and High are the IPAQ categories; they are not the same as the WHO targets above.'];
      $('ipaq-notes').replaceChildren(...notes.map((n) => { const li = document.createElement('li'); li.textContent = n; return li; }));
    }
    const valid: string[] = [];
    if (group === 'older') valid.push('IPAQ was tested in people aged 15 to 69; from 70 years read the IPAQ level with caution.');
    if (pregnant) valid.push('IPAQ has not been tested in pregnancy; read the IPAQ level with caution.');
    $('ipaq-valid').textContent = valid.join(' ');
  }

  function update() {
    const group = picked('age') as AgeGroup;
    for (const el of form.querySelectorAll<HTMLElement>('[data-show]')) el.hidden = !el.dataset.show!.split(' ').includes(group);
    const pregnant = group === 'adult' && $<HTMLInputElement>('preg').checked;
    $('ipaq-card').hidden = !usesIpaq(group);
    const sed = $('sedentary');
    sed.textContent = '';

    if (usesIpaq(group)) {
      const a = { vigorous: bout('vig'), moderate: bout('mod'), walking: bout('walk') };
      const strengthDays = pickedNum('str-d');
      const r = group === 'teen' ? whoTeen({ ...a, strengthDays })
        : whoAdult(group as 'adult' | 'older', { ...a, strengthDays, balanceDays: pickedNum('bal-d'), pregnant });
      renderWho(group, r, pregnant);
      renderIpaq(group, a, pregnant);
      const sit = num('sit');
      if (sit != null) sed.textContent = `Sitting: about ${sit} hours on a weekday (not part of either score). WHO sets no number of hours, but asks everyone to sit less and replace some sitting with activity of any intensity.`;
    } else if (group === 'child') {
      const m = bout('cm');
      const week = m.days === 0 ? 0 : m.days && m.minutes != null ? m.days * m.minutes : null;
      renderWho(group, whoYouth({ mvpaWeekMin: week, vigorousDays: pickedNum('cv-d'), strengthDays: pickedNum('str-d') }), false);
      const scr = num('cscreen');
      if (scr != null) sed.textContent = `Screen time for fun: about ${scr} hours a day. WHO sets no number for this age, but asks to limit it.`;
    } else {
      const mobile = yes('mobile');
      $('tummy-q').hidden = group !== 'infant' || mobile !== false;
      $('play-q').hidden = group !== 'infant' || mobile !== true;
      const older = group === 'infant' ? picked('inf') === '1' : picked('tod') === '1';
      renderWho(group, whoUnder5(group as 'infant' | 'toddler' | 'preschool', {
        older, mobile, tummyMin: num('tummy'), floorPlay: yes('play'), activeMin: num('active'), mvpaMin: num('mvpa'),
        restrained: yes('restr'), screenMin: num('u5screen'), sleepH: num('sleep'),
      }), false);
    }
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
