---
import Sources from '../../components/Sources.astro';
import Base from '../../layouts/Base.astro';
import UnitField from '../../components/UnitField.astro';
import { SITE } from '../../consts';
import T from '../../components/T.astro';
import ClientWords from '../../components/ClientWords.astro';
import { inLang, langOf } from '../../i18n/languages';
import { localHref } from '../../i18n/routes';
import { useT } from '../../i18n/t';

// Also /<lang>/tools/indian-diabetes-risk-score/: the page through the dictionary (t, <T>), the results through w() (src/i18n/client.ts).
const lang = langOf(Astro.url.pathname);
const t = useT(Astro.url.pathname);
const L = (href: string) => localHref(lang, href);

const url = `${SITE.url}${inLang(lang, '/tools/indian-diabetes-risk-score/')}`;
const faq = [
  { q: 'What is the Indian Diabetes Risk Score?', a: 'A four-question score made by the Madras Diabetes Research Foundation (Mohan and colleagues, 2005) from the Chennai Urban Rural Epidemiology Study. It adds points for age, waist, physical activity and diabetes in your parents, out of 100, to find adults who may have type 2 diabetes without knowing it.' },
  { q: 'What is a high IDRS score?', a: '60 or more is high risk, 30 to 50 moderate and below 30 low. In the original study a score of 60 or more picked up about 7 in 10 people with undiagnosed diabetes.' },
  { q: 'Does a low score mean I do not have diabetes?', a: 'No. The score only estimates risk; it misses some people who do have diabetes. Only a blood test (fasting glucose, HbA1c or a glucose tolerance test) can tell. If you have symptoms such as thirst, passing a lot of urine or weight loss, get tested whatever your score.' },
  { q: 'Which parts of the score can I change?', a: 'Waist and physical activity: together up to 50 of the 100 points. Age and family history cannot change.' },
].map((f) => ({ q: t(f.q), a: t(f.a) }));
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: t('Indian Diabetes Risk Score (IDRS) calculator'),
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: t('Calculates the MDRF Indian Diabetes Risk Score from age, waist, physical activity and family history. Nothing you type leaves your device.'),
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={t('Indian Diabetes Risk Score (IDRS) calculator')} description={t('Four questions — age, waist, activity and family history — that estimate your risk of type 2 diabetes, using the Indian Diabetes Risk Score. Runs in your browser; nothing is stored.')} jsonld={jsonld}>
  <ClientWords sources={['/src/pages/tools/indian-diabetes-risk-score.astro', '/src/lib/idrs.ts']} />
  <header class="page-head wrap">
    <span class="eyebrow">{t('Tools')}</span>
    <h1>{t('Indian Diabetes Risk Score')}</h1>
    <p><T>Four questions, made for <b>Indian adults</b>, that estimate whether you could have type 2 diabetes without knowing it. Everything is calculated on your device; nothing you type is sent or stored.</T></p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="idrs" novalidate>
      <fieldset>
        <legend>{t('1. Your age')}</legend>
        <div class="row"><label class="field"><input type="number" data-unitless inputmode="numeric" id="age" min="18" max="110" placeholder="42" aria-label={t('Age in years')} /><span>{t('years')}</span></label></div>
      </fieldset>

      <fieldset>
        <legend>{t('2. Waist')}</legend>
        <div class="seg small-seg">
          <label><input type="radio" name="sex" value="m" checked /> <span>{t('Man')}</span></label>
          <label><input type="radio" name="sex" value="f" /> <span>{t('Woman')}</span></label>
        </div>
        <div class="row"><UnitField id="waist" kind="length" label={t('Waist')} placeholder={88} /></div>
        <p class="small muted" style="margin:.5rem 0 0">{t('Midway between the lowest rib and the top of the hip bone, after breathing out. Tap the unit to switch between cm and inches.')}</p>
      </fieldset>

      <fieldset>
        <legend>{t('3. Physical activity')}</legend>
        <div class="choices">
          <label><input type="radio" name="act" value="vigorous" /> <span><b>{t('Vigorous')}</b><small>{t('Regular vigorous exercise, or strenuous (manual) work at home or at work.')}</small></span></label>
          <label><input type="radio" name="act" value="moderate" /> <span><b>{t('Moderate')}</b><small>{t('Regular moderate exercise, or moderate physical activity at home or at work.')}</small></span></label>
          <label><input type="radio" name="act" value="mild" /> <span><b>{t('Mild')}</b><small>{t('Regular mild exercise, or mild physical activity at home or at work.')}</small></span></label>
          <label><input type="radio" name="act" value="none" /> <span><b>{t('None')}</b><small>{t('No exercise, and sitting (sedentary) activities at home and at work.')}</small></span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>{t('4. Parents with diabetes')}</legend>
        <div class="choices">
          <label><input type="radio" name="fam" value="none" /> <span><b>{t('Neither parent')}</b></span></label>
          <label><input type="radio" name="fam" value="one" /> <span><b>{t('One parent')}</b></span></label>
          <label><input type="radio" name="fam" value="both" /> <span><b>{t('Both parents')}</b></span></label>
        </div>
      </fieldset>
      <p class="small muted" style="margin:0">{t('For adults who have not been told they have diabetes. Not valid in pregnancy.')}</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result">
        <span class="eyebrow">{t('Your score')}</span>
        <div class="big"><b id="score">—</b><span>{t('out of 100')}</span></div>
        <div class="scale" aria-hidden="true">
          <div class="band ok"></div><div class="band warn"></div><div class="band risk"></div>
          <div class="marker" id="marker"></div>
        </div>
        <div class="scale-labels" aria-hidden="true"><span>30</span><span>60</span></div>
        <p class="verdict" id="verdict">{t('Answer the four questions.')}</p>
        <p class="small" id="advice"></p>
        <table class="parts" id="parts" hidden>
          <tbody>
            <tr><td>{t('Age')}</td><td id="p-age"></td></tr>
            <tr><td>{t('Waist')}</td><td id="p-waist"></td></tr>
            <tr><td>{t('Physical activity')}</td><td id="p-activity"></td></tr>
            <tr><td>{t('Parents with diabetes')}</td><td id="p-family"></td></tr>
          </tbody>
        </table>
        <p class="small muted" id="changeable"></p>
      </div>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>{t('How is the score worked out?')}</h2>
    <table>
      <thead><tr><th>{t('Question')}</th><th>{t('Answer')}</th><th>{t('Points')}</th></tr></thead>
      <tbody>
        <tr><td rowspan="3">{t('Age')}</td><td>{t('Under 35')}</td><td>0</td></tr>
        <tr><td>35 – 49</td><td>20</td></tr>
        <tr><td>{t('50 or more')}</td><td>30</td></tr>
        <tr><td rowspan="3">{t('Waist')}</td><td>{t('Women under 80 cm, men under 90 cm')}</td><td>0</td></tr>
        <tr><td>{t('Women 80 – 89 cm, men 90 – 99 cm')}</td><td>10</td></tr>
        <tr><td>{t('Women 90 cm or more, men 100 cm or more')}</td><td>20</td></tr>
        <tr><td rowspan="4">{t('Physical activity')}</td><td>{t('Vigorous: regular vigorous exercise or strenuous (manual) work at home or work')}</td><td>0</td></tr>
        <tr><td>{t('Moderate: regular moderate exercise or moderate activity at home or work')}</td><td>10</td></tr>
        <tr><td>{t('Mild: regular mild exercise or mild activity at home or work')}</td><td>20</td></tr>
        <tr><td>{t('None: no exercise, sedentary at home and work')}</td><td>30</td></tr>
        <tr><td rowspan="3">{t('Parents with diabetes')}</td><td>{t('Neither')}</td><td>0</td></tr>
        <tr><td>{t('One')}</td><td>10</td></tr>
        <tr><td>{t('Both')}</td><td>20</td></tr>
      </tbody>
    </table>
    <p>{t('Total below 30: low risk. 30 to 50: moderate. 60 or more: high risk.')}</p>

    <h2>{t('How good is it?')}</h2>
    <p>{t('In the study that built it (2,350 adults in Chennai), a score of 60 or more found 72.5% of the people who had undiagnosed diabetes (sensitivity) and correctly cleared 60.1% of those who did not (specificity). Of the people scoring 60 or more, about 1 in 6 actually had diabetes; of those below 60, about 95 in 100 did not. It is a cheap first sieve that tells you who should have a blood test, not a test itself. Later studies in Mangalore and Lucknow found it worked in their populations too.')}</p>
    <p><T>Want to check your BMI and waist-to-height ratio as well? Use the <a href="/tools/bmi-calculator/">BMI & waist calculator</a>.</T></p>

    <div class="faq">
      <h2>{t('Common questions')}</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
    <Sources label={t('Sources')}>
      <ol lang="en">
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/16334618/">Mohan V, Deepa R, Deepa M, Somannavar S, Datta M. A simplified Indian Diabetes Risk Score for screening for undiagnosed diabetic subjects. J Assoc Physicians India 2005;53:759-63.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/21121209/">Adhikari P, Pathak R, Kotian S. Validation of the MDRF-Indian Diabetes Risk Score (IDRS) in another south Indian population through the Boloor Diabetes Study. J Assoc Physicians India 2010;58:434-6.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/29302549/">Khan MM, et al. Validity of Indian Diabetes Risk Score and its association with body mass index and glycosylated hemoglobin for screening of diabetes in and around areas of Lucknow. J Family Med Prim Care 2017;6:366-73.</a></li>
      </ol>
    </Sources>
    <p class="disclaimer"><a href={L('/disclaimer/')}>{t('Disclaimer')}</a></p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc { gap: 1.25rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .seg { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg label { cursor: pointer; }
  .seg input, .choices input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: .3rem .9rem; font-size: .9rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .seg input:focus-visible + span, .choices input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .small-seg { margin-bottom: .6rem; }
  .choices { display: grid; gap: .5rem; }
  .choices label { cursor: pointer; }
  .choices span { display: block; border: 1px solid var(--line); border-radius: 12px; padding: .65rem .9rem; background: var(--surface); transition: border-color .2s, background .2s; }
  .choices b { font-weight: 600; color: var(--ink); }
  .choices small { display: block; color: var(--ink-3); font-size: .85rem; margin-top: .15rem; }
  .choices input:checked + span { border-color: var(--brand); background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--brand); }
  .row { display: flex; gap: .6rem; }
  .field { flex: 1; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding-inline-end: .9rem; transition: border-color .2s; }
  .field:focus-within { border-color: var(--brand); }
  .field input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 600 1.25rem var(--font-body); padding: .75rem .9rem; outline: none; }
  .field span { color: var(--ink-3); }
  .results { position: sticky; top: calc(var(--nav-space, 84px) + .5rem); }
  @media (max-width: 820px) { .results { position: static; } }
  .big { display: flex; align-items: baseline; gap: .5rem; }
  .big b { font: 600 3.2rem/1 var(--font-display); color: var(--ink); }
  .big span { color: var(--ink-3); }
  /* 0-100 scale: low 0-29, moderate 30-59, high 60-100 */
  .scale { position: relative; display: grid; grid-template-columns: 30fr 30fr 40fr; height: 12px; margin-top: 1rem; }
  .band.ok { background: var(--ok); border-radius: 999px 0 0 999px; } .band.warn { background: var(--warn); } .band.risk { background: var(--risk); border-radius: 0 999px 999px 0; }
  .marker { position: absolute; top: -6px; width: 4px; height: 24px; background: var(--ink); border-radius: 2px; left: 0; opacity: 0; transition: left .6s cubic-bezier(.2,.8,.2,1), opacity .3s; }
  @media (prefers-reduced-motion: reduce) { .marker { transition: none; } }
  .scale-labels { position: relative; height: 1.2rem; font-size: .75rem; color: var(--ink-3); }
  .scale-labels span { position: absolute; transform: translateX(-50%); }
  .scale-labels span:nth-child(1) { left: 30%; } .scale-labels span:nth-child(2) { left: 60%; }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); } .verdict.risk { background: var(--risk-soft); color: var(--risk); }
  .parts { width: 100%; border-collapse: collapse; margin: .75rem 0 .25rem; font-size: .95rem; }
  .parts[hidden] { display: none; }
  .parts td { padding: .35rem 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .parts td:last-child { text-align: end; font-weight: 600; color: var(--ink); white-space: nowrap; }
</style>

<script>
  import { unitValue } from '../../scripts/unit-fields';
  import { idrs, type Activity, type Family, type Sex } from '../../lib/idrs';
  import { w } from '../../i18n/client';

  const $ = (id: string) => document.getElementById(id)!;
  const form = $('idrs') as HTMLFormElement;
  const picked = (name: string) => (form.querySelector(`input[name=${name}]:checked`) as HTMLInputElement | null)?.value;
  const num = (id: string) => parseFloat(($(id) as HTMLInputElement).value);

  const VERDICT = {
    low: [w('Low risk (below 30)'), 'ok', w('Keep your waist and activity where they are. A low score does not rule diabetes out: if you have thirst, pass a lot of urine or lose weight without trying, get a blood test.')],
    moderate: [w('Moderate risk (30 to 50)'), 'warn', w('Worth a blood test for diabetes (fasting glucose or HbA1c) at your next check-up, and worth bringing your waist down and moving more.')],
    high: [w('High risk (60 or more)'), 'risk', w('Please get a blood test for diabetes soon: ask a doctor for a fasting glucose or HbA1c. Many people at this score already have diabetes without symptoms.')],
  } as const;

  function update() {
    const age = num('age'), waist = unitValue('waist');
    const sex = picked('sex') as Sex, activity = picked('act') as Activity | undefined, family = picked('fam') as Family | undefined;
    const ready = age >= 18 && age <= 110 && waist >= 40 && waist <= 200 && activity && family;
    const verdict = $('verdict'), parts = $('parts');
    if (!ready) {
      $('score').textContent = '—'; $('marker').style.opacity = '0';
      const left = [!(age >= 18 && age <= 110) && w('age'), !(waist >= 40 && waist <= 200) && w('waist'), !activity && w('activity'), !family && w('parents')].filter(Boolean);
      verdict.textContent = age > 0 && age < 18 ? w('This score is for adults (18 and over).') : w('Still to answer: {list}.', { list: left.join(', ') });
      verdict.className = 'verdict';
      $('advice').textContent = ''; $('changeable').textContent = ''; parts.hidden = true;
      return;
    }
    const r = idrs({ age, sex, waist, activity, family });
    $('score').textContent = String(r.score);
    $('marker').style.left = `calc(${r.score}% - 2px)`; $('marker').style.opacity = '1';
    const [text, cls, advice] = VERDICT[r.band];
    verdict.textContent = text; verdict.className = `verdict ${cls}`;
    $('advice').textContent = advice;
    for (const k of ['age', 'waist', 'activity', 'family'] as const) $(`p-${k}`).textContent = w('{points} pts', { points: r.parts[k] });
    parts.hidden = false;
    $('changeable').textContent = r.changeable
      ? w('{changeable} of your {score} points come from waist and activity, the two you can change.', { changeable: r.changeable, score: r.score })
      : w('Your waist and activity add no points: the score comes only from age and family history, which cannot change.');
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
