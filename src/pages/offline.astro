---
// Shown by the app's service worker (scripts/pwa/sw.js) when there is no internet and the page asked for is not on this
// device; also /<lang>/offline/ for pages in that language. Lists what Settings keep on the device. Not in the sitemap.
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import ClientWords from '../components/ClientWords.astro';
import { useT } from '../i18n/t';
import { localHref } from '../i18n/routes';
import { langOf } from '../i18n/languages';

const path = Astro.url.pathname;
const t = useT(path);
const L = (href: string) => localHref(langOf(path), href);
---
<Base title={t('Offline')} description={t('You are offline. What this device keeps still works: guides, calculators, trackers, recent blog posts, and the books and trainers you saved.')} noindex>
  <div class="prose-wrap prose" style="padding-block:3rem 4rem">
    <h1>{t('You are offline')}</h1>
    <p>{t('This page is not on this device yet. These are, and work without internet:')}</p>
    <div id="off-saved"><p class="muted">{t('Nothing is kept on this device yet.')}</p></div>
    <p class="muted small"><T><b>Videos</b> need internet.</T></p>
    <p style="margin-top:2rem"><a class="btn btn-ghost" href="" id="off-retry">{t('Try again')}</a> <a class="btn btn-ghost" href={L('/settings/')}>{t('Settings')}</a></p>
  </div>
  <ClientWords sources={['/src/pages/offline.astro']} />
</Base>

<script>
  import { savedPacks } from '../pwa/packs';
  import { LANG, type Lang } from '../i18n/languages';
  import { w } from '../i18n/client';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  (document.getElementById('off-retry') as HTMLAnchorElement).href = location.href;
  const langOfPack = (id: string) => (id.match(/-([a-z]{2})$/)?.[1] ?? 'en') as Lang;
  // What each kept pack is called (Settings uses the same words).
  const KIND: Record<string, string> = {
    base: w('Home and menu pages'), guides: w('Guides'), tools: w('Calculators and tools'), trackers: w('Trackers'),
    evidence: w('Evidence for doctors'), blog: w('Blog posts from the last 6 months'),
  };
  const name = (p: { id: string; kind: string; title: string }) => {
    const lang = LANG[langOfPack(p.id)];
    if (KIND[p.kind]) return `${KIND[p.kind]} · <span lang="${lang.html}">${lang.name}</span>`;
    return `<span lang="en">${esc(p.title)}</span>`;
  };

  if ('caches' in window) {
    const saved = await savedPacks().catch(() => []);
    if (saved.length) {
      document.getElementById('off-saved')!.innerHTML = `<ul>${saved.map((p) =>
        `<li><a href="${esc(p.open)}">${name(p)}</a>${p.done ? '' : ` <span class="muted small">${w('(partly saved)')}</span>`}</li>`).join('')}</ul>`;
    }
  }
</script>
