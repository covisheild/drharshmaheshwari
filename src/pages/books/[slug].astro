---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { books, fmtDate } from '../../lib/content';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  return (await books()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = `${SITE.url}/books/${entry.id}/`;
const pdfUrl = d.pdf.startsWith('http') ? d.pdf : new URL(d.pdf, SITE.url).href;
// "CC BY-NC-SA 4.0" -> https://creativecommons.org/licenses/by-nc-sa/4.0/
const cc = d.license.match(/^CC ([A-Z-]+) (\d\.\d)$/);
const licenseUrl = cc ? `https://creativecommons.org/licenses/${cc[1].toLowerCase()}/${cc[2]}/` : undefined;
const LICENSE_TERMS: Record<string, string> = {
  'BY-NC-SA': 'free to copy, share and adapt for non-commercial use, with credit, under the same licence',
  'BY-NC-ND': 'free to copy and share with credit, not for sale or modification',
  'BY-NC': 'free to copy, share and adapt for non-commercial use, with credit',
  'BY': 'free to copy, share and adapt, with credit',
};
const licenseTerms = cc ? LICENSE_TERMS[cc[1]] : undefined;
const jsonld = [{
  '@type': 'Book', '@id': `${url}#book`, name: d.title, alternativeHeadline: d.subtitle, description: d.description, url,
  author: { '@id': `${SITE.url}/#person` }, datePublished: d.published.toISOString().slice(0, 10), inLanguage: 'en-IN',
  numberOfPages: d.pages, isAccessibleForFree: true, license: licenseUrl,
  audience: { '@type': 'Audience', audienceType: d.audience }, bookFormat: 'https://schema.org/EBook',
  encoding: { '@type': 'MediaObject', contentUrl: pdfUrl, encodingFormat: 'application/pdf' },
}];
---
<Base title={d.title} description={d.description} jsonld={jsonld} noindex={d.draft}>
  <article class="prose-wrap" style="padding-block:3rem 4rem">
    {d.draft && <p class="draft-banner"><b>Draft under review.</b> Visible only on the preview site.</p>}
    <a class="eyebrow" href="/books/" style="text-decoration:none">Free book</a>
    <h1>{d.title}</h1>
    {d.subtitle && <p class="desc muted" style="font-size:1.2rem">{d.subtitle}</p>}
    <div class="meta" style="margin-bottom:1.5rem"><span>{fmtDate(d.published)}</span>{d.pages && <span>{d.pages} pages</span>}<span>For: {d.audience}</span><span>{d.license}</span></div>
    {d.cover && <img src={d.cover} alt={`Cover of ${d.title}`} width="300" height="400" style="width:min(220px,55%);height:auto;border-radius:10px;box-shadow:var(--shadow);margin:0 0 1.5rem" />}
    <a class="btn btn-primary" href={d.pdf} rel="noopener">Download free PDF{d.size && ` (${d.size})`} <span class="arrow">↓</span></a>
    <div class="prose" style="margin-top:2rem"><Content /></div>
    {d.contents.length > 0 && <><h2>Contents</h2><ol>{d.contents.map((c) => <li>{c}</li>)}</ol></>}
    <p class="disclaimer">Shared under {licenseUrl ? <a href={licenseUrl}>{d.license}</a> : d.license}{licenseTerms && `: ${licenseTerms}`}. Educational, not personal medical advice.</p>
  </article>
</Base>
