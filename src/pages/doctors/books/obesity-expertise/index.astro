---
// The Obesity Expertise series: 196 books planned, shown without overwhelming anyone. At most three rows:
// Continue reading (only with progress), The path (released books in build order, then one faint "Next"; a
// "Subject" dropdown beside it shows any subject's books), Up next for you (books whose prerequisites you have
// finished). One cover per subject. Subjects are numbered 0, 1, 2... in the order the series builds them; the
// number is also the "Book N" on the subject's Rung 1 cover.
import Base from '../../../../layouts/Base.astro';
import SubjectCard from '../../../../components/books/SubjectCard.astro';
import SubjectFinder from '../../../../components/books/SubjectFinder.astro';
import Cover from '../../../../components/books/Cover.astro';
import { obesityBooks, series, SERIES_URL } from '../../../../lib/obesity-books';
import type { SeriesBook } from '../../../../reader/types';
import { SITE } from '../../../../consts';

const released = new Set(obesityBooks.map((b) => b.id));
const total = series.books.length;
const subjectKey = (b: SeriesBook) => b.subject ?? b.id;

// Every subject's rungs, in rung order.
const subjects = new Map<string, SeriesBook[]>();
for (const b of series.books) {
  const k = subjectKey(b);
  subjects.set(k, [...(subjects.get(k) ?? []), b]);
}
for (const rungs of subjects.values()) rungs.sort((a, b) => a.id.localeCompare(b.id));

// The path: subjects in the order their first released rung appears in the build order.
const pathSubjects: string[] = [];
for (const b of series.books) if (released.has(b.id) && !pathSubjects.includes(subjectKey(b))) pathSubjects.push(subjectKey(b));
const next = series.books.find((b) => !released.has(b.id));

// The "Find a subject" list: every subject, in the order the series plans them (series.json order).
const subjectName = (rungs: SeriesBook[]) => rungs[0].title.replace(/\s*·\s*Rung \d$/, '');
const finderSubjects = [...subjects].map(([key, rungs], n) => ({
  key, n, name: subjectName(rungs), total: rungs.length, out: rungs.filter((r) => released.has(r.id)).length,
}));
const subjectNo = new Map(finderSubjects.map((f) => [f.key, f.n]));
const rungOf = (b: SeriesBook) => b.id.match(/-R(\d)$/)?.[1];

// What the browser needs for the two rows that depend on this reader's own progress.
const client = obesityBooks.map((b) => ({
  id: b.id, url: b.url, number: b.number, title: b.title, hue: b.hue, requires: b.requires,
  sections: Object.fromEntries(b.outline.flatMap((p) => p.sections.map((s) => [s.id, s.label]))),
  count: b.outline.reduce((n, p) => n + p.sections.length, 0),
}));
const description = `Obesity Expertise: a first-principles curriculum for doctors in ${total} books. ${released.size} are out, to read online or download.`;
const jsonld = [{ '@type': 'BookSeries', name: series.title, description: series.subtitle, url: `${SITE.url}${SERIES_URL}`, author: { '@id': `${SITE.url}/#person` },
  hasPart: obesityBooks.map((b) => ({ '@type': 'Book', name: `Book ${b.number} · ${b.title}`, url: `${SITE.url}${b.url}` })) }];
---
<Base title={series.title} description={description} jsonld={jsonld}>
  <header class="page-head wrap">
    <a class="eyebrow" href="/doctors/books/" style="text-decoration:none">Books</a>
    <h1>{series.title}</h1>
    <p>{series.subtitle}. Each book builds on the ones before it, and each can be read here or downloaded as a PDF.</p>
    <p class="series-count"><b>{released.size} of {total}</b> out · <a href={`${SERIES_URL}b0/`}>Start with Book 0</a></p>
  </header>

  <div class="wrap series">
    <section class="row" id="continue" hidden aria-labelledby="h-continue">
      <h2 id="h-continue">Continue reading</h2>
      <div class="shelf" id="continue-shelf"></div>
    </section>

    <section class="row" aria-labelledby="h-path">
      <div class="row-head">
        <div>
          <h2 id="h-path">The path</h2>
          <p class="row-note" id="path-note">The released books, in the order the series builds them.</p>
        </div>
        <SubjectFinder subjects={finderSubjects} />
      </div>
      <div class="shelf" id="path-shelf">
        {pathSubjects.map((s) => <SubjectCard rungs={subjects.get(s)!} released={released} />)}
        {next && (
          <div class="next-card">
            <SubjectCard rungs={[next]} released={released} faint />
            <p class="next-label">Next · coming</p>
          </div>
        )}
      </div>
      {[...subjects].map(([key, rungs]) => (
        <div class="subject-panel" data-key={key} hidden>
          <p class="sp-head"><b>{subjectNo.get(key)}</b> · {subjectName(rungs)}</p>
          <div class="sp-books">
            {rungs.map((r) => (
              <div class="sp-book">
                {released.has(r.id)
                  ? <a class="sp-cover" href={`${SERIES_URL}${r.slug}/`} aria-label={`Book ${r.number}: ${r.title}`}><Cover hue={r.hue ?? 200} number={r.number} title={r.title} level={r.level} size="md" /></a>
                  : <span class="sp-cover"><Cover hue={r.hue ?? 200} number={r.number} title={r.title} level={r.level} size="md" faint /></span>}
                <p class="sp-label"><b>{rungOf(r) ? `Rung ${rungOf(r)}` : `Book ${r.number}`}</b><span>{r.level}</span></p>
                <p class="sp-state">{released.has(r.id) ? 'Out' : 'Coming'}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="row" id="upnext" hidden aria-labelledby="h-upnext">
      <h2 id="h-upnext">Up next for you</h2>
      <p class="row-note">Books whose earlier books you have finished.</p>
      <div class="shelf" id="upnext-shelf"></div>
    </section>

  </div>
  <script id="series-data" type="application/json" set:html={JSON.stringify(client)} />
</Base>

<script>
  import { mountSeries } from '../../../../reader/series';
  import { mountFinder } from '../../../../reader/finder';
  mountSeries();
  mountFinder();
</script>

<style>
  .series-count { font-size: .95rem; }
  .series { padding-bottom: 4rem; }
  .series section.row { margin-top: 2rem; padding-block: 0; }
  .row h2 { font-size: 1.15rem; margin: 0 0 .25rem; }
  .row-note { margin: 0 0 .75rem; font-size: .88rem; color: var(--ink-3); }
  .row-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: .5rem 1rem; }
  .row-head .row-note { margin-bottom: 0; }
  .subject-panel { padding: .75rem 2px 1rem; }
  .sp-head { margin: 0 0 1rem; font-size: 1rem; }
  .sp-books { display: flex; flex-wrap: wrap; gap: 1.5rem 1.4rem; }
  .sp-book { width: 140px; }
  .sp-cover { display: block; border-radius: 8px; text-decoration: none; }
  a.sp-cover:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }
  .sp-label { margin: .55rem 0 .1rem; font-size: .84rem; color: var(--ink); }
  .sp-label b, .sp-label span { display: block; }
  .sp-label span { color: var(--ink-2); }
  .sp-state { margin: 0; font-size: .78rem; color: var(--ink-3); }
  .shelf { display: flex; gap: 1.1rem; overflow-x: auto; padding: .5rem 2px 1rem; scroll-snap-type: x proximity; overscroll-behavior-x: contain; }
  .shelf[hidden] { display: none; }
  .next-card { position: relative; }
  .next-label { margin: 0; font-size: .78rem; color: var(--ink-3); }
</style>
