---
// The Obesity Expertise series: 196 books planned, shown without overwhelming anyone. At most four rows:
// Continue reading (only with progress), The path (released books in build order, then one faint "Next"),
// Up next for you (books whose prerequisites you have finished), Browse by Part (18 chips). One cover per
// subject; a Part gets its own shelf only once it has three or more released subjects.
import Base from '../../../../layouts/Base.astro';
import SubjectCard from '../../../../components/books/SubjectCard.astro';
import { obesityBooks, series, SERIES_URL } from '../../../../lib/obesity-books';
import type { SeriesBook } from '../../../../reader/types';
import { SITE } from '../../../../consts';

const released = new Set(obesityBooks.map((b) => b.id));
const total = series.books.length;
const subjectKey = (b: SeriesBook) => b.subject ?? b.id;

// Every subject's rungs, in rung order.
const subjects = new Map<string, SeriesBook[]>();
for (const b of series.books) {
  const k = subjectKey(b);
  subjects.set(k, [...(subjects.get(k) ?? []), b]);
}
for (const rungs of subjects.values()) rungs.sort((a, b) => a.id.localeCompare(b.id));

// The path: subjects in the order their first released rung appears in the build order.
const pathSubjects: string[] = [];
for (const b of series.books) if (released.has(b.id) && !pathSubjects.includes(subjectKey(b))) pathSubjects.push(subjectKey(b));
const next = series.books.find((b) => !released.has(b.id));

// Parts (Book 0 is not a Part), in the order they first appear in the series.
const parts: { name: string; hue: number; subjects: string[]; released: number }[] = [];
for (const b of series.books) {
  if (b.part === 'Book 0') continue;
  let p = parts.find((x) => x.name === b.part);
  if (!p) { p = { name: b.part, hue: series.hues[b.part] ?? 200, subjects: [], released: 0 }; parts.push(p); }
  if (!p.subjects.includes(subjectKey(b))) p.subjects.push(subjectKey(b));
}
for (const p of parts) p.released = p.subjects.filter((s) => subjects.get(s)!.some((r) => released.has(r.id))).length;
const shelves = parts.filter((p) => p.released >= 3);

// What the browser needs for the two rows that depend on this reader's own progress.
const client = obesityBooks.map((b) => ({
  id: b.id, url: b.url, number: b.number, title: b.title, hue: b.hue, requires: b.requires,
  sections: Object.fromEntries(b.outline.flatMap((p) => p.sections.map((s) => [s.id, s.label]))),
  count: b.outline.reduce((n, p) => n + p.sections.length, 0),
}));
const description = `Obesity Expertise: a first-principles curriculum for doctors in ${total} books. ${released.size} are out, free to read online or download.`;
const jsonld = [{ '@type': 'BookSeries', name: series.title, description: series.subtitle, url: `${SITE.url}${SERIES_URL}`, author: { '@id': `${SITE.url}/#person` },
  hasPart: obesityBooks.map((b) => ({ '@type': 'Book', name: `Book ${b.number} · ${b.title}`, url: `${SITE.url}${b.url}` })) }];
---
<Base title={series.title} description={description} jsonld={jsonld}>
  <header class="page-head wrap">
    <a class="eyebrow" href="/doctors/books/" style="text-decoration:none">Books</a>
    <h1>{series.title}</h1>
    <p>{series.subtitle}. Each book builds on the ones before it, and each is free to read here or to download as a PDF.</p>
    <p class="series-count"><b>{released.size} of {total}</b> out · <a href={`${SERIES_URL}b0/`}>Start with Book 0</a></p>
  </header>

  <div class="wrap series">
    <section class="row" id="continue" hidden aria-labelledby="h-continue">
      <h2 id="h-continue">Continue reading</h2>
      <div class="shelf" id="continue-shelf"></div>
    </section>

    <section class="row" aria-labelledby="h-path">
      <h2 id="h-path">The path</h2>
      <p class="row-note">The released books, in the order the series builds them.</p>
      <div class="shelf">
        {pathSubjects.map((s) => <SubjectCard rungs={subjects.get(s)!} released={released} />)}
        {next && (
          <div class="next-card">
            <SubjectCard rungs={[next]} released={released} faint />
            <p class="next-label">Next · coming</p>
          </div>
        )}
      </div>
    </section>

    <section class="row" id="upnext" hidden aria-labelledby="h-upnext">
      <h2 id="h-upnext">Up next for you</h2>
      <p class="row-note">Books whose earlier books you have finished.</p>
      <div class="shelf" id="upnext-shelf"></div>
    </section>

    {shelves.map((p) => (
      <section class="row" aria-label={p.name}>
        <h2>{p.name}</h2>
        <div class="shelf">{p.subjects.filter((s) => subjects.get(s)!.some((r) => released.has(r.id))).map((s) => <SubjectCard rungs={subjects.get(s)!} released={released} />)}</div>
      </section>
    ))}

    <section class="row" aria-labelledby="h-parts">
      <h2 id="h-parts">Browse by Part</h2>
      <div class="chips" role="tablist" aria-label="Parts of the series">
        {parts.map((p, i) => (
          <button type="button" class="pchip" role="tab" aria-selected="false" aria-controls={`part-${i}`} style={`--h:${p.hue}`}>
            <span class="dot" aria-hidden="true"></span>{p.name} · {p.released}/{p.subjects.length}
          </button>
        ))}
      </div>
      {parts.map((p, i) => (
        <div class="part-list" id={`part-${i}`} role="tabpanel" hidden>
          <ol>
            {p.subjects.map((s) => {
              const rungs = subjects.get(s)!;
              const out = rungs.filter((r) => released.has(r.id));
              const name = rungs[0].title.replace(/\s*·\s*Rung \d$/, '');
              return (
                <li class:list={{ out: out.length > 0 }}>
                  <span class="sn">{s}</span>
                  {out.length ? <a href={`${SERIES_URL}${out[0].slug}/`}>{name}</a> : <span>{name}</span>}
                  <span class="st">{out.length ? `${out.length} of ${rungs.length} rung${rungs.length > 1 ? 's' : ''} out` : `${rungs.length} rung${rungs.length > 1 ? 's' : ''} · coming`}</span>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>

    <p class="muted small" style="margin-top:2.5rem">Every book is shared under CC BY-NC-SA 4.0: free to copy, share and adapt for non-commercial use, with credit, under the same licence. Educational, not personal medical advice. If these books help you, you can <a href="/support/">support this project</a>.</p>
  </div>
  <script id="series-data" type="application/json" set:html={JSON.stringify(client)} />
</Base>

<script>
  import { mountSeries } from '../../../../reader/series';
  mountSeries();
</script>

<style>
  .series-count { font-size: .95rem; }
  .series { padding-bottom: 4rem; }
  .series section.row { margin-top: 2rem; padding-block: 0; }
  .row h2 { font-size: 1.15rem; margin: 0 0 .25rem; }
  .row-note { margin: 0 0 .75rem; font-size: .88rem; color: var(--ink-3); }
  .shelf { display: flex; gap: 1.1rem; overflow-x: auto; padding: .5rem 2px 1rem; scroll-snap-type: x proximity; overscroll-behavior-x: contain; }
  .next-card { position: relative; }
  .next-label { margin: 0; font-size: .78rem; color: var(--ink-3); }
  .chips { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .5rem; }
  .pchip { display: inline-flex; align-items: center; gap: .45rem; min-height: 36px; padding: .3rem .75rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font: 600 .82rem var(--font-body); cursor: pointer; text-align: left; }
  .pchip .dot { width: .7rem; height: .7rem; border-radius: 50%; background: hsl(var(--h) 60% 38%); flex: none; }
  .pchip[aria-selected='true'] { border-color: hsl(var(--h) 60% 38%); color: var(--ink); background: var(--surface-2); }
  .part-list { margin-top: 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: .5rem 1rem; }
  .part-list ol { list-style: none; margin: 0; padding: 0; }
  .part-list li { display: grid; grid-template-columns: 3.2rem 1fr auto; gap: .75rem; align-items: baseline; padding: .55rem 0; border-bottom: 1px solid var(--line); font-size: .92rem; color: var(--ink-3); }
  .part-list li:last-child { border-bottom: 0; }
  .part-list li.out { color: var(--ink); }
  .part-list .sn { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .part-list .st { font-size: .8rem; white-space: nowrap; }
  @media (max-width: 560px) { .part-list li { grid-template-columns: 2.8rem 1fr; } .part-list .st { grid-column: 2; } }
</style>
