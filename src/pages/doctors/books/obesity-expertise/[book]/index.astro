---
// An Obesity Expertise book in the reader (src/components/books/BookReader.astro). This page says what is
// particular to the series: the generated cover, "Book N", the link back to the series.
import BookReader from '../../../../../components/books/BookReader.astro';
import Cover from '../../../../../components/books/Cover.astro';
import { obesityBooks, figureBase, SERIES_URL } from '../../../../../lib/obesity-books';
import { SITE } from '../../../../../consts';
import type { Book } from '../../../../../reader/types';

export function getStaticPaths() {
  return obesityBooks.map((book) => ({ params: { book: book.slug }, props: { book } }));
}
interface Props { book: Book }
const { book } = Astro.props;
const name = book.title.replace(/\s*·\s*Rung \d$/, '');
const rung = book.title.match(/Rung (\d)$/)?.[1];
const label = `Book ${book.number}`;
const date = new Date(book.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${SITE.url}${book.url}`;
const description = `${label} of the Obesity Expertise series: ${book.subtitle ?? name}. Free to read online or download (${book.licence}).`.slice(0, 170);
const jsonld = [{
  '@type': 'Book', '@id': `${url}#book`, name: `${label} · ${book.title}`, alternativeHeadline: book.subtitle, url,
  author: { '@id': `${SITE.url}/#person` }, dateModified: book.date, version: book.version, inLanguage: 'en-IN',
  isAccessibleForFree: true, license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
  isPartOf: { '@type': 'BookSeries', name: book.series, url: `${SITE.url}${SERIES_URL}` },
  encoding: { '@type': 'MediaObject', contentUrl: book.pdf, encodingFormat: 'application/pdf' },
}];
const end = `<p>End of ${label}. <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">${book.licence}</a></p>
        <p><a href="${SERIES_URL}">All books in the series</a> · <a href="${book.pdf}" download>Download the PDF</a> · <a href="/disclaimer/">Disclaimer</a> · <a href="/support/">Support</a></p>`;
---
<BookReader book={book} title={`${label} · ${name}`} description={description} jsonld={jsonld} figures={figureBase(book)} date={date}
  eyebrow={`<a href="${SERIES_URL}">${book.series}</a> · ${label}`} heading={name}
  headingNote={rung ? `Rung ${rung}${book.level ? ` · ${book.level}` : ''}` : undefined}
  barFull={`${label} · ${name}${rung ? ` · Rung ${rung}` : ''}`} barShort={label}
  backHref={SERIES_URL} backLabel="All books in the series" end={end}>
  <Cover slot="cover" hue={book.hue} number={book.number} title={book.title} level={book.level} size="lg" />
</BookReader>
