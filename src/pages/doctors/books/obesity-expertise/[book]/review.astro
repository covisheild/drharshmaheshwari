---
// An Obesity Expertise book's Review (src/components/books/BookReview.astro).
import BookReview from '../../../../../components/books/BookReview.astro';
import { obesityBooks, figureBase } from '../../../../../lib/obesity-books';
import type { Book } from '../../../../../reader/types';

export function getStaticPaths() {
  return obesityBooks.map((book) => ({ params: { book: book.slug }, props: { book } }));
}
interface Props { book: Book }
const { book } = Astro.props;
const name = book.title.replace(/\s*·\s*Rung \d$/, '');
const label = `Book ${book.number}`;
---
<BookReview book={book} label={label} name={name} figures={figureBase(book)} backLabel={`Back to ${label}`}
  description={`Spaced review for ${label} of the Obesity Expertise series: the questions you marked and the must-know points of the sections you have read.`} />
