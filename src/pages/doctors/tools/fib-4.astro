---
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../consts';

const url = `${SITE.url}/doctors/tools/fib-4/`;
const faq = [
  { q: 'What is the FIB-4 formula?', a: 'FIB-4 = (age in years × AST in U/L) ÷ (platelets in 10⁹/L × √ALT in U/L). Platelets reported as 2.5 lakh/mm³ are 250 × 10⁹/L.' },
  { q: 'What FIB-4 cut-offs are used in fatty liver?', a: 'INASL (2023) uses below 1.3 to rule out advanced fibrosis (F3–F4), 1.3 to 2.67 as the grey zone and above 2.67 to rule it in, the same as EASL-EASD-EASO (2024). In the NAFLD study that set them, 1.30 or less had a negative predictive value of 90% and 2.67 or more a positive predictive value of 80%. From 65 years a lower cut-off of 2.0 is used (McPherson 2017, EASL 2024); INASL gives no age-specific cut-off.' },
  { q: 'Why not use the 1.45 and 3.25 cut-offs?', a: 'Those were derived in HIV/hepatitis C co-infection (Sterling 2006). In NAFLD/MASLD the validated cut-offs are 1.30 and 2.67 (Shah 2009), which INASL and EASL-EASD-EASO use.' },
  { q: 'When is FIB-4 unreliable?', a: 'Under 35 years (it performs poorly), and when AST, ALT or platelets are moved by something other than chronic liver fibrosis: acute hepatitis or a recent alcohol binge, muscle injury, haematological causes of a low platelet count, or splenectomy.' },
];
const jsonld = [
  {
    '@type': ['WebApplication', 'MedicalWebPage'],
    '@id': `${url}#app`,
    name: 'FIB-4 calculator for fatty liver (MASLD/NAFLD)',
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    description: 'FIB-4 index from age, AST, ALT and platelets, with the fatty-liver cut-offs (1.30 and 2.67; 2.0 from age 65) and the next step at each level. Nothing you type leaves your device.',
    author: { '@id': `${SITE.url}/#person` },
    audience: { '@type': 'MedicalAudience', audienceType: 'Clinician' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="FIB-4 for fatty liver" description="FIB-4 calculator for MASLD/NAFLD: age, AST, ALT and platelets (10⁹/L or lakh/mm³), with the INASL 1.3 / 2.67 cut-offs, the age-65 cut-off of 2.0 and the next step at each level." jsonld={jsonld}>
  <header class="page-head wrap">
    <span class="eyebrow">Clinical tools</span>
    <h1>FIB-4 for fatty liver</h1>
    <p>Rules advanced fibrosis (F3–F4) in or out in <b>MASLD/NAFLD</b> from four routine values, as the first step before elastography. Everything is calculated on your device; nothing you type is sent or stored.</p>
  </header>

  <div class="wrap calc-wrap">
    <form class="calc card" id="fib" novalidate>
      <fieldset>
        <legend>Age</legend>
        <label class="field"><input type="number" inputmode="numeric" id="age" min="18" max="110" placeholder="52" aria-label="Age in years" /><span>years</span></label>
      </fieldset>
      <div class="two">
        <fieldset>
          <legend>AST <span class="muted small">(SGOT)</span></legend>
          <label class="field"><input type="number" inputmode="decimal" id="ast" min="1" max="5000" placeholder="38" aria-label="AST in U/L" /><span>U/L</span></label>
        </fieldset>
        <fieldset>
          <legend>ALT <span class="muted small">(SGPT)</span></legend>
          <label class="field"><input type="number" inputmode="decimal" id="alt" min="1" max="5000" placeholder="45" aria-label="ALT in U/L" /><span>U/L</span></label>
        </fieldset>
      </div>
      <fieldset>
        <legend>Platelets</legend>
        <div class="seg small-seg">
          <label><input type="radio" name="pu" value="si" checked /> <span>× 10⁹/L (= 10³/µL)</span></label>
          <label><input type="radio" name="pu" value="lakh" /> <span>lakh/mm³</span></label>
        </div>
        <label class="field"><input type="number" inputmode="decimal" id="plt" min="0.01" max="2000" step="any" placeholder="220" aria-label="Platelet count" /><span id="plt-unit">× 10⁹/L</span></label>
        <p class="small muted" id="plt-note" style="margin:.5rem 0 0">A report of 2.2 lakh/mm³ is 220 × 10⁹/L.</p>
      </fieldset>
      <p class="small muted" style="margin:0">For adults with fatty liver (MASLD/NAFLD). Use values from a stable period, not during an acute illness.</p>
    </form>

    <div class="results" aria-live="polite">
      <div class="card result">
        <span class="eyebrow">FIB-4</span>
        <div class="big"><b id="val">—</b></div>
        <div class="scale" aria-hidden="true" id="scale">
          <div class="band ok" id="b-low"></div><div class="band warn" id="b-mid"></div><div class="band risk" id="b-high"></div>
          <div class="marker" id="marker"></div>
        </div>
        <div class="scale-labels" aria-hidden="true"><span id="l-low">1.30</span><span id="l-high">2.67</span></div>
        <p class="verdict" id="verdict">Enter age, AST, ALT and platelets.</p>
        <p class="small" id="next"></p>
        <p class="small muted" id="caveat"></p>
      </div>
    </div>
  </div>

  <section class="prose-wrap prose" style="padding-top:2rem">
    <h2>How do I read the result?</h2>
    <table>
      <thead><tr><th>FIB-4</th><th>Advanced fibrosis</th><th>Next step</th></tr></thead>
      <tbody>
        <tr><td>Below 1.30<br /><span class="small muted">below 2.0 from 65 years</span></td><td>Unlikely (rules out)</td><td>Manage metabolic risk factors in primary care; re-assess every 1–3 years.</td></tr>
        <tr><td>1.30 – 2.67<br /><span class="small muted">2.0 – 2.67 from 65 years</span></td><td>Grey zone</td><td>Liver stiffness by transient elastography (FibroScan); INASL places it at tertiary level, so refer. EASL also allows a year of lifestyle and cardiometabolic treatment, then a repeat FIB-4.</td></tr>
        <tr><td>Above 2.67</td><td>Likely (rules in)</td><td>Refer to a hepatologist / gastroenterologist for elastography and staging.</td></tr>
      </tbody>
    </table>
    <p>In the NAFLD cohort that set these cut-offs (541 adults with biopsy), FIB-4 of 1.30 or less had a 90% negative predictive value and 2.67 or more an 80% positive predictive value for advanced fibrosis; AUROC 0.80. The low cut-off is there to keep most patients out of the elastography queue safely; the price is a grey zone between the two cut-offs, where a second test decides.</p>

    <h2>What liver stiffness confirms it?</h2>
    <table>
      <thead><tr><th>Liver stiffness (VCTE)</th><th>INASL 2023</th><th>EASL 2024</th></tr></thead>
      <tbody>
        <tr><td>Significant fibrosis (F2 or more)</td><td>8.2 kPa or more; under 6.0 makes it unlikely</td><td>—</td></tr>
        <tr><td>Advanced fibrosis (F3 or more)</td><td>9.7 kPa or more</td><td>below 8 rules out, 12 or more rules in</td></tr>
        <tr><td>Cirrhosis (F4)</td><td>13.6 kPa or more</td><td>—</td></tr>
      </tbody>
    </table>
    <p>INASL takes significant fibrosis (F2 or more), not F3, as the entry point for referral. In Indian data it quotes FIB-4 below 1 as ruling out significant fibrosis with very high sensitivity.</p>

    <h2>Who should have it?</h2>
    <p>INASL suggests looking for fatty liver in people with type 2 diabetes, obesity or metabolic syndrome, and recommends FIB-4 (or APRI) as the first fibrosis test at primary and secondary care. EASL adds abnormal liver tests. Normal ALT does not exclude advanced fibrosis.</p>

    <h2>When is it misleading?</h2>
    <ul>
      <li><b>Under 35:</b> the index performs poorly (AUROC about 0.60); a low value is not reassuring.</li>
      <li><b>65 and over:</b> age alone pushes FIB-4 up, so specificity with 1.30 falls to about 35%; the 2.0 cut-off brings it to about 70% (McPherson 2017; used by EASL 2024, not stated by INASL).</li>
      <li><b>AST or ALT not from the liver's chronic state:</b> acute hepatitis, a recent alcohol binge, heavy exercise or muscle injury, haemolysis.</li>
      <li><b>Platelets low for another reason:</b> ITP, marrow disease, hypersplenism from non-cirrhotic portal hypertension; or high after splenectomy.</li>
      <li><b>Other liver diseases:</b> the 1.30 / 2.67 cut-offs are for fatty liver. In hepatitis C and HIV co-infection, where FIB-4 was first built, the cut-offs were 1.45 and 3.25.</li>
    </ul>

    <div class="faq">
      <h2>Common questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
    <div class="refs" style="margin-top:2rem">
      <h2>Sources</h2>
      <ol>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/16729309/">Sterling RK, et al. Development of a simple noninvasive index to predict significant fibrosis in patients with HIV/HCV coinfection. Hepatology 2006;43:1317-25.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/19523535/">Shah AG, et al. Comparison of noninvasive markers of fibrosis in patients with nonalcoholic fatty liver disease. Clin Gastroenterol Hepatol 2009;7:1104-12.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/27725647/">McPherson S, et al. Age as a confounding factor for the accurate non-invasive diagnosis of advanced NAFLD fibrosis. Am J Gastroenterol 2017;112:740-51.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/36950481/">Duseja A, et al. Indian National Association for Study of the Liver (INASL) guidance paper on nomenclature, diagnosis and treatment of nonalcoholic fatty liver disease (NAFLD). J Clin Exp Hepatol 2023;13:273-302.</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/38851997/">EASL-EASD-EASO Clinical Practice Guidelines on the management of metabolic dysfunction-associated steatotic liver disease (MASLD). J Hepatol 2024;81:492-542.</a></li>
      </ol>
    </div>
    <p class="disclaimer"><a href="/disclaimer/">Disclaimer</a></p>
  </section>
</Base>

<style>
  .calc-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 820px) { .calc-wrap { grid-template-columns: 1fr; } }
  .calc-wrap > *, .two > * { min-width: 0; }
  .calc { gap: 1.1rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .seg { display: inline-flex; flex-wrap: wrap; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: .3rem .8rem; font-size: .9rem; border-radius: 999px; font-weight: 550; color: var(--ink-2); transition: background .2s, color .2s; }
  .seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .seg input:focus-visible + span { outline: 3px solid var(--accent); }
  .small-seg { margin-bottom: .6rem; }
  .field { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding-right: .9rem; transition: border-color .2s; }
  .field:focus-within { border-color: var(--brand); }
  .field input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 600 1.25rem var(--font-body); padding: .75rem .9rem; outline: none; }
  .field span { color: var(--ink-3); white-space: nowrap; }
  .results { position: sticky; top: calc(var(--nav-space, 84px) + .5rem); }
  @media (max-width: 820px) { .results { position: static; } }
  .big b { font: 600 3.2rem/1 var(--font-display); color: var(--ink); }
  /* visible range 0-4 */
  .scale { position: relative; display: grid; grid-template-columns: 1.3fr 1.37fr 1.33fr; height: 12px; margin-top: 1rem; }
  .band.ok { background: var(--ok); border-radius: 999px 0 0 999px; } .band.warn { background: var(--warn); } .band.risk { background: var(--risk); border-radius: 0 999px 999px 0; }
  .marker { position: absolute; top: -6px; width: 4px; height: 24px; background: var(--ink); border-radius: 2px; left: 0; opacity: 0; transition: left .6s cubic-bezier(.2,.8,.2,1), opacity .3s; }
  @media (prefers-reduced-motion: reduce) { .marker { transition: none; } }
  .scale-labels { position: relative; height: 1.2rem; font-size: .75rem; color: var(--ink-3); }
  .scale-labels span { position: absolute; transform: translateX(-50%); }
  .verdict { font-weight: 600; margin: .75rem 0 .25rem; padding: .6rem .8rem; border-radius: 10px; background: var(--surface-2); }
  .verdict.ok { background: var(--ok-soft); color: var(--ok); } .verdict.warn { background: var(--warn-soft); color: var(--warn); } .verdict.risk { background: var(--risk-soft); color: var(--risk); }
</style>

<script>
  import { fib4, fib4Band, lakhToSI } from '../../../lib/fib4';

  const $ = (id: string) => document.getElementById(id)!;
  const form = $('fib') as HTMLFormElement;
  const num = (id: string) => parseFloat(($(id) as HTMLInputElement).value);
  const MAX = 4; // right end of the bar

  const TEXT = {
    low: ['Advanced fibrosis unlikely', 'ok', 'Low risk: manage metabolic risk factors and re-assess every 1–3 years.'],
    indeterminate: ['Grey zone', 'warn', 'Next: liver stiffness by transient elastography (FibroScan); INASL places it at tertiary level, so refer.'],
    high: ['Advanced fibrosis likely', 'risk', 'Refer to a hepatologist / gastroenterologist for elastography and staging.'],
  } as const;

  function setBar(lower: number, upper: number) {
    ($('scale') as HTMLElement).style.gridTemplateColumns = `${lower}fr ${upper - lower}fr ${MAX - upper}fr`;
    $('l-low').textContent = lower.toFixed(2); $('l-low').style.left = `${(lower / MAX) * 100}%`;
    $('l-high').style.left = `${(upper / MAX) * 100}%`;
  }

  function update() {
    const lakh = (form.querySelector('input[name=pu]:checked') as HTMLInputElement).value === 'lakh';
    $('plt-unit').textContent = lakh ? 'lakh/mm³' : '× 10⁹/L';
    const age = num('age'), ast = num('ast'), alt = num('alt'), raw = num('plt');
    const platelets = lakh ? lakhToSI(raw) : raw;
    $('plt-note').textContent = Number.isFinite(raw) && raw > 0
      ? (lakh ? `= ${platelets.toFixed(0)} × 10⁹/L.` : `= ${(raw / 100).toFixed(2)} lakh/mm³.`) + (lakh ? (raw > 20 ? ' That looks like a count in 10⁹/L: switch the unit?' : '') : (raw < 20 ? ' That looks like a count in lakh/mm³: switch the unit?' : ''))
      : 'A report of 2.2 lakh/mm³ is 220 × 10⁹/L.';

    const ok = age >= 18 && age <= 110 && ast > 0 && alt > 0 && platelets >= 1 && platelets <= 2000;
    const v = $('verdict');
    setBar(age >= 65 ? 2 : 1.3, 2.67);
    if (!ok) {
      $('val').textContent = '—'; $('marker').style.opacity = '0';
      v.textContent = age > 0 && age < 18 ? 'FIB-4 is for adults.' : 'Enter age, AST, ALT and platelets.'; v.className = 'verdict';
      $('next').textContent = ''; $('caveat').textContent = '';
      return;
    }
    const value = fib4({ age, ast, alt, platelets });
    const { band, lower } = fib4Band(value, age);
    $('val').textContent = value.toFixed(2);
    $('marker').style.left = `calc(${Math.min(value / MAX, 1) * 100}% - 2px)`; $('marker').style.opacity = '1';
    const [label, cls, next] = TEXT[band];
    v.textContent = `${label} (${band === 'low' ? `below ${lower.toFixed(2)}` : band === 'high' ? 'above 2.67' : `${lower.toFixed(2)}–2.67`})`;
    v.className = `verdict ${cls}`;
    $('next').textContent = next;
    const notes = [];
    if (age < 35) notes.push('Under 35, FIB-4 performs poorly: a low value does not rule advanced fibrosis out.');
    if (age >= 65) notes.push('65 or over: the lower cut-off of 2.0 is used, because age alone raises FIB-4.');
    if (ast > 200 || alt > 200) notes.push('Transaminases this high raise the question of an acute process; FIB-4 assumes a stable state.');
    $('caveat').textContent = notes.join(' ');
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
