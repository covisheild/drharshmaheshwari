---
// Settings: this device's choices, laid out like a phone's settings screen (grouped lists, one row per choice, a switch on
// the right). Also /<lang>/settings/. Reached from the ☰ menu (a gear on wide screens) and every footer.
//   Appearance: theme (system, light, dark): the header has no theme button (Harsh, 12 Oct 2026).
//   Keep on this device: one switch per kind of light material (src/pwa/settings.ts, auto.ts), the second language.
//   Books, Trainers: one switch each; on = saved for offline (packs.ts), off = removed.
//   Storage: what the site uses; update now; remove everything. App: install, version.
// A new setting adds a field in settings.ts and a row here.
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import ClientWords from '../components/ClientWords.astro';
import { useT } from '../i18n/t';
import { localHref, otherLangs } from '../i18n/routes';
import { langOf } from '../i18n/languages';

const path = Astro.url.pathname;
const t = useT(path);
const L = (href: string) => localHref(langOf(path), href);
const langs = otherLangs();

const svg = (d: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
const ICON = {
  theme: svg('M12 3a9 9 0 1 0 0 18zM12 3a9 9 0 0 1 0 18'),
  guides: svg('M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7'),
  tools: svg('M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 19h8'),
  trackers: svg('M3 12h4l3-8 4 16 3-8h4'),
  blog: svg('M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z'),
  evidence: svg('M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3'),
  lang: svg('M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2c3 3 4 6 4 10s-1 7-4 10c-3-3-4-6-4-10s1-7 4-10z'),
  storage: svg('M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'),
  update: svg('M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5'),
  remove: svg('M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14'),
  install: svg('M12 4v11M7 10l5 5 5-5M5 20h14'),
  info: svg('M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 16v-5M12 8h.01'),
};
const kinds = [
  { key: 'guides', icon: ICON.guides, label: t('Guides') },
  { key: 'tools', icon: ICON.tools, label: t('Calculators and tools') },
  { key: 'trackers', icon: ICON.trackers, label: t('Trackers') },
  { key: 'blog', icon: ICON.blog, label: t('Blog posts from the last 6 months') },
  { key: 'evidence', icon: ICON.evidence, label: t('Evidence for doctors') },
];
---
<Base title={t('Settings')} description={t('Choose the theme, and what this device keeps to use without internet.')} noindex>
  <div class="prose-wrap sg-page" style="padding-block:2.5rem 4rem" id="sg" data-langs={langs.map((l) => l.code).join(',')}>
    <h1>{t('Settings')}</h1>

    <section class="sg" aria-labelledby="sg-look">
      <h2 class="sg-h" id="sg-look">{t('Appearance')}</h2>
      <div class="sg-list">
        <div class="sg-row">
          <span class="sg-ic" set:html={ICON.theme} />
          <span class="sg-text"><span class="sg-t" id="sg-theme-l">{t('Theme')}</span></span>
          <span class="sg-seg" role="radiogroup" aria-labelledby="sg-theme-l">
            <button type="button" role="radio" data-theme-set="system">{t('System')}</button>
            <button type="button" role="radio" data-theme-set="light">{t('Light')}</button>
            <button type="button" role="radio" data-theme-set="dark">{t('Dark')}</button>
          </span>
        </div>
      </div>
    </section>

    <section class="sg" aria-labelledby="sg-keep" data-needs-offline>
      <h2 class="sg-h" id="sg-keep">{t('Keep on this device')}</h2>
      <p class="sg-note">{t('Choose what opens without internet. Turning one off removes it from this device.')}</p>
      <div class="sg-list">
        {kinds.map((k) => (
          <button type="button" role="switch" class="sg-row sg-tap" data-keep={k.key} aria-checked="false">
            <span class="sg-ic" set:html={k.icon} />
            <span class="sg-text"><span class="sg-t">{k.label}</span><span class="sg-s" data-sub={k.key}></span></span>
            <span class="sg-sw" aria-hidden="true"><i></i></span>
          </button>
        ))}
        <label class="sg-row">
          <span class="sg-ic" set:html={ICON.lang} />
          <span class="sg-text"><span class="sg-t">{t('Second language')}</span><span class="sg-s">{t('English is always kept.')}</span></span>
          <select class="sg-select" id="sg-lang2">
            <option value="none">{t('None')}</option>
            {langs.map((l) => <option value={l.code} lang={l.html}>{l.name}</option>)}
          </select>
        </label>
      </div>
      <p class="sg-note" data-base-note></p>
      <p class="sg-note"><T><b>Videos</b> need internet.</T></p>
    </section>

    <section class="sg" aria-labelledby="sg-books" data-needs-offline>
      <h2 class="sg-h" id="sg-books">{t('Books')}</h2>
      <div class="sg-list" data-packs="book"><div class="sg-row"><span class="sg-text"><span class="sg-s">{t('Loading…')}</span></span></div></div>
      <h2 class="sg-h" id="sg-trainers">{t('Trainers')}</h2>
      <div class="sg-list" data-packs="trainer"></div>
      <p class="sg-note">{t('Saved only when you turn them on. Each is downloaded once and updates itself.')}</p>
    </section>

    <section class="sg" aria-labelledby="sg-store" data-needs-offline>
      <h2 class="sg-h" id="sg-store">{t('Storage')}</h2>
      <div class="sg-list">
        <div class="sg-row">
          <span class="sg-ic" set:html={ICON.storage} />
          <span class="sg-text"><span class="sg-t">{t('Used on this device')}</span></span>
          <span class="sg-val" id="sg-usage">—</span>
        </div>
        <button type="button" class="sg-row sg-tap" id="sg-update">
          <span class="sg-ic" set:html={ICON.update} />
          <span class="sg-text"><span class="sg-t">{t('Update now')}</span><span class="sg-s" id="sg-update-s"></span></span>
        </button>
        <button type="button" class="sg-row sg-tap sg-danger" id="sg-clear">
          <span class="sg-ic" set:html={ICON.remove} />
          <span class="sg-text"><span class="sg-t">{t('Remove everything kept offline')}</span></span>
        </button>
      </div>
    </section>
    <p class="sg-note" data-unsupported hidden>{t('This browser cannot keep pages for use without internet. Chrome, Edge, Firefox and Safari can.')}</p>

    <section class="sg" aria-labelledby="sg-app">
      <h2 class="sg-h" id="sg-app">{t('App')}</h2>
      <div class="sg-list">
        <a class="sg-row sg-tap" href={L('/app/')} data-install-row>
          <span class="sg-ic" set:html={ICON.install} />
          <span class="sg-text"><span class="sg-t">{t('Install the app')}</span></span>
          <span class="sg-chev" aria-hidden="true">›</span>
        </a>
        <div class="sg-row">
          <span class="sg-ic" set:html={ICON.info} />
          <span class="sg-text"><span class="sg-t">{t('Version')}</span></span>
          <span class="sg-val" id="sg-version"></span>
        </div>
      </div>
      <p class="sg-note">{t('These choices are for this device only. Nothing about them is sent anywhere.')}</p>
    </section>
    <noscript><p>{t('Settings need JavaScript.')}</p></noscript>
  </div>
  <ClientWords sources={['/src/pages/settings.astro']} />
</Base>

<style is:global>
  .sg-page h1 { margin-bottom: 1.25rem; }
  .sg { margin-top: 1.75rem; }
  .sg-page .sg-h { margin: 0 0 .5rem .9rem; font: 500 .74rem/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .sg-page .sg-list + .sg-h { margin-top: 1.25rem; }
  .sg-list { border-radius: 16px; background: var(--surface); border: 1px solid var(--line); overflow: hidden; }
  .sg-row { display: flex; align-items: center; gap: .85rem; width: 100%; min-height: 58px; padding: .7rem 1rem; margin: 0; border: 0; border-bottom: 1px solid var(--line);
    background: transparent; color: var(--ink); font: inherit; text-align: start; text-decoration: none; }
  .sg-row:last-child { border-bottom: 0; }
  .sg-tap { cursor: pointer; }
  .sg-tap:hover { background: color-mix(in oklab, var(--ink) 5%, transparent); }
  .sg-tap:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; }
  .sg-ic { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: var(--brand-soft); color: var(--brand); }
  .sg-danger .sg-ic { background: var(--risk-soft); color: var(--risk); }
  .sg-danger .sg-t { color: var(--risk); }
  .sg-text { flex: 1; min-width: 0; display: grid; gap: .1rem; }
  .sg-t { font-size: 1rem; font-weight: 500; }
  .sg-s { font-size: .82rem; color: var(--ink-2); }
  .sg-s:empty { display: none; }
  .sg-val { flex: none; font-size: .9rem; color: var(--ink-2); }
  .sg-chev { flex: none; font-size: 1.4rem; line-height: 1; color: var(--ink-3); }
  .sg-note { margin: .5rem .9rem 0; font-size: .82rem; color: var(--ink-2); }
  .sg-note:empty { display: none; }
  /* The switch */
  .sg-sw { flex: none; position: relative; width: 50px; height: 30px; border-radius: 999px; background: var(--line-2); transition: background .2s; }
  .sg-sw i { position: absolute; top: 3px; inset-inline-start: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / .3); transition: transform .2s; }
  [aria-checked="true"] > .sg-sw { background: var(--brand-fill); }
  [aria-checked="true"] > .sg-sw i { transform: translateX(20px); }
  [dir="rtl"] [aria-checked="true"] > .sg-sw i { transform: translateX(-20px); }
  .sg-row[aria-busy="true"] .sg-s { color: var(--brand); }
  /* Theme: a segmented control */
  .sg-seg { flex: none; display: inline-flex; padding: 3px; border-radius: 10px; background: var(--line); }
  .sg-seg button { border: 0; background: none; color: var(--ink-2); font: inherit; font-size: .85rem; padding: .35rem .7rem; border-radius: 8px; cursor: pointer; }
  .sg-seg button[aria-checked="true"] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / .2); }
  .sg-select { flex: none; max-width: 45%; font: inherit; font-size: .9rem; padding: .4rem .6rem; border-radius: 10px; border: 1px solid var(--line-2); background: var(--surface); color: var(--ink); }
  @media (max-width: 420px) { .sg-row { gap: .7rem; padding-inline: .85rem; } .sg-seg button { padding: .35rem .5rem; } }
  @media (prefers-reduced-motion: reduce) { .sg-sw, .sg-sw i { transition: none; } }
</style>

<script>
  import { getSettings, setKeep, setLang2, standalone, getTheme, setTheme, keepsAnything, KEEP, type Keep, type Theme } from '../pwa/settings';
  import { autoSync } from '../pwa/auto';
  import { formatBytes, packIndex, packState, removePack, savePack, savedPacks, supported, OutOfSpace, type PackSummary } from '../pwa/packs';
  import { clearOffline } from '../pwa/client';
  import { w } from '../i18n/client';

  declare const __BUILD_ID__: string;
  const root = document.getElementById('sg')!;
  const langs = (root.dataset.langs ?? '').split(',').filter(Boolean);
  const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // ---------- appearance
  const drawTheme = () => root.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeSet === getTheme())));
  root.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => b.addEventListener('click', () => { setTheme(b.dataset.themeSet as Theme); drawTheme(); }));
  drawTheme();

  // ---------- app
  const built = new Date(parseInt(__BUILD_ID__, 36));
  $<HTMLElement>('#sg-version').textContent = isNaN(+built) ? '' : built.toLocaleDateString(document.documentElement.lang || 'en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  if (standalone()) $<HTMLElement>('[data-install-row]').hidden = true;

  // ---------- keep on this device
  if (!supported()) {
    root.querySelectorAll<HTMLElement>('[data-needs-offline]').forEach((el) => { el.hidden = true; });
    $<HTMLElement>('[data-unsupported]').hidden = false;
  } else {
    let index: PackSummary[] = [];
    const progress: Record<string, number> = {};
    let busy = false, again = false;
    const sizeOf = (ps: PackSummary[]) => formatBytes(ps.reduce((a, p) => a + p.bytes, 0));

    const drawKeep = async () => {
      const s = getSettings(langs);
      const saved = await savedPacks();
      const done = (id: string) => saved.some((p) => p.id === id && p.done);
      for (const k of KEEP) {
        const row = $<HTMLButtonElement>(`[data-keep="${k}"]`);
        const on = s.keep[k];
        row.setAttribute('aria-checked', String(on));
        const mine = index.filter((p) => p.kind === k && (p.lang === 'en' || p.lang === s.lang2));
        row.hidden = mine.length === 0;
        const pc = mine.map((p) => progress[p.id]).filter((x) => x !== undefined);
        row.setAttribute('aria-busy', String(pc.length > 0));
        const sub = $<HTMLElement>(`[data-sub="${k}"]`);
        if (!on) sub.textContent = w('Off · {size} when on', { size: sizeOf(mine) });
        else if (pc.length) sub.textContent = w('Downloading… {percent}%', { percent: String(Math.min(...pc)) });
        else if (mine.every((p) => done(p.id))) sub.textContent = w('On this device · {size}', { size: sizeOf(mine) });
        else sub.textContent = navigator.onLine ? w('Downloading soon…') : w('Downloads when you are online');
      }
      $<HTMLSelectElement>('#sg-lang2').value = s.lang2;
      const base = index.filter((p) => p.kind === 'base' && (p.lang === 'en' || p.lang === s.lang2));
      $<HTMLElement>('[data-base-note]').textContent = keepsAnything(s) && base.length ? w('The home and menu pages ({size}) are kept with any of these, so the app opens without internet.', { size: sizeOf(base) }) : '';
      const est = await navigator.storage?.estimate?.().catch(() => null);
      $<HTMLElement>('#sg-usage').textContent = est?.usage != null ? formatBytes(est.usage) : '—';
    };

    const sync = async (force = false) => {
      const msg = $<HTMLElement>('#sg-update-s');
      if (!navigator.onLine) { msg.textContent = w('You are offline. Changes apply when you are back online.'); return; }
      if (busy) { again = true; return; }
      busy = true;
      msg.textContent = '';
      try {
        await autoSync({ force, progress: (id, d, t) => { progress[id] = t ? Math.min(99, Math.round((d / t) * 100)) : 0; void drawKeep(); } });
        msg.textContent = w('Up to date.');
      } catch {
        msg.textContent = w('Could not finish: check your internet connection and try again.');
      } finally {
        busy = false;
        for (const k of Object.keys(progress)) delete progress[k];
        await drawKeep();
      }
      if (again) { again = false; await sync(); }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-keep]').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.keep as Keep;
      setKeep(k, !getSettings(langs).keep[k]);
      void drawKeep().then(() => sync());
    }));
    $<HTMLSelectElement>('#sg-lang2').addEventListener('change', (e) => {
      setLang2((e.target as HTMLSelectElement).value);
      void drawKeep().then(() => sync());
    });
    $<HTMLButtonElement>('#sg-update').addEventListener('click', () => { void sync(true); });
    $<HTMLButtonElement>('#sg-clear').addEventListener('click', async () => {
      if (!confirm(w('Remove everything this site keeps on this device for offline use? Books and trainers you saved are removed too, and every switch above is turned off. Your reading places and tracker readings stay.'))) return;
      await clearOffline();
      for (const k of KEEP) setKeep(k, false);
      location.reload();
    });

    // ---------- books and trainers: one switch each (on = saved for offline)
    const running: Record<string, AbortController> = {};
    const packRow = (p: PackSummary) => `<button type="button" role="switch" class="sg-row sg-tap" data-pack="${esc(p.id)}" aria-checked="false">
      <span class="sg-text"><span class="sg-t" lang="en">${esc(p.title)}</span><span class="sg-s"></span></span>
      <span class="sg-sw" aria-hidden="true"><i></i></span></button>`;
    const drawPack = async (row: HTMLElement) => {
      const p = index.find((x) => x.id === row.dataset.pack)!;
      const sub = row.querySelector<HTMLElement>('.sg-s')!;
      const size = p.approx ? w('About {size}', { size: formatBytes(p.bytes) }) : formatBytes(p.bytes);
      if (running[p.id]) { row.setAttribute('aria-checked', 'true'); return; }
      const st = await packState(p.id, p.bytes);
      row.setAttribute('aria-checked', String(st.saved));
      row.setAttribute('aria-busy', 'false');
      sub.textContent = !st.saved ? w('Off · {size}', { size })
        : st.done ? w('On this device · {size}', { size: formatBytes(st.bytes) })
        : w('Not finished ({percent}%). Continues while this page is open.', { percent: String(st.percent) });
      if (st.saved && !st.done && navigator.onLine) void download(row, p);
    };
    const download = async (row: HTMLElement, p: PackSummary) => {
      const sub = row.querySelector<HTMLElement>('.sg-s')!;
      if (!navigator.onLine) { sub.textContent = w('You are offline. Connect to the internet to save.'); row.setAttribute('aria-checked', 'false'); return; }
      const ctl = new AbortController();
      running[p.id] = ctl;
      row.setAttribute('aria-checked', 'true');
      row.setAttribute('aria-busy', 'true');
      sub.textContent = w('Downloading… {percent}%', { percent: '0' });
      try {
        await savePack(p.id, (d, t) => { sub.textContent = w('Downloading… {percent}%', { percent: String(t ? Math.min(99, Math.round((d / t) * 100)) : 0) }); }, ctl.signal);
        delete running[p.id];
      } catch (err) {
        delete running[p.id];
        if (ctl.signal.aborted) return;
        await drawPack(row);
        sub.textContent = err instanceof OutOfSpace ? w('Not enough space on this device. Free some space, then try again.')
          : w('Saving stopped: the internet connection was lost. It continues when you are back online.');
        return;
      }
      await drawPack(row);
      void drawKeep();
    };
    const togglePack = async (row: HTMLElement) => {
      const p = index.find((x) => x.id === row.dataset.pack)!;
      if (row.getAttribute('aria-checked') === 'true') {
        running[p.id]?.abort();
        delete running[p.id];
        await removePack(p.id);
        await drawPack(row);
        void drawKeep();
      } else void download(row, p);
    };

    try {
      index = (await packIndex()).packs;
      for (const kind of ['book', 'trainer']) {
        const list = $<HTMLElement>(`[data-packs="${kind}"]`);
        const ps = index.filter((p) => p.kind === kind);
        list.innerHTML = ps.map(packRow).join('');
        list.hidden = !ps.length;
        list.querySelectorAll<HTMLElement>('[data-pack]').forEach((row) => { row.addEventListener('click', () => { void togglePack(row); }); void drawPack(row); });
      }
    } catch {
      $<HTMLElement>('[data-packs="book"]').innerHTML = `<div class="sg-row"><span class="sg-text"><span class="sg-s">${w('The list did not load. Check your internet connection and reload the page.')}</span></span></div>`;
    }
    await drawKeep();
    addEventListener('drhm:settings', () => { void drawKeep(); });
  }
</script>
