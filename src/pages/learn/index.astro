---
import ArticleList from '../../components/ArticleList.astro';
import MoreCards from '../../components/MoreCards.astro';
import { books } from '../../lib/content';
import videos from '../../data/videos.json';
import { useT } from '../../i18n/t';

// Books and videos for everyone are reached from here (they are not in the header).
const bookCount = (await books('everyone')).length;
const videoCount = videos.filter((v) => v.mode === 'everyone').length;
const t = useT(Astro.url.pathname);
const more = [
  { href: '/books/', label: 'Books', text: 'Full-length books on weight, food and health for families. Read and download the PDF.', count: bookCount > 1 ? t('{n} books', { n: bookCount }) : bookCount ? t('1 book') : t('Being written') },
  { href: '/videos/', label: 'Videos', text: 'Short explainers on weight, food, activity and the diseases that follow obesity.', count: videoCount > 1 ? t('{n} videos', { n: videoCount }) : videoCount ? t('1 video') : t('In production') },
];
---
<ArticleList collection="learn" title="Learn about obesity" intro="Plain-language guides on weight, food, activity, sleep and the diseases that follow obesity — written for Indian families and kept up to date with the evidence." empty="The first guides are being written. Check back soon.">
  <MoreCards items={more} />
</ArticleList>
