---
// Support this project. A shared page (like /about/): linked from both modes' footers.
// Payments are not active (PAYMENTS_ENABLED = false): the options can be explored, nothing can be paid.
// Design and rules: docs/support-architecture.md.
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { LIMITS, ONE_TIME_PRESETS, PAYMENTS_ENABLED, RECURRING_PRESETS, formatINR, perLabel, yearly } from '../lib/support';

const helps = [
  ['Hosting and storage', 'Keeping the site, the books and the trainer recordings online and fast.'],
  ['Media: preparation and licensing', 'Finding openly licensed recordings and images, checking their licences, cleaning and labelling them.'],
  ['Research and writing', 'Reading the evidence and turning it into guides, syntheses and books.'],
  ['Maintenance', 'Fixing errors, updating content as evidence changes, keeping everything secure.'],
  ['New educational tools', 'Building the next trainers and calculators.'],
];
---
<Base title="Support this project" description="Help keep this project free and support its continued development. Voluntary one-time or recurring contributions; nothing on the site requires payment.">
  <header class="page-head wrap support-head">
    <span class="eyebrow">Support</span>
    <h1>Support this project</h1>
    <p>Help keep this project free and support its continued development.</p>
    <p class="muted">Everything on this site is free to use, and will stay that way whether or not you contribute.</p>
  </header>

  <div class="wrap support-grid">
    <section class="support-why" aria-labelledby="why-h">
      <h2 id="why-h">What support helps with</h2>
      <ul class="helps">
        {helps.map(([title, text]) => <li><b>{title}.</b> {text}</li>)}
      </ul>
      <h2>Other ways to help</h2>
      <ul class="helps">
        <li><b>Share</b> a guide, book or trainer with someone who would use it.</li>
        <li><b>Report an error</b> or a broken link: <a href={`mailto:${SITE.email}?subject=Correction`}>{SITE.email}</a>.</li>
        <li><b>Suggest</b> a topic, tool or trainer you would find useful.</li>
      </ul>
    </section>

    <section class="card support-form-card" aria-labelledby="form-h">
      <h2 id="form-h">Make a contribution</h2>
      {!PAYMENTS_ENABLED && <p class="soon" role="status"><b>Contributions open soon.</b> You can look through the options below, but nothing can be paid yet.</p>}

      <form id="support-form" class="support-form" novalidate data-enabled={String(PAYMENTS_ENABLED)}>
        <fieldset class="kind">
          <legend class="sr-only">How often</legend>
          <label><input type="radio" name="kind" value="once" checked /> <span>Once</span></label>
          <label><input type="radio" name="kind" value="recurring" /> <span>Regularly</span></label>
        </fieldset>

        <fieldset class="amounts" data-kind="once">
          <legend>Choose an amount</legend>
          <div class="chips">
            {ONE_TIME_PRESETS.map((a) => <label class="chip-opt"><input type="radio" name="once-amount" value={a} /> <span>{formatINR(a)}</span></label>)}
            <label class="chip-opt"><input type="radio" name="once-amount" value="custom" /> <span>Other amount</span></label>
          </div>
          <label class="custom" hidden>
            <span>Amount in ₹</span>
            <input type="number" inputmode="numeric" name="once-custom" min={LIMITS.oneTime.min} max={LIMITS.oneTime.max} step="1" placeholder="e.g. 300" />
          </label>
        </fieldset>

        <fieldset class="amounts" data-kind="recurring" hidden>
          <legend>Choose an amount and how often</legend>
          <div class="chips">
            {RECURRING_PRESETS.map((p) => (
              <label class="chip-opt tall">
                <input type="radio" name="rec-amount" value={`${p.amount}/${p.frequency}`} />
                <span><b>{formatINR(p.amount)}/{perLabel(p.frequency)}</b>{p.note && <small>{p.note}</small>}<small>{yearly(p.amount, p.frequency).text}</small></span>
              </label>
            ))}
            <label class="chip-opt tall"><input type="radio" name="rec-amount" value="custom" /> <span><b>Other amount</b><small>weekly or monthly</small></span></label>
          </div>
          <div class="custom" hidden>
            <label><span>Amount in ₹</span>
              <input type="number" inputmode="numeric" name="rec-custom" min={LIMITS.recurring.min} max={LIMITS.recurring.max} step="1" placeholder="e.g. 30" /></label>
            <label><span>Every</span>
              <select name="rec-frequency"><option value="week">week</option><option value="month">month</option></select></label>
          </div>
        </fieldset>

        <div class="summary" aria-live="polite" id="summary">Choose an amount to see the total.</div>

        <label class="authorise" hidden>
          <input type="checkbox" name="authorise" />
          <span id="authorise-text">I authorise this amount to be collected automatically until I cancel.</span>
        </label>

        <label class="email">
          <span>Email <small>for your receipt{' '}<span class="rec-only" hidden>and a link to manage or cancel</span></small></span>
          <input type="email" name="email" autocomplete="email" placeholder="you@example.com" disabled={!PAYMENTS_ENABLED} />
        </label>

        <button class="btn btn-primary submit" type="submit" disabled id="submit">Choose an amount</button>
        {!PAYMENTS_ENABLED && <p class="small muted center">Contributions open soon.</p>}

        <div class="fine">
          <p><b>Payment methods:</b> UPI, and debit or credit cards. Regular contributions use UPI AutoPay or a card that supports recurring payments. Indian payment methods, in rupees.</p>
          <p class="rec-only" hidden><b>Regular contributions:</b> you approve once, in your UPI app or with your card. You are notified before each payment. Cancel any time from the link in your email, or from your UPI app or bank; cancelling stops all future payments.</p>
          <p>No account is needed. Contributions are voluntary support for the project: they do not buy access, features or medical advice, and they are not tax-deductible.</p>
          <p>If you think a payment went wrong (charged twice, or a payment you did not make), write to <a href={`mailto:${SITE.email}?subject=Payment%20query`}>{SITE.email}</a>.</p>
        </div>
      </form>
    </section>
  </div>
  <div class="wrap" style="padding-bottom:4rem"></div>
</Base>

<style>
  .support-head p:first-of-type { font-size: 1.2rem; color: var(--ink); }
  .support-grid > section { padding-block: 0; }
  .support-grid { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 900px) { .support-grid { grid-template-columns: 1fr; } .support-form-card { order: -1; } }
  .support-why h2 { font-size: 1.25rem; margin-top: 0; }
  .support-why h2 + .helps + h2 { margin-top: 2rem; }
  .helps { padding-left: 1.2rem; margin: 0; } .helps li { margin: .5rem 0; color: var(--ink-2); } .helps b { color: var(--ink); }
  .support-form-card { gap: 1rem; }
  .support-form-card h2 { font-size: 1.25rem; margin: 0; }
  .soon { margin: 0; padding: .7rem .9rem; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); font-size: .95rem; }
  .support-form { display: grid; gap: 1rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .kind { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 4px; gap: 2px; justify-self: start; }
  .kind input, .chip-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .kind span { display: block; padding: .5rem 1.2rem; border-radius: 999px; font-weight: 600; color: var(--ink-2); cursor: pointer; }
  .kind input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow), 0 0 0 1px var(--line); }
  .kind input:focus-visible + span, .chip-opt input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: .5rem; }
  [data-kind='recurring'] .chips { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .chip-opt span { display: flex; flex-direction: column; justify-content: center; min-height: 48px; padding: .55rem .75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); text-align: center; font-weight: 600; cursor: pointer; }
  .chip-opt small { display: block; font-weight: 450; font-size: .8rem; color: var(--ink-3); }
  .chip-opt input:checked + span { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
  .chip-opt input:checked + span small { color: var(--ink-2); }
  .custom { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .75rem; }
  .custom[hidden] { display: none; }
  .custom label, label.custom, .email { display: grid; gap: .3rem; font-size: .92rem; color: var(--ink-2); }
  input[type='number'], input[type='email'], select { font: 500 1rem var(--font-body); padding: .65rem .75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); min-width: 0; }
  input:disabled { background: var(--surface-2); color: var(--ink-3); }
  .summary { padding: .75rem .9rem; border-radius: var(--radius-sm); background: var(--surface-2); font-weight: 600; }
  .summary :global(small) { display: block; margin-top: .2rem; font-weight: 450; font-size: .9rem; color: var(--ink-2); }
  .authorise { display: flex; gap: .6rem; align-items: flex-start; font-size: .95rem; }
  .authorise[hidden] { display: none; }
  .authorise input { margin-top: .25rem; }
  .submit { justify-content: center; width: 100%; }
  .submit:disabled { opacity: .55; cursor: not-allowed; transform: none; box-shadow: none; }
  .center { text-align: center; margin: -.5rem 0 0; }
  .fine { font-size: .86rem; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: .75rem; }
  .fine p { margin: 0 0 .5rem; }
  [hidden] { display: none !important; }
</style>

<script>
  import { LIMITS, PAYMENTS_ENABLED, formatINR, yearly, type Frequency } from '../lib/support';

  const form = document.getElementById('support-form') as HTMLFormElement;
  const summary = document.getElementById('summary')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const authorise = form.querySelector('.authorise') as HTMLElement;
  const authoriseBox = form.querySelector('input[name=authorise]') as HTMLInputElement;
  const authoriseText = document.getElementById('authorise-text')!;
  const val = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value ?? '';

  /** The current choice, or null when it is incomplete or out of bounds. Nothing is chosen until the person chooses. */
  function choice(): { kind: 'once'; amount: number } | { kind: 'recurring'; amount: number; frequency: Frequency } | null {
    if (val('kind') === 'once') {
      const v = val('once-amount');
      const amount = v === 'custom' ? Math.floor(Number(val('once-custom'))) : Number(v);
      return amount >= LIMITS.oneTime.min && amount <= LIMITS.oneTime.max ? { kind: 'once', amount } : null;
    }
    const v = val('rec-amount');
    if (!v) return null;
    const [a, f] = v === 'custom' ? [Math.floor(Number(val('rec-custom'))), val('rec-frequency')] : v.split('/');
    const amount = Number(a), frequency = f as Frequency;
    return amount >= LIMITS.recurring.min && amount <= LIMITS.recurring.max ? { kind: 'recurring', amount, frequency } : null;
  }

  function render() {
    const kind = val('kind');
    form.querySelectorAll<HTMLElement>('.amounts').forEach((fs) => { fs.hidden = fs.dataset.kind !== kind; });
    form.querySelectorAll<HTMLElement>('.rec-only').forEach((el) => { el.hidden = kind !== 'recurring'; });
    form.querySelector<HTMLElement>('[data-kind="once"] .custom')!.hidden = val('once-amount') !== 'custom';
    form.querySelector<HTMLElement>('[data-kind="recurring"] .custom')!.hidden = val('rec-amount') !== 'custom';
    authorise.hidden = kind !== 'recurring';

    const c = choice();
    if (!c) {
      const custom = (kind === 'once' ? val('once-amount') : val('rec-amount')) === 'custom';
      const lim = kind === 'once' ? LIMITS.oneTime : LIMITS.recurring;
      summary.textContent = custom ? `Enter an amount between ${formatINR(lim.min)} and ${formatINR(lim.max)}.` : 'Choose an amount to see the total.';
      submit.textContent = 'Choose an amount';
      authoriseBox.checked = false;
      submit.disabled = true;
      return;
    }
    if (c.kind === 'once') {
      summary.textContent = `${formatINR(c.amount)}, once. Nothing more will be collected.`;
      submit.textContent = `Support with ${formatINR(c.amount)}`;
    } else {
      const every = c.frequency === 'week' ? 'every week' : 'every month';
      summary.replaceChildren(`${formatINR(c.amount)} ${every} ${yearly(c.amount, c.frequency).text}`,
        Object.assign(document.createElement('small'), { textContent: 'Collected automatically until you cancel. You are notified before each payment.' }));
      submit.textContent = `Set up ${formatINR(c.amount)} ${every}`;
      authoriseText.textContent = `I authorise ${formatINR(c.amount)} to be collected ${every} until I cancel.`;
    }
    // While payments are off, the button stays disabled whatever is chosen.
    submit.disabled = !PAYMENTS_ENABLED || (c.kind === 'recurring' && !authoriseBox.checked);
  }

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  form.addEventListener('submit', (e) => e.preventDefault()); // no payment flow exists yet
  render();
</script>
