---
// Support this project. A shared page (like /about/): linked from both modes' footers.
// One-time support by direct UPI only: QR code (built here, at build time), an app link on phones, and
// "Copy UPI ID". No gateway, no backend, no records. Settings: UPI_CONFIG in src/lib/support.ts.
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { LIMITS, ONE_TIME_PRESETS, UPI_CONFIG, formatINR, supportOpen, upiUri } from '../lib/support';
import { qrSvg } from '../lib/upi-qr';

const open = supportOpen();
const cfg = UPI_CONFIG;
// One QR per preset amount (when amounts go in the QR) plus one without an amount, for "Other amount".
const qrs = open
  ? [
      ...(cfg.amountInQr ? ONE_TIME_PRESETS.map((a) => ({ amount: String(a), svg: qrSvg(upiUri(a), `UPI QR code to pay ${formatINR(a)} to ${cfg.payeeName}`) })) : []),
      { amount: 'any', svg: qrSvg(upiUri(), `UPI QR code to pay ${cfg.payeeName}`) },
    ]
  : [];

const helps = [
  ['Hosting and storage', 'Keeping the site, the books and the trainer recordings online and fast.'],
  ['Media: preparation and licensing', 'Finding openly licensed recordings and images, checking their licences, cleaning and labelling them.'],
  ['Research and writing', 'Reading the evidence and turning it into guides, syntheses and books.'],
  ['Maintenance', 'Fixing errors, updating content as evidence changes, keeping everything secure.'],
  ['New educational tools', 'Building the next trainers and calculators.'],
];
---
<Base title="Support this project" description="Help keep this project free and support its continued development. Voluntary one-time contributions by UPI.">
  <header class="page-head wrap support-head">
    <span class="eyebrow">Support</span>
    <h1>Support this project</h1>
    <p>Help keep this project free and support its continued development.</p>
    <p class="muted">The core educational resources on this site are intended to remain freely accessible. Your support helps us keep building and maintaining the platform.</p>
  </header>

  <div class="wrap support-grid">
    <section class="support-why" aria-labelledby="why-h">
      <h2 id="why-h">What support helps with</h2>
      <ul class="helps">
        {helps.map(([title, text]) => <li><b>{title}.</b> {text}</li>)}
      </ul>
      <h2>Other ways to help</h2>
      <ul class="helps">
        <li><b>Share</b> a guide, book or trainer with someone who would use it.</li>
        <li><b>Report an error</b> or a broken link: <a href={`mailto:${SITE.email}?subject=Correction`}>{SITE.email}</a>.</li>
        <li><b>Suggest</b> a topic, tool or trainer you would find useful.</li>
      </ul>
    </section>

    <section class="card support-form-card" aria-labelledby="form-h">
      <h2 id="form-h">Make a contribution</h2>
      {!open && <p class="soon" role="status"><b>Contributions open soon.</b> You can look through the options below; the UPI details will appear here when contributions open.</p>}

      <div id="support-upi" class="support-form" data-open={String(open)} data-amount-in-qr={String(cfg.amountInQr)}
        data-upi-id={open ? cfg.upiId.trim() : undefined} data-payee={cfg.payeeName} data-note={cfg.note}>
        <fieldset class="amounts">
          <legend>Choose an amount</legend>
          <div class="chips">
            {ONE_TIME_PRESETS.map((a) => <label class="chip-opt"><input type="radio" name="amount" value={a} /> <span>{formatINR(a)}</span></label>)}
            <label class="chip-opt"><input type="radio" name="amount" value="custom" /> <span>Other amount</span></label>
          </div>
          <label class="custom" hidden>
            <span>Amount in ₹</span>
            <input type="number" inputmode="numeric" name="custom" min={LIMITS.min} max={LIMITS.max} step="1" placeholder="e.g. 300" />
          </label>
        </fieldset>

        <div class="summary" aria-live="polite" id="summary">Choose an amount, or pay any amount you like.</div>

        {open ? (
          <div class="pay">
            <p class="payee">Paying <b>{cfg.payeeName}</b><br /><span class="upi-id">UPI ID: <code id="upi-id">{cfg.upiId.trim()}</code></span></p>
            <div class="qr-box">
              {qrs.map((q) => <figure class="qr" data-qr={q.amount} hidden={q.amount !== 'any'} set:html={q.svg} />)}
            </div>
            <p class="qr-hint" id="qr-hint">Scan with any UPI app.</p>
            <div class="pay-actions">
              <a class="btn btn-primary" id="upi-open" href={upiUri()} hidden>Open your UPI app</a>
              <button class="btn btn-ghost" type="button" id="upi-copy">Copy UPI ID</button>
              <span class="copied" id="copied" role="status" aria-live="polite"></span>
            </div>
            <p class="small muted mobile-only" hidden id="app-hint">If your UPI app doesn't open or declines the payment, take a screenshot of the QR code and scan it from your gallery in the app, or copy the UPI ID.</p>
          </div>
        ) : (
          <div class="qr-box qr-placeholder" aria-hidden="true"><span>UPI QR code</span></div>
        )}

        <div class="fine">
          <p><b>How it works:</b> you pay directly by UPI from your own app. Your UPI app keeps the record of the payment; this site doesn't collect your details or keep any record.</p>
          <p>Contributions are voluntary support for the project: they do not buy access, features or medical advice, and they are not tax-deductible. No account is needed.</p>
          <p>If you think a payment went wrong (for example, paid twice by mistake), write to <a href={`mailto:${SITE.email}?subject=Payment%20query`}>{SITE.email}</a>.</p>
        </div>
      </div>
    </section>
  </div>
  <div class="wrap" style="padding-bottom:4rem"></div>
</Base>

<style>
  .support-head p:first-of-type { font-size: 1.2rem; color: var(--ink); }
  .support-grid > section { padding-block: 0; }
  .support-grid { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 900px) { .support-grid { grid-template-columns: 1fr; } .support-form-card { order: -1; } }
  .support-why h2 { font-size: 1.25rem; margin-top: 0; }
  .support-why h2 + .helps + h2 { margin-top: 2rem; }
  .helps { padding-left: 1.2rem; margin: 0; } .helps li { margin: .5rem 0; color: var(--ink-2); } .helps b { color: var(--ink); }
  .support-form-card { gap: 1rem; }
  .support-form-card h2 { font-size: 1.25rem; margin: 0; }
  .soon { margin: 0; padding: .7rem .9rem; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink-2); font-size: .95rem; }
  .support-form { display: grid; gap: 1rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 650; margin-bottom: .5rem; }
  .chip-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .chip-opt input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: .5rem; }
  .chip-opt span { display: flex; flex-direction: column; justify-content: center; min-height: 48px; padding: .55rem .75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); text-align: center; font-weight: 600; cursor: pointer; }
  .chip-opt input:checked + span { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
  .custom { display: grid; gap: .3rem; margin-top: .75rem; font-size: .92rem; color: var(--ink-2); max-width: 220px; }
  input[type='number'] { font: 500 1rem var(--font-body); padding: .65rem .75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); min-width: 0; }
  .summary { padding: .75rem .9rem; border-radius: var(--radius-sm); background: var(--surface-2); font-weight: 600; }
  .pay { display: grid; gap: .75rem; justify-items: center; text-align: center; }
  .payee { margin: 0; font-size: 1rem; }
  .payee b { font-size: 1.1rem; }
  .upi-id { font-size: .92rem; color: var(--ink-2); }
  .upi-id code { font: 600 .95rem var(--font-mono); color: var(--ink); overflow-wrap: anywhere; }
  /* QR codes stay dark-on-white in every theme: scanners need the contrast. */
  .qr-box { width: min(260px, 100%); aspect-ratio: 1; padding: 10px; border-radius: var(--radius-sm); background: #fff; border: 1px solid var(--line); justify-self: center; }
  .qr { margin: 0; width: 100%; height: 100%; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  .qr-placeholder { display: grid; place-items: center; background: var(--surface-2); color: var(--ink-3); font-size: .9rem; border-style: dashed; }
  .qr-hint { margin: 0; font-weight: 600; }
  .pay-actions { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; align-items: center; }
  .copied { font-size: .88rem; color: var(--ok); min-width: 4em; }
  .fine { font-size: .86rem; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: .75rem; }
  .fine p { margin: 0 0 .5rem; }
  [hidden] { display: none !important; }
</style>

<script>
  import { LIMITS, formatINR, upiUri } from '../lib/support';

  const root = document.getElementById('support-upi')!;
  const open = root.dataset.open === 'true';
  const amountInQr = root.dataset.amountInQr === 'true';
  const cfg = { upiId: root.dataset.upiId ?? '', payeeName: root.dataset.payee ?? '', note: root.dataset.note ?? '', amountInQr };
  const summary = document.getElementById('summary')!;
  const customBox = root.querySelector<HTMLElement>('.custom')!;
  const customInput = root.querySelector<HTMLInputElement>('input[name=custom]')!;
  const hint = document.getElementById('qr-hint');
  const openLink = document.getElementById('upi-open') as HTMLAnchorElement | null;
  const appHint = document.getElementById('app-hint');

  // "Open your UPI app" only where a UPI app can exist (phones and tablets). Best effort: some apps decline
  // payments started from a link, so the QR and the UPI ID stay right there.
  const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent));
  if (open && mobile) { openLink!.hidden = false; appHint!.hidden = false; }

  function chosen(): number | 'none' | 'invalid' {
    const v = (root.querySelector<HTMLInputElement>('input[name=amount]:checked'))?.value;
    if (!v) return 'none';
    if (v !== 'custom') return Number(v);
    const n = Math.floor(Number(customInput.value));
    return n >= LIMITS.min && n <= LIMITS.max ? n : 'invalid';
  }

  function render() {
    const custom = root.querySelector<HTMLInputElement>('input[name=amount]:checked')?.value === 'custom';
    customBox.hidden = !custom;
    const a = chosen();
    if (a === 'invalid') summary.textContent = `Enter an amount between ${formatINR(LIMITS.min)} and ${formatINR(LIMITS.max)}.`;
    else if (a === 'none') summary.textContent = 'Choose an amount, or pay any amount you like.';
    else summary.textContent = `${formatINR(a)}, once.`;
    if (!open) return;

    const amount = typeof a === 'number' ? a : undefined;
    // A QR with the amount exists only for preset amounts (built ahead of time); otherwise show the open QR.
    const qrKey = amount && amountInQr && root.querySelector(`[data-qr="${amount}"]`) ? String(amount) : 'any';
    root.querySelectorAll<HTMLElement>('[data-qr]').forEach((f) => { f.hidden = f.dataset.qr !== qrKey; });
    hint!.textContent = !amount ? 'Scan with any UPI app and enter the amount you choose.'
      : qrKey !== 'any' ? `Scan with any UPI app. ${formatINR(amount)} is filled in; check it before you pay.`
      : `Scan with any UPI app, then enter ${formatINR(amount)} in the app.`;
    openLink!.href = upiUri(amount, cfg);
  }

  document.getElementById('upi-copy')?.addEventListener('click', async () => {
    const status = document.getElementById('copied')!;
    try { await navigator.clipboard.writeText(cfg.upiId); status.textContent = 'Copied'; }
    catch {
      const sel = getSelection(); const r = document.createRange();
      r.selectNodeContents(document.getElementById('upi-id')!); sel?.removeAllRanges(); sel?.addRange(r);
      status.textContent = 'Selected: copy it now';
    }
    setTimeout(() => { status.textContent = ''; }, 3000);
  });
  root.addEventListener('input', render);
  root.addEventListener('change', render);
  render();
</script>
