---
// The list of books for one audience. /books/ and /doctors/books/ are thin wrappers around this.
import Base from '../../layouts/Base.astro';
import { books, bookUrl } from '../../lib/content';
import { MODES, section, type Mode } from '../../lib/modes';
import { useT } from '../../i18n/t';

// The words are translated on a translated page (/hi/books/); the books themselves are always in English.
interface Props { mode: Mode; title: string; description: string; intro: string }
const t = useT(Astro.url.pathname);
const { mode } = Astro.props;
const title = t(Astro.props.title), description = t(Astro.props.description), intro = t(Astro.props.intro);
// A book on a subject shelf (Public Health...) is shown by its shelf's card in the lead slot, not here.
const all = await books(mode);
const list = all.filter((b) => !b.data.shelf);
const other: Mode = mode === 'doctors' ? 'everyone' : 'doctors';
const otherCount = (await books(other)).length;
---
<Base title={title} description={description}>
  <header class="page-head wrap">
    <span class="eyebrow">{t('Books')}</span>
    <h1>{title}</h1>
    <p>{intro}</p>
  </header>
  <div class="wrap" style="padding-bottom:4rem">
    <slot name="lead" />
    {list.length ? (
      <div class="grid">
        {list.map((b, i) => (
          <a class="card reveal" href={bookUrl(b)} style={`--d:${(i % 3) * .08}s`}>
            {b.data.cover && <img src={b.data.cover} alt={t('Cover of {title}', { title: b.data.title })} loading="lazy" style="border-radius:var(--radius-sm);aspect-ratio:1/1.414;object-fit:cover;margin-bottom:.5rem" />}
            {b.data.draft && <span class="chip draft">{t('Draft')}</span>}
            <h3 lang="en">{b.data.title}</h3><p lang="en">{b.data.description}</p><span class="more">{t('Details & PDF')} →</span>
          </a>
        ))}
      </div>
    ) : !all.length && <p class="empty">{t('The first books for this section are being prepared.')}</p>}
    {otherCount > 0 && <p class="muted" style="margin-top:2rem">{other === 'doctors' ? t('Looking for books for doctors and medical students?') : t('Looking for books for everyone?')} {t('See')} <a href={section(other, 'books')}>{t(MODES[other].label)} · {t('Books')}</a>.</p>}
  </div>
</Base>
