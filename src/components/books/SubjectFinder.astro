---
// "Find a subject": a searchable dropdown beside "The path" on the Obesity Expertise page. The first choice is All
// (the shelf as it is); then every subject in the order the series plans them. Choosing one shows all of that
// subject's books in its place (the panels in index.astro); src/reader/finder.ts does the filtering and showing.
// A plain <select> cannot be searched, so this is an accessible combobox: an input and a list of options.
export interface FinderSubject { key: string; n: number; name: string; total: number; out: number }
interface Props { subjects: FinderSubject[] }
const { subjects } = Astro.props;
const state = (s: FinderSubject) => (s.out === 0 ? 'Coming' : `${s.out} of ${s.total} out`);
---
<div class="finder">
  <label class="finder-label" for="finder-input">Subject</label>
  <div class="finder-box">
    <input id="finder-input" type="text" role="combobox" aria-expanded="false" aria-controls="finder-list" aria-autocomplete="list"
      autocomplete="off" autocapitalize="off" spellcheck="false" value="All" placeholder="Find a subject" />
    <svg class="finder-caret" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <ul id="finder-list" role="listbox" aria-label="Subjects, in the order the series builds them" hidden>
      <li role="option" id="fo-all" data-key="" aria-selected="true"><span class="o-t">All</span></li>
      {subjects.map((s) => (
        <li role="option" id={`fo-${s.key}`} data-key={s.key} aria-selected="false" data-out={s.out > 0 ? '1' : '0'}
          data-n={String(s.n)} data-search={s.name.toLowerCase()} data-label={`${s.n} · ${s.name}`}>
          <span class="o-n">{s.n}</span><span class="o-t">{s.name}</span><span class="o-s">{state(s)}</span>
        </li>
      ))}
      <li class="finder-empty" role="presentation" hidden>No subject matches.</li>
    </ul>
  </div>
  <p class="sr-only" role="status" id="finder-status"></p>
</div>

<style>
  .finder { position: relative; flex: 1 1 260px; max-width: 360px; }
  .finder-label { display: block; margin: 0 0 .2rem; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
  .finder-box { position: relative; }
  .finder input {
    width: 100%; min-height: 42px; padding: .45rem 2.2rem .45rem .8rem; border: 1px solid var(--line); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--ink); font: 600 16px var(--font-body); text-overflow: ellipsis;
  }
  .finder input::placeholder { color: var(--ink-3); font-weight: 500; }
  .finder input:focus-visible { outline: 3px solid var(--brand); outline-offset: 1px; }
  .finder-caret { position: absolute; right: .75rem; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }
  .finder ul {
    position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% + 4px); max-height: min(340px, 52vh); overflow-y: auto; margin: 0; padding: .3rem;
    list-style: none; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); box-shadow: 0 14px 36px rgb(0 0 0 / .22);
    overscroll-behavior: contain;
  }
  .finder ul[hidden] { display: none; }
  .finder li[role='option'] {
    display: grid; grid-template-columns: 1.8rem 1fr auto; gap: .5rem; align-items: baseline; padding: .5rem .55rem; border-radius: 6px;
    font-size: .9rem; color: var(--ink-3); cursor: pointer;
  }
  .finder li[hidden] { display: none; }
  .finder li#fo-all { grid-template-columns: 1fr; font-weight: 700; color: var(--ink); }
  .finder li[data-out='1'] { color: var(--ink); }
  .finder li[data-out='1'] .o-t { font-weight: 600; }
  .finder li.active { background: var(--surface-2); }
  .finder li[aria-selected='true'] { box-shadow: inset 3px 0 0 var(--brand); }
  .o-n { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .o-s { font-size: .76rem; white-space: nowrap; color: var(--ink-3); }
  .finder-empty { padding: .6rem .55rem; font-size: .88rem; color: var(--ink-3); }
  .finder-empty[hidden] { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>
