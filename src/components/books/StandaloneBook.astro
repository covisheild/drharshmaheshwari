---
// A standalone book (not in a series) in the reader: the one page every such book opens on, so they all look
// and work like the Obesity Expertise books. Takes the book's Markdown entry (cover, PDF, who it is for, datasets)
// and its exported text (lib/reader-books.ts); the entry's body appears under "Why this book" at the top.
import { render, type CollectionEntry } from 'astro:content';
import BookReader from './BookReader.astro';
import { readerFigureBase } from '../../lib/reader-books';
import { section } from '../../lib/modes';
import { SITE } from '../../consts';
import type { Book } from '../../reader/types';

interface Props { entry: CollectionEntry<'books'>; book: Book }
const { entry, book } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasMore = !!entry.body?.trim();
const home = section(d.mode, 'books');
const date = new Date(book.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${SITE.url}${book.url}`;
const short = book.title.split(':')[0];
const jsonld = [{
  '@type': 'Book', '@id': `${url}#book`, name: book.title, alternativeHeadline: book.subtitle, description: d.description, url,
  author: { '@id': `${SITE.url}/#person` }, dateModified: book.date, version: book.version, inLanguage: 'en-IN',
  isAccessibleForFree: true, license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
  audience: { '@type': 'Audience', audienceType: d.audience }, bookFormat: 'https://schema.org/EBook',
  encoding: { '@type': 'MediaObject', contentUrl: book.pdf, encodingFormat: 'application/pdf' },
}];
const end = `<p>End of the book. <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">${book.licence}</a></p>
        <p><a href="${home}">All books for doctors</a> · <a href="${book.pdf}" download>Download the PDF</a>${d.datasets ? ` · <a href="${d.datasets}">Datasets for the R examples</a>` : ''} · <a href="/disclaimer/">Disclaimer</a> · <a href="/support/">Support</a></p>`;
---
<BookReader book={book} title={book.title} description={d.description} jsonld={jsonld} figures={readerFigureBase(book)} date={date}
  eyebrow={`<a href="${home}">Free book</a>`} heading={book.title}
  barFull={book.title} barShort={short} backHref={home} backLabel="All books for doctors" end={end}>
  {d.cover && <img slot="cover" class="rd-cover-img" src={d.cover} alt="" width="180" height="255" />}
  {d.datasets && <p slot="links" class="rd-extra"><a href={d.datasets}>Datasets for the R examples</a> · free to download</p>}
  {hasMore && <div slot="about"><Content /></div>}
</BookReader>
