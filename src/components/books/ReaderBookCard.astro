---
// A standalone book that opens in the reader, shown on /doctors/books/ as a wide card in the same layout as the
// Obesity Expertise series card (cover on the left, "Read online" as the call to action).
import type { CollectionEntry } from 'astro:content';
import { bookUrl } from '../../lib/content';

interface Props { entry: CollectionEntry<'books'> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="rbook-card reveal" href={bookUrl(entry)}>
  {d.cover && <img src={d.cover} alt="" width="120" height="170" loading="lazy" />}
  <div class="rb-text">
    <span class="eyebrow">Free book</span>
    <h2>{d.title}</h2>
    <p>{d.description}</p>
    <p class="rb-go"><b>Read online</b> · free PDF too →</p>
  </div>
</a>

<style>
  .rbook-card { display: grid; grid-template-columns: auto 1fr; gap: 1.75rem; align-items: center; margin-bottom: 1.5rem; padding: 1.25rem 1.5rem;
    border: var(--card-border); border-radius: var(--radius); background: var(--surface); color: var(--ink); text-decoration: none; }
  .rbook-card:hover { border-color: var(--brand); }
  .rbook-card img { width: 120px; height: auto; aspect-ratio: 1 / 1.414; object-fit: cover; border-radius: 3px 6px 6px 3px; box-shadow: -2px 0 6px rgb(0 0 0 / .25); }
  .rbook-card h2 { margin: .2rem 0 .4rem; font-size: 1.4rem; }
  .rbook-card p { margin: 0 0 .4rem; color: var(--ink-2); }
  .rb-go { color: var(--brand) !important; }
  @media (max-width: 640px) { .rbook-card { grid-template-columns: 1fr; gap: 1rem; } .rbook-card img { width: 96px; } }
</style>
