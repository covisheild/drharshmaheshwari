---
// The whole Obesity Expertise series as one wide card on /doctors/books/, so 196 planned books take the
// space of one. Shows how many are out and where to start.
import CollectionCard from './CollectionCard.astro';
import { obesityBooks, series, SERIES_URL } from '../../lib/obesity-books';
const out = obesityBooks.length;
---
{out > 0 && (
  <CollectionCard href={SERIES_URL} title={series.title}
    text={`${series.subtitle}. Read online, with practice problems you can check as you go, or download each book as a PDF.`}
    status={`${out} of ${series.books.length} out`} cta="Start with Book 0 →"
    covers={obesityBooks.slice(0, 6).map((b) => ({ hue: b.hue, label: String(b.number) }))} />
)}
