---
// The floating glass header: photo and name, this audience's pages, the For Everyone / For Doctors switch, light/dark, menu.
import { SITE } from '../../consts';
import { MODES, type Mode } from '../../lib/modes';
import Avatar from '../Avatar.astro';
import ThemeToggle from '../ThemeToggle.astro';
import ModeSwitch from './ModeSwitch.astro';
import { parentOf } from '../../lib/back';

interface Props { mode: Mode; path: string }
const { mode, path } = Astro.props;
const m = MODES[mode];
const back = parentOf(path);
const current = (href: string) => (href === m.home ? path === href : path.startsWith(href));
---
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="brand" href={m.home} aria-label={SITE.name}>
      <Avatar size={38} decorative eager />
      <span class="brand-name">{SITE.name}{mode === 'doctors' && <span class="mode-badge">{m.label}</span>}</span>
    </a>
    <ul class="nav-links" id="nav-links">
      {m.nav.map((n) => <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <ModeSwitch mode={mode} />
    <ThemeToggle />
    <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav-links"><span></span></button>
  </nav>
</header>
{back && (
  <a class="back-btn" href={back} data-back aria-label="Go back">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
  </a>
)}
