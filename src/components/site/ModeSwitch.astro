---
// The For Everyone / For Doctors switch. Each side links to that audience's home; the current one is marked.
// On phones the "For " is hidden (see global.css) so the switch fits; the link text stays "For Everyone" / "For Doctors".
// On a translated page the labels are translated and For Everyone goes to that language's home; For Doctors is English only.
import { MODES, type Mode } from '../../lib/modes';
import { LANG, langOf } from '../../i18n/languages';
import { localHref } from '../../i18n/routes';
import { lookup, translate } from '../../i18n/t';
interface Props { mode: Mode }
const { mode } = Astro.props;
const lang = langOf(Astro.url.pathname);
const { text, at } = LANG[lang].modeAffix;
// [hidden before, shown, hidden after]
const split = (label: string): [string, string, string] => {
  if (at === 'start') return label.startsWith(text) ? [text, label.slice(text.length), ''] : ['', label, ''];
  const i = label.lastIndexOf(text.trim());
  return i > 0 ? ['', label.slice(0, i), label.slice(i)] : ['', label, ''];
};
---
<nav class="mode-switch" aria-label={translate(lang, 'Choose who this site is for')}>
  {Object.values(MODES).map((m) => {
    const [pre, rest, post] = split(translate(lang, m.label));
    // A language whose labels are long on a phone gives its own short form: dictionary keys "Everyone" / "Doctors"
    // (the words English shows on phones). The link's accessible name stays the full label.
    const short = lang !== 'en' ? lookup(lang, m.label.replace(/^For /, '')) : undefined;
    return <a href={localHref(lang, m.home)} aria-current={m.id === mode ? 'true' : undefined} data-mode-link={m.id} aria-label={short ? translate(lang, m.label) : undefined}>{short ? <><span class="full">{pre}{rest}{post}</span><span class="short" aria-hidden="true">{short}</span></> : <>{pre && <span class="pre">{pre}</span>}{rest}{post && <span class="pre">{post}</span>}</>}</a>;
  })}
</nav>
