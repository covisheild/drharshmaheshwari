---
import { SITE } from '../../consts';
import { MODES, SHARED_LINKS, type Mode } from '../../lib/modes';
import Avatar from '../Avatar.astro';
import ModeSwitch from './ModeSwitch.astro';
import { LANG, langOf } from '../../i18n/languages';
import { localHref } from '../../i18n/routes';
import { useT } from '../../i18n/t';

interface Props { mode: Mode }
const { mode } = Astro.props;
const m = MODES[mode];
const lang = langOf(Astro.url.pathname);
const t = useT(Astro.url.pathname);
const local = (links: { href: string; label: string }[]) => links.map((l) => ({ href: localHref(lang, l.href), label: t(l.label) }));
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href={localHref(lang, m.home)}><Avatar size={48} decorative /><span>{t(SITE.name)}</span></a>
        <p class="muted small" style="margin-top:1rem;max-width:36ch">{t(SITE.tagline)}{LANG[lang].stop}</p>
        <ModeSwitch mode={mode} />
      </div>
      {m.footer.map((col) => <div><h4>{t(col.title)}</h4><ul>{local(col.links).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>)}
      <div><h4>{t('Site')}</h4><ul>{local(SHARED_LINKS).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {t(SITE.name)}{lang === 'en' ? '.' : ' ·'} {t('Educational content, not personal medical advice.')}</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</footer>
