---
import { fmtDate } from '../lib/content';
interface Props { href: string; title: string; description: string; date: Date; topic?: string; draft?: boolean; delay?: number; }
const { href, title, description, date, topic, draft, delay = 0 } = Astro.props;
---
<a class="card reveal" href={href} style={`--d:${delay}s`}>
  <div style="display:flex;gap:.4rem;flex-wrap:wrap">
    {topic && <span class="chip">{topic}</span>}
    {draft && <span class="chip draft">Draft</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="more">Read · <time datetime={date.toISOString()}>{fmtDate(date)}</time></span>
</a>
