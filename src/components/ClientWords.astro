---
// The words a page's script shows, in the page's language (src/i18n/client.ts). Every w('...') call in the listed source
// files is looked up in the dictionary; a missing one is sent marked (src/i18n/t.ts), so `npm run i18n:missing` and the
// tests find it. From the calculation libraries (src/lib/*.ts), whose verdicts the page passes through w() when it shows them,
// every quoted string that has a translation is sent too. Nothing on English pages.
import { langOf } from '../i18n/languages';
import { DICTS, translate } from '../i18n/t';

interface Props { sources: string[] }
const lang = langOf(Astro.url.pathname);
const RAW = import.meta.glob(['/src/pages/**/*.astro', '/src/lib/*.ts', '/src/scripts/*.ts', '/src/trackers/*.ts', '/src/components/**/*.astro', '/src/pwa/*.ts'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const unq = (s: string) => s.replace(/\\(['"`\\])/g, '$1');
const keys = new Set<string>();
// Every page with a unit field needs its words too (src/scripts/unit-fields.ts relabels the field when the unit is switched).
for (const src of [...Astro.props.sources, '/src/lib/units.ts', '/src/scripts/unit-fields.ts']) {
  const raw = RAW[src];
  if (raw === undefined) throw new Error(`ClientWords: no source ${src}`);
  for (const m of raw.matchAll(/\bw\(\s*(?:'((?:\\.|[^'\\])*)'|"((?:\\.|[^"\\])*)"|`((?:\\.|[^`\\$])*)`)/g)) keys.add(unq(m[1] ?? m[2] ?? m[3]));
  if (src.startsWith('/src/lib/') && lang !== 'en') {
    for (const k of Object.keys(DICTS[lang] ?? {})) if (raw.includes(`'${k}'`) || raw.includes(`"${k}"`)) keys.add(k);
  }
}
const words = lang === 'en' ? null : JSON.stringify(Object.fromEntries([...keys].map((k) => [k, translate(lang, k)]))).replace(/</g, '\\u003c');
---
{words && <script is:inline type="application/json" id="i18n-words" set:html={words} />}
