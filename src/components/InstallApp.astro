---
// "Install the app" (home pages and /app/). One tap where the browser can install apps by itself (Chrome, Edge, Samsung
// Internet, Opera: the browser's own offer, held back in src/pwa/client.ts, opens on the tap). Where it cannot, the same tap
// shows the two or three steps for this browser: iPhone and iPad (Apple allows only Share > Add to Home Screen), Safari on a
// Mac (File > Add to Dock), Firefox on Android (menu > Install), Firefox on a computer (cannot install apps: use Chrome or
// Edge, or keep the site as a bookmark). Hidden inside the app itself. Never a pop-up or banner.
import '../styles/install.css';
import T from './T.astro';
import { useT } from '../i18n/t';
import { localHref } from '../i18n/routes';
import { langOf } from '../i18n/languages';

interface Props {
  /** 'card': a section of its own (home pages); 'plain': inside a page that already explains the app (/app/). */
  look?: 'card' | 'plain';
}
const { look = 'card' } = Astro.props;
const path = Astro.url.pathname;
const t = useT(path);
const L = (href: string) => localHref(langOf(path), href);
const share = '<svg class="inst-share" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M6 11H5v10h14V11h-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<div class:list={['inst', `inst-${look}`]} data-install>
  {look === 'card' && <img class="inst-icon" src="/icons/icon-192.png" alt="" width="72" height="72" loading="lazy" />}
  <div class="inst-body">
    {look === 'card' && <><h2>{t('Get the DrHM app')}</h2>
    <p class="inst-lead">{t('Opens in one tap from your home screen, works without internet, and updates itself.')}</p></>}
    <div class="inst-row">
      <button type="button" class="btn btn-primary btn-lg inst-btn">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
        <span>{t('Install the app')}</span>
      </button>
      {look === 'card' && <a class="inst-more" href={L('/app/')}>{t('How it works')}</a>}
    </div>
    <div class="inst-steps" data-for="ios" hidden>
      <p><b>{t('On iPhone and iPad')}</b> <T>(Apple allows apps from websites only this way):</T></p>
      <ol>
        <li><Fragment set:html={t('Tap the Share button {icon} (in Safari at the bottom, in Chrome at the top right).', { icon: share })} /></li>
        <li><T>Scroll down and tap <b>Add to Home Screen</b>, then <b>Add</b>.</T></li>
      </ol>
    </div>
    <div class="inst-steps" data-for="mac-safari" hidden>
      <p><T>In Safari, open the <b>File</b> menu and choose <b>Add to Dock</b>.</T></p>
    </div>
    <div class="inst-steps" data-for="android-firefox" hidden>
      <p><T>Tap the menu <b>⋮</b>, then <b>Install</b> (or <b>Add to Home screen</b>).</T></p>
    </div>
    <div class="inst-steps" data-for="desktop-firefox" hidden>
      <p><T>Firefox on a computer cannot install apps. Open this site in Chrome or Edge to install it, or bookmark it: it works the same.</T></p>
    </div>
    <div class="inst-steps" data-for="other" hidden>
      <p><T>Open your browser's menu (<b>⋮</b> or <b>…</b>) and choose <b>Install app</b> or <b>Add to Home screen</b>. If you do not see it, the app may already be installed: look for DrHM with your apps.</T></p>
    </div>
  </div>
</div>

<script>
  import { standalone } from '../pwa/settings';

  const ua = navigator.userAgent;
  const ios = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const firefox = /Firefox\//.test(ua);
  const android = /Android/.test(ua);
  const macSafari = !ios && /Macintosh/.test(ua) && /Safari\//.test(ua) && !/Chrome\/|Chromium\/|Edg\//.test(ua);
  const which = ios ? 'ios' : firefox ? (android ? 'android-firefox' : 'desktop-firefox') : macSafari ? 'mac-safari' : 'other';

  for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
    // Inside the app there is nothing to install.
    if (standalone()) { box.hidden = true; box.closest<HTMLElement>('[data-install-section]')?.setAttribute('hidden', ''); continue; }
    const btn = box.querySelector<HTMLButtonElement>('.inst-btn')!;
    btn.addEventListener('click', async () => {
      const p = window.drhmInstall;
      if (p) {
        await p.prompt();
        const choice = await p.userChoice.catch(() => null);
        window.drhmInstall = null;
        if (choice?.outcome === 'accepted') return;
      }
      box.querySelectorAll<HTMLElement>('.inst-steps').forEach((s) => { s.hidden = s.dataset.for !== which; });
    });
  }
  addEventListener('drhm:installed', () => document.querySelectorAll<HTMLElement>('[data-install]').forEach((b) => { b.hidden = true; }));
</script>
